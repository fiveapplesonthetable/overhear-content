    "안녕하세요": {
      "etymology": "Built from Sino-Korean 안녕 (安寧, 'peace and well-being'), the adjective-forming verb 하다, and the polite honorific ending -세요 (contracted from -시어요). Literally asks or wishes 'Are you at peace?'.",
      "notes": "Used across South Korea at any hour of the day as the standard polite greeting.",
      "certainty": "established",
      "morphemes": [
        {
          "part": "안녕 (安寧)",
          "kind": "Sino-Korean root",
          "meaning": "peace, tranquillity, well-being"
        },
        {
          "part": "-하-",
          "kind": "verbalizer",
          "meaning": "be / do"
        },
        {
          "part": "-세요",
          "kind": "polite honorific ending",
          "meaning": "respectful statement or question"
        }
      ],
      "rootFamily": [
        {
          "word": "안녕",
          "gloss": "hi / bye (casual); peace"
        },
        {
          "word": "안녕히",
          "gloss": "peacefully, safely"
        }
      ],
      "sources": [
        {
          "title": "Wiktionary — 안녕하다 (Korean)",
          "url": "https://en.wiktionary.org/wiki/%EC%95%88%EB%85%95%ED%95%98%EB%8B%A4#Korean"
        }
      ]
    },
