      "certainty": "established",
      "morphemes": [
        {
          "part": "本",
          "kind": "root",
          "meaning": "origin; true; real"
        },
        {
          "part": "当",
          "kind": "root",
          "meaning": "right; proper; fitting"
        }
      ],
      "history": [
        {
          "stage": "Japanese, cited 1770 attestation",
          "form": "本当",
          "meaning": "truth; what is real"
        },
        {
          "stage": "Japanese, cited 1785 attestation",
          "form": "本当",
          "meaning": "a genuine or proper state"
        }
