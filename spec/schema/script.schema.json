{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overhear.invalid/schema/script.v1.json",
  "title": "scene-NN.json (scene script)",
  "description": "out/<show>/sNNeNN/scene-NN.json. See spec/script-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "pair",
    "show",
    "season",
    "episode",
    "scene",
    "title",
    "level",
    "labels",
    "segments",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version of this file format. Bump only when the schema changes incompatibly."
    },
    "id": {
      "type": "string",
      "pattern": "^(kukhnya|domashniy-arest|dix-pour-cent|paquita-salas|die-discounter|boris|the-producers|the-naked-director|behind-the-scenes|al-maktab)-s\\d\\de\\d\\d-scene-\\d\\d$",
      "description": "<show>-sNNeNN-scene-NN; never changes once published."
    },
    "pair": {
      "enum": [
        "ru-en",
        "fr-en",
        "es-en",
        "de-en",
        "it-en",
        "ko-en",
        "ja-en",
        "zh-en",
        "ar-en"
      ]
    },
    "show": {
      "enum": [
        "kukhnya",
        "domashniy-arest",
        "dix-pour-cent",
        "paquita-salas",
        "die-discounter",
        "boris",
        "the-producers",
        "the-naked-director",
        "behind-the-scenes",
        "al-maktab"
      ]
    },
    "season": {
      "type": "integer",
      "minimum": 1
    },
    "episode": {
      "type": "integer",
      "minimum": 1
    },
    "scene": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "pattern": "^\\S(?:(?:\\S| (?! ))*\\S)?  \\(\\S(?:(?:\\S| (?! ))*\\S)?\\)$",
      "description": "<target title>  (<English title>): exactly two spaces before the bracket, no other double spaces, no leading/trailing space."
    },
    "level": {
      "enum": [
        "A1 — Duolingo Section 2",
        "A1 — débutant",
        "A1 — beginner"
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "role key -> the character's Russian/French display name; must equal the `ru` value of that key in out/<show>/cast.json. Voices are NOT stored in scripts: the renderer casts voices from cast.json by gender."
    },
    "segments": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "v",
          "t",
          "gap"
        ],
        "properties": {
          "v": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "`narrator`, or a role key that exists in out/<show>/cast.json (the character's own name, e.g. max, barinov; never a viewpoint slot like anya/lea)."
          },
          "t": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "sourceAudio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "start",
              "end"
            ],
            "description": "Native original speech only. Relative identifier under external private OVERHEAR_SOURCE_AUDIO_ROOT; never commit media or absolute paths. Public transcript omits this object.",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^sources/[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.(mp4|mkv|webm|m4a|wav|flac|mp3|ogg)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show",
        "file",
        "lines"
      ],
      "properties": {
        "show": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^sources/[a-z-]+/s\\d\\d/e\\d\\d\\.(ru|fr|es|de|it|ko|ja|zh|ar)(\\.dual)?\\.srt$"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "cue",
              "fragment"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "cue": {
                "type": "integer",
                "minimum": 1
              },
              "fragment": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
