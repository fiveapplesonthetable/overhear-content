{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overhear.invalid/schema/script.v1.json",
  "title": "scene-NN.json (scene script)",
  "description": "out/<show>/sNNeNN/scene-NN.json. See spec/script-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "pair",
    "show",
    "season",
    "episode",
    "scene",
    "title",
    "level",
    "labels",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version of this file format. Bump only when the schema changes incompatibly."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]-s\\d\\de\\d\\d-scene-\\d\\d$",
      "description": "<show>-sNNeNN-scene-NN; never changes once published."
    },
    "pair": {
      "enum": [
        "ru-en",
        "fr-en",
        "es-en",
        "de-en",
        "it-en",
        "ko-en",
        "ja-en",
        "zh-en",
        "ar-en",
        "pt-en",
        "hi-en",
        "en-es",
        "en-pt",
        "en-fr",
        "en-de",
        "en-it",
        "en-ru",
        "en-ar",
        "en-ja",
        "en-ko",
        "en-zh",
        "en-hi"
      ]
    },
    "show": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "description": "The show's folder name under out/; out/<show>/show.json must exist."
    },
    "season": {
      "type": "integer",
      "minimum": 1
    },
    "episode": {
      "type": "integer",
      "minimum": 1
    },
    "scene": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "pattern": "^\\S(?:(?:\\S| (?! ))*\\S)?  \\(\\S(?:(?:\\S| (?! ))*\\S)?\\)$",
      "description": "<target title>  (<English title>): exactly two spaces before the bracket, no other double spaces, no leading/trailing space."
    },
    "level": {
      "type": "string",
      "pattern": "^A[12] — \\S.*$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "role key -> the character's Russian/French display name; must equal the `ru` value of that key in out/<show>/cast.json. Voices are NOT stored in scripts: the renderer casts voices from cast.json by gender."
    },
    "segments": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "v",
          "t",
          "gap"
        ],
        "properties": {
          "v": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "`narrator`, or a role key that exists in out/<show>/cast.json (the character's own name, e.g. max, barinov; never a viewpoint slot like anya/lea)."
          },
          "t": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show",
        "file",
        "lines"
      ],
      "properties": {
        "show": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^sources/[a-z-]+/s\\d\\d/e\\d\\d\\.(ru|fr|es|de|it|ko|ja|zh|ar|pt)(\\.dual)?\\.srt$"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "cue",
              "fragment"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "cue": {
                "type": "integer",
                "minimum": 1
              },
              "fragment": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
