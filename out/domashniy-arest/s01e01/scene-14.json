    {
      "v": "captain",
      "t": "За взятку. За очень большую взятку.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So the mayor's busy day ends with his arrest. You don't need every word; if you remember the shout of 'freeze' and the line about having nobody to fear, you've got the heart of it. See you next time!",
      "gap": 0.5
    },
    {
      "v": "captain",
      "t": "Пока!",
      "gap": 0.3
    }
