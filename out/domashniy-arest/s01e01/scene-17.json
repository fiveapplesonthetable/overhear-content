    {
      "v": "samson",
      "t": "Так что будешь нам служить.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "The peace lasted exactly one handshake, and now the former mayor has a bandaged finger and a new job as the family's servant. Look after your own fingers, and that's it. See you next time!",
      "gap": 0.5
    },
    {
      "v": "samson",
      "t": "Пока!",
      "gap": 0.3
    }
  ],
