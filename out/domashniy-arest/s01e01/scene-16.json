    {
      "v": "klavdia",
      "t": "Ну, Аркашка, с возвращением.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So the mayor is back in the flat he grew up in, with a box on a stool and a tag on his ankle. Next he meets an old acquaintance from his childhood, so see you then. See you next time!",
      "gap": 0.5
    },
    {
      "v": "officer",
      "t": "Счастливо!",
      "gap": 0.3
    }
