  },
  {
   "v": "lydia",
   "t": "Хорошо, Аркадий Борисович.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Of course, Arkady Borisovich.' which translates to 'good' or 'all right', ",
