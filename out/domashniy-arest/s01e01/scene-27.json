      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "To close the first episode, Nina complains on the phone that all the boys chased her at school and somehow she drew this lucky ticket, and a song asks how much money it takes to be happy. See you next time!",
      "gap": 0.5
    },
    {
      "v": "samson",
      "t": "До встречи!",
      "gap": 0.3
