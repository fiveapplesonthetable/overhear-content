    {
      "v": "pasha",
      "t": "Потом надо отдать москвичам твои деньги из подвала.",
      "gap": 0.5
    },
    {
      "v": "pasha",
      "t": "Ну и кластер, конечно. Пока!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "In a few minutes Arkady has lost his freedom, his wife and his money. Listen out for that short, cheerful goodbye when you watch, and that's it. See you next time!",
      "gap": 0.5
    },
    {
      "v": "vika",
      "t": "Пока!",
      "gap": 0.3
    }
