    {
      "v": "samson",
      "t": "Теперь я начальник нашей стройки. Ты уволен!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Samson has just quit his job on the spot, trusting the boy he once bullied. Listen for 'I'm very glad to see you' when you watch. See you next time!",
      "gap": 0.5
    },
    {
      "v": "samson",
      "t": "Всё, до свидания!",
      "gap": 0.3
    }
