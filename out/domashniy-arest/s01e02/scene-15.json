    {
      "v": "arkady",
      "t": "На этот раз по-честному. В крокодиловом чехле!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Ну, как знаешь. Продам его Клавдии Викторовне.",
      "gap": 0.5
    },
    {
      "v": "slavik",
      "t": "Постойте!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So Slavik ends up with the shiny new iPhone, and Arkady finally has a phone he can call from. You did well to keep up with that one. See you next time!",
      "gap": 0.5
    },
    {
      "v": "slavik",
      "t": "Пока!",
      "gap": 0.3
    }
