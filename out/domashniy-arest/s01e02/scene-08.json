    {
      "v": "samson",
      "t": "Нина, имей совесть! Я вчера ради вас всё сделал.",
      "gap": 0.5
    },
    {
      "v": "nina",
      "t": "Всё, теперь ты герой? И можно только пить?",
      "gap": 0.5
    },
    {
      "v": "samson",
      "t": "Я стану мэром, понятно?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So Samson wants to be mayor, and Nina thinks he's dreaming. Listen out for 'rise and shine' and for his big promise at the end. See you next time!",
      "gap": 0.5
    },
    {
      "v": "nina",
      "t": "Пока!",
      "gap": 0.3
    }
