      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So the children leave the room, and Arkady is alone with an old phone and the governor's number. Whether the call goes well is another story. See you next time!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Пока!",
      "gap": 0.3
