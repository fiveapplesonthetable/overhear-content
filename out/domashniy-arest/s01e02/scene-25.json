    {
      "v": "lavrov",
      "t": "Возьмите, пожалуйста. На случай, если передумаете.",
      "gap": 0.5
    },
    {
      "v": "marina",
      "t": "Я не передумаю.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "That's the end of this one: listen out for her promise not to change her mind, and keep it in mind, because the card is still on her table. See you next time!",
      "gap": 0.5
    },
    {
      "v": "marina",
      "t": "До свидания.",
      "gap": 0.3
    }
  ],
