    {
      "v": "governor",
      "t": "Клоун.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "And that's the scene: the trick is out, the governor wants the money, and Arkady goes back to house arrest with nothing but his pride. Until next time!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Всего хорошего!",
      "gap": 0.3
    }
