    {
      "v": "arkady",
      "t": "Скажи: салют попал в станцию. Три района без света.",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "И позвони Цыганкову, пусть отключат свет.",
      "gap": 0.5
    },
    {
      "v": "pasha",
      "t": "Виталий Алексеевич, с Новым годом! Отключи, пожалуйста, три района.",
      "gap": 0.5
    },
    {
      "v": "pasha",
      "t": "Ну, потянуло кота на сметану.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Forty million on the table, a bonus for the deputy, and three districts in the dark so the boss can slip out. If you remember the joke about counting to forty, you've got the heart of it; goodbye for now. See you next time!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Пока!",
      "gap": 0.3
    }
  ],
