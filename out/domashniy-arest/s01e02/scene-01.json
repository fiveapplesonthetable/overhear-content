    {
      "v": "arkady",
      "t": "Успеем! Президент долго выступает.",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Это семейный праздник. Как в детстве, с подарками!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Паша, давай, не отставай!",
      "gap": 0.5
    },
    {
      "v": "pasha",
      "t": "Иду, Аркаша, иду!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So Vika is left alone with the champagne while her husband and his deputy disappear into the house. Next we find out where they went. See you next time!",
      "gap": 0.5
    },
    {
      "v": "arkady",
      "t": "Пока!",
      "gap": 0.3
    }
