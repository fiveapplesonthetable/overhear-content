    {
      "v": "general",
      "t": "А почему он на секретном совещании?",
      "gap": 0.5
    },
    {
      "v": "chief",
      "t": "А на секретном совещании он мой племянник.",
      "gap": 0.5
    },
    {
      "v": "general",
      "t": "Так, операцию продолжаем. Михаил Михайлович, помогайте Лаврову.",
      "gap": 0.5
    },
    {
      "v": "chief",
      "t": "Есть!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "So the arrest was only half the plan: Moscow is after a billion roubles, and Pasha's cluster is the bait. That was a tricky one, and you followed it. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chief",
      "t": "Пока!",
      "gap": 0.3
    }
  ],
