    },
    {
      "v": "arkady",
      "t": "А что такое? Иди отсюда!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'And what's the matter? Go away from here!'",
      "gap": 0.45
    },
    {
