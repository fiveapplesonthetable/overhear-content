    {
      "v": "narrator",
      "t": "'I want to finish what I started.'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Чтобы мне ещё десять лет дали?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'So they give me another ten years?'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Уходи отсюда!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Get out of here!'",
      "gap": 0.45
    },
