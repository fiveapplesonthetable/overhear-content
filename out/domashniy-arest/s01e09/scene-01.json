      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'How many times do I have to tell you?'",
      "gap": 0.45
    },
    {
      "v": "samson",
      "t": "Я просто сходил на концерт.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I just went to a concert.'",
      "gap": 0.45
    },
    {
