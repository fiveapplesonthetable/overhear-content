  "segments": [
    {
      "v": "narrator",
      "t": "In his private residence, Governor Lev Yegorych relaxes with young Vika, who playfully flatters him while he encourages her to drop formal titles and address him simply by his first name.",
      "gap": 0.8
    },
    {
      "v": "vika",
      "t": "Какие же у вас взрослые сыновья!",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Они очень похожи на вас, Лев Егорыч.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "Просто Лев, малышка, без отчества.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "Зови меня просто: Лёва.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Хорошо, Лёва, как скажешь.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Мне очень нравится твоё имя.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "Ты сегодня выглядишь просто прекрасно.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Спасибо большое за твою доброту.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "Я люблю дарить тебе радость.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Ты всегда делаешь мне подарки.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "Для тебя мне ничего не жалко.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Тогда налей мне ещё бокал вина.",
      "gap": 0.55
    },
    {
      "v": "lev",
      "t": "С большим удовольствием, дорогая моя!",
