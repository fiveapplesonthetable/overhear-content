  {
   "v": "narrator",
   "t": "Ivan Samsonov returns to his communal apartment room after the street brawl, where his wife Nina and daughter Yulia attend to him while watching breaking news of his political campaign on television.",
   "gap": 0.8
  },
  {
   "v": "samson",
   "t": "Я сам дойду до дивана.",
   "gap": 0.55
  },
  {
   "v": "anya",
   "t": "Считай, ты родился под счастливой звездой.",
   "gap": 0.55
  },
  {
