    },
    {
      "v": "samson",
      "t": "Последний раз спрашиваю. Где деньги?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I'm asking for the last time. Where is the money?'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Самсоновы, ну вы очнитесь!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Samsonovs, come to your senses!'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Я понимаю, вам очень хочется квартиру.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I understand you really want the flat.'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Но вы же нормальные люди.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'But you're normal people.'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Вы о детях своих подумайте.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Think about your children.'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Послушайте, вас посадят за это!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Listen, they will put you in prison for this!'",
      "gap": 0.45
    },
    {
      "v": "arkady",
      "t": "Соседи! Пожалуйста, помогите! Убивают!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Neighbours! Please, help! They're killing me!'",
      "gap": 0.65
