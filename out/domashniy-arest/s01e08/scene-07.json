    {
      "v": "nina",
      "t": "Без Вани мы ничего не сделаем.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Without Vanya we will do nothing.'",
      "gap": 0.45
    },
    {
      "v": "ilona",
      "t": "Его надо срочно найти!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'We need to find him urgently!'",
      "gap": 0.45
    },
    {
      "v": "nina",
      "t": "Где мы будем его искать?",
