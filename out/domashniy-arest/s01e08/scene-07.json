      "gap": 0.55
    },
    {
      "v": "ilona",
      "t": "Он совсем не подготовлен.",
      "gap": 0.55
    },
    {
      "v": "nina",
      "t": "Ваня очень переживает из-за слухов.",
      "gap": 0.55
    },
    {
      "v": "ilona",
      "t": "Слухи про дедушку — это провокация Осипенко.",
      "gap": 0.55
    },
    {
      "v": "nina",
      "t": "Но люди верят этой лжи.",
      "gap": 0.55
    },
    {
      "v": "ilona",
      "t": "Мы должны выиграть эти выборы!",
      "gap": 0.55
