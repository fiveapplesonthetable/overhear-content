      "t": "'And why are you silent?'",
      "gap": 0.45
    },
    {
      "v": "samson",
      "t": "К тебе кто приезжает?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Who is coming to your place?'",
      "gap": 0.45
    },
    {
      "v": "sanya",
      "t": "Никто.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Nobody.'",
