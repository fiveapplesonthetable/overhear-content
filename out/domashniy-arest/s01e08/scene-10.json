      "gap": 0.55
    },
    {
      "v": "samson",
      "t": "У меня ужасно болит голова.",
      "gap": 0.55
    },
    {
      "v": "barman",
      "t": "Ты пил всю ночь напролёт.",
      "gap": 0.55
    },
    {
      "v": "samson",
      "t": "Я должен всё забыть.",
      "gap": 0.55
    },
    {
      "v": "barman",
      "t": "Твои деньги совсем закончились.",
