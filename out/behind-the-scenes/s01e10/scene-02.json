    {
      "v": "narrator",
      "t": "Convinced that Chun Yuqiao looked up her birthday in the company records after deciding tea was too ordinary, Bu Xiaogu heads out happily after work. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "明天见！",
      "gap": 0.3
    }
