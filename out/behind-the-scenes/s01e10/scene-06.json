    {
      "v": "chun_yuqiao",
      "t": "谢你什么？谢你给我机会，帮你家公司赚钱吗？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "我刚打球你不是看了吗？",
      "gap": 0.5
