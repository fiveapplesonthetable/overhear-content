    {
      "v": "chun_yuqiao",
      "t": "举办了一届校际桌式足球比赛。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "然后就摸清了规则，技战术练了练。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "学校几个球友打不过我，嫌没劲。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "这联赛就没有再举办过第二届。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Walking out with the sponsor crisis solved, Chun Yuqiao dryly explains he mastered foosball back at university after organizing a single campus tournament nobody could beat him in. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "下次见！",
      "gap": 0.3
    }
  ],
