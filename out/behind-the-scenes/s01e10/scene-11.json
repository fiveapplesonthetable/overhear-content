    {
      "v": "xin_huimei",
      "t": "我这几天没空。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Smiling that both of them are going all out for someone they care about, Xin Huimei waves off her manager's worries about Weibo marriage gossip to prepare a bigger reunion surprise. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xin_huimei",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
