      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Telling Xiaogu to enjoy her evening, Chun Yuqiao accompanies the chairwoman's brother to Hong Kong and steps up to the foosball table under international tournament rules. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
