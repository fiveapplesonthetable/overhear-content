    {
      "v": "chun_yuqiao",
      "t": "公司有事要加班，晚上我住办公室。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Hurt when Chun Yuqiao insists protecting her is his duty while refusing to tell her about his past with Luo Lin, Xin Huimei watches him walk out to sleep at the office. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
