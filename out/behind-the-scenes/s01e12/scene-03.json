    {
      "v": "narrator",
      "t": "Touched by his thoughtful reminder that heartbreak should be handled gently without leaving scars, Xiaogu thanks him and accepts a ride home in his modest new car. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
