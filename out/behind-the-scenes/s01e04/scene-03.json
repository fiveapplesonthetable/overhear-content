    {
      "v": "crew",
      "t": "你们居然在这儿吃饭吗？",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "没事，大家先一起吃饱吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Lin Jie calmly secures the studio equipment and wins over the grumbling crew with hot lunch boxes. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "回头见！",
      "gap": 0.3
    }
