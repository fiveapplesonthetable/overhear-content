      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "这种事咱们都没干过，林姐还真敢干啊。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "好像是布小谷送去的亲笔签字函。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Faced with undeniable ratings numbers, the rival manager falls silent, and Yuqiao adjourns the meeting cleanly. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
