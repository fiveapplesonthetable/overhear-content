    {
      "v": "bu_xiaogu",
      "t": "你是不是去找老李，结果被他拒绝了？",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "参加盛典项目这个机会，可不是天天都有的。",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "总之你下了班以后回学校跑一趟吧。",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "我晚上还有个约会，没那工夫。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "你今晚跟谁约会啊？",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "淳于师兄啊，今天晚上我要好好跟他请教节目制作的问题。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "While Qin Xiao heads off expecting a coffee date with Yuqiao, Xiaogu quietly takes on the campus trip after hours. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
