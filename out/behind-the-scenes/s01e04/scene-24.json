    {
      "v": "xingzi",
      "t": "完了，红毯直播已经开始了！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "With the two rival commentators already live on camera and Xiaogu's classmates turned away, Star Night faces double trouble. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "回头见！",
      "gap": 0.3
