    {
      "v": "qin_xiao",
      "t": "辛惠美的车果然也到了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "With enthusiastic college classmates lined up along the red carpet, everything looks ready for curtain-up. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "下次见！",
      "gap": 0.3
