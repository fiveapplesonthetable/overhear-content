    {
      "v": "chun_yuqiao",
      "t": "她昨天跟原野已经达成了庭外和解，准备自己付这笔违约金。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "等到钱一到位，我们邀请她就没有障碍了。",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "我直说吧，其实我们担心你和她有前嫌。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "我跟她没有前嫌，明天之内给你回复。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Setting personal feelings aside, Yuqiao chooses the best performer for the broadcast and promises a quick confirmation. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "明天见！",
      "gap": 0.3
    }
