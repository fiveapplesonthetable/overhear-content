  "pair": "zh-en",
  "title": "三班制和咖啡  (Three Shifts and Coffee)",
  "level": "A1 — beginner",
  "labels": {
    "chun_yuqiao": "淳于乔",
    "kaiwen": "凯文",
    "bu_xiaogu": "布小谷"
