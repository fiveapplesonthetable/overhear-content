      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Yuqiao puts Unit One on round-the-clock shifts to handle the workload and leaves Xiaogu determined to brew a better cup next time. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
    }
