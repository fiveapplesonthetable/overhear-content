      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "跟你说实话吧，写报道只是个由头，主要目的是帮路条网拿到星天的营销单。",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "你就跟我透个底吧，他们两边你觉得谁能赢？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Having traded academic credentials with Xiaogu, Bianbian admits Lutiao News wants Xingtian's marketing contract and asks which side will win. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
    }
