      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Ignoring the pain in his stomach, Yuqiao drinks toast after toast himself to earn the rival units' cooperation. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
