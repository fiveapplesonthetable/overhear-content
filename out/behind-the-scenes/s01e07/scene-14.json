    {
      "v": "bu_xiaogu",
      "t": "太好了！好的雷总，雷总再见！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Instead of being dismissed, Xiaogu is officially promoted out of administration into the chief editor's office as an assistant planner. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
