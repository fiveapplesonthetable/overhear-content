    {
      "v": "bianbian",
      "t": "我是来写星天深度报道的，你是让我采访一下，还是让我随便写呢？",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "下班有空吗？我请你喝一杯。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "行。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Sensing Bianbian is dangerously close to uncovering how Xingtian protected her, Xiaogu agrees to meet him after work. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
