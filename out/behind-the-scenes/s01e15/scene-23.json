    {
      "v": "narrator",
      "t": "With the lead star still unreachable and heavy rain bearing down, Bu Xiaogu decisively orders the emergency plan into action tonight. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
