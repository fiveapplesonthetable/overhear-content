    {
      "v": "xingzi",
      "t": "根据粉团科技昨天的数据，观众期待值排名第一！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "太棒了，不枉费我们在欧洲大战三百回合！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "老大亲自带队，片子做得这么好，我一点都不意外。",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "你是不知道，扛摄像机真能把人累坏了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Learning from Fentuan data that their trailer ranks first in viewer anticipation makes every gruelling day of filming worthwhile for Kaiwen and Xingzi. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
