    {
      "v": "chun_yuqiao",
      "t": "我要听到他们亲自说话，或者见到他们本人。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "淳于总，你的胃又疼了吗？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "给我拿一下药。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "小谷你留守公司，盯住今天的天气情况。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "好，我这就给你拿药。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "你知道老大病发的时候最不想见人，咱们赶快行动吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xingzi hurries Bu Xiaogu out to carry out her weather-watch duties so Chun Yuqiao does not have to let anyone see him in pain. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
