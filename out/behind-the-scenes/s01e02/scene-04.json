    {
      "v": "chun_yuqiao",
      "t": "布小谷做事很努力，而且她是清白的。",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "布小谷留下来，在哪个部门干什么呀？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "别的部门不要，就留在总编室。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "你以前说总编室永远不招实习生。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "我当然不带她，你带！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "知道了，我们开会吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Thanks to her honest apology call, Bu Xiaogu keeps her internship and lands a spot under Xingzi in the chief editor's office. You learned \"fangxin\" for 'relax', \"bumen\" for 'department', and \"dai\" for mentoring a newcomer. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
