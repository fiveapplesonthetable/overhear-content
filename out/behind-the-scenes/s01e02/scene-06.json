    {
      "v": "narrator",
      "t": "Stunned by the truth about Wang Er, Xiaogu takes the Star Night assignment file with just one night to deliver results. You learned \"yuanyi\" for 'willing', \"yaohaishi bu yao\" choices with \"haishi\", and \"renwu\" for 'assignment'. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "明天见！",
      "gap": 0.3
    }
