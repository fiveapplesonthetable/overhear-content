    {
      "v": "chun_yuqiao",
      "t": "但是以后，希望你按规矩做事。",
      "gap": 0.5
    },
    {
      "v": "xie_ling",
      "t": "你的作风，我比谁都清楚。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "老规矩，谁输了谁买单。",
      "gap": 0.5
    },
    {
      "v": "xie_ling",
      "t": "来了，我买单！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Yuqiao walks out leaving Xie Ling with both the warning and the lounge check. You learned \"shenbian\" for 'around me', \"an guiju\" for 'by the rules', and \"maidan\" for paying the bill. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
  ],
