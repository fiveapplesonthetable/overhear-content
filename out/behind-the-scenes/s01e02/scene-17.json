    {
      "v": "narrator",
      "t": "Remembering Yuqiao's challenge, Xiaogu turns down the safe DTS offer and commits to proving herself at Xingtian from the ground up. You learned \"ku\" for tough work, \"buhaoyisi\" for polite apologies, and \"jiusuan ... ye\" for 'even if'. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "再见！",
      "gap": 0.3
    }
