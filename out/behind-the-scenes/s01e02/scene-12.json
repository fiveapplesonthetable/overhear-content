    {
      "v": "kaiwen",
      "t": "所以第一方案还是李铭基。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "不用滚了，慢慢走着去吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xiaogu's effort on Li Mingji turns out to be crucial for the finals. In this scene you learned how to stand your ground and clear up a misunderstanding.",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
