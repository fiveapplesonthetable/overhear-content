      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "误会，误会，误会。",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "刚才是杏子打电话过来，说辛惠美同意来参加半决赛，",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "客座导师。当然因为演出还被雪藏，总决赛来不了。",
      "gap": 0.5
