   "v": "bu_xiaogu",
   "t": "李铭基的事交给我了。",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "They now have two guests booked.",
   "gap": 0.5
  },
  {
   "v": "kaiwen",
   "t": "明天见！",
   "gap": 0.3
