    {
      "v": "wen_simo",
      "t": "好的，辛苦了，你这个翻译很地道啊。",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "他想去医院看朋友，已经帮他们安排好了车。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Lucky improvisation saves the recording on camera, yet Chun Yuqiao is seconds away from walking onto the set. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "下次见！",
      "gap": 0.3
    }
