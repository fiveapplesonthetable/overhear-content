    {
      "v": "narrator",
      "t": "Years of quiet study pay off in an instant as Bu Xiaogu hands Unit One a ready-made blueprint for season three. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "下次见！",
      "gap": 0.3
