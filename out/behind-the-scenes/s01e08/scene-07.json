    {
      "v": "narrator",
      "t": "While Kaiwen ponders buying matching mugs, Bu Xiaogu is already halfway to the hospital ward. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "明天见！",
      "gap": 0.3
