    {
      "v": "lin_jie",
      "t": "现场各就各位，闻老师，可以了，开始！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Everything looks smooth as cameras roll on Unit Two's debut taping—until an overlooked ingredient triggers chaos onstage. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "回头见！",
      "gap": 0.3
    }
