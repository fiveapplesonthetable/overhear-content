      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Every stakeholder clings to the safe old formula, setting the stage for Chun Yuqiao's sharpest speech yet. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
