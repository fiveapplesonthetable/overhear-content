      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Called to the front of Xingtian's biggest meeting room, Bu Xiaogu steps into the spotlight to pitch her bold new competition rules. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "下次见！",
      "gap": 0.3
