    {
      "v": "narrator",
      "t": "Away from the office rush, Chun Yuqiao shows a rare gentle side toward his hardworking intern. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
