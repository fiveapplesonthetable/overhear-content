      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Bu Xiaogu makes everyone swear not to visit the hospital—a promise she is about to break five minutes later. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "再见！",
      "gap": 0.3
    }
