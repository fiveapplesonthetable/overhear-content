      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Under the polite excuse of protecting the network schedule, Qin Xiao springs a two-day deadline squeeze on Unit One. See you next time!",
      "gap": 0.5
    },
    {
      "v": "qin_xiao",
      "t": "回头见！",
      "gap": 0.3
    }
