      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Refusing to let celebratory cake gloss over a preventable safety lapse, Chun Yuqiao leaves Unit Two chastened—and catches Wen Simo's eye backstage. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
