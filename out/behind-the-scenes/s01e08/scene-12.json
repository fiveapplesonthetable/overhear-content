    {
      "v": "lin_jie",
      "t": "车呢？车已经到了，快送医院！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Kaiwen's emergency protocol gets the interpreter to hospital in time, leaving Studio Four without a translator mid-show. See you next time!",
      "gap": 0.5
    },
    {
      "v": "wen_simo",
      "t": "再见！",
      "gap": 0.3
