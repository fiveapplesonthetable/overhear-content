    {
      "v": "bu_xiaogu",
      "t": "喂，你好，这里是总编室。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Spotting an ideal casting opening in the hit drama adaptation, Xingzi and Xiaogu team up to win the sidelined actor a career-reviving lead role. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "回头见！",
      "gap": 0.3
    }
