      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "仔细看看，还真有一点像！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "快去给老大看他闺女的视频吧。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "拿过来给我看看吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Opening the video clip, Bu Xiaogu bursts into amazed relief upon discovering that Chun Yuqiao's beloved daughter is actually an adorable cat. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
