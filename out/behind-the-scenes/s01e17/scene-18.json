    {
      "v": "chun_yuqiao",
      "t": "之前的事就当都没有发生过，我离职之前，先让她停职别来公司。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Speaking cruelly only so Bu Xiaogu will stop sacrificing her career for him, Chun Yuqiao privately suspends her until his quiet resignation from Xingtian is complete. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
