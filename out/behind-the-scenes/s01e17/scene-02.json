    {
      "v": "chun_yuqiao",
      "t": "董事长，能不能把你的电话借给我用一下？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "从我住院之后，有一个人就一直不再接我电话了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "With Bu Xiaogu safely hidden in the bedroom, Chun Yuqiao receives praise for Twelve Singers beating Supernova and having his executive post restored. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
