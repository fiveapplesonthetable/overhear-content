    {
      "v": "xingzi",
      "t": "这里面是所有明星粉丝团的资料，借你看一下。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "小粉红笔记本？杏子姐这是你私藏的吗？",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "重点不要放在我的粉红色笔记本上！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "快看资料查邮件，事情很多，不要出错。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Armed with Xingzi's pink notebook and a stack of emails, Xiaogu dives into the world of celebrity fan clubs. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
