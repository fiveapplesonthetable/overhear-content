      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "With both Yuqiao and Kaiwen unwell after the gala, the chief editor's office urgently needs an extra pair of hands. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
