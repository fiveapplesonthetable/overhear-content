      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Refusing to poach producers from other departments, Yuqiao keeps Xiaogu right where she belongs in the chief editor's office. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
