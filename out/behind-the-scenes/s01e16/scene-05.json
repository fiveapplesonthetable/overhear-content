      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "While Chun Yuqiao rests in the quiet room, a fierce battle over his authority erupts in Xingtian's conference room. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "下次见！",
      "gap": 0.3
    }
