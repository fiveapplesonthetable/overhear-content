    {
      "v": "bianbian",
      "t": "您让我给你做个采访什么的，我留点资料，以后好给你写个回忆录。",
      "gap": 0.5
    },
    {
      "v": "ji_xiu",
      "t": "你胡说什么呢？这事能瞎说吗？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Instead of taking offence at Bianbian's clumsy memoir joke, Chun Yuqiao matches him with deadpan humour—and a quiet warning. See you next time!",
      "gap": 0.5
    },
    {
      "v": "ji_xiu",
      "t": "再见！",
      "gap": 0.3
    }
