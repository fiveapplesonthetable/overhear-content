    {
      "v": "chun_yuqiao",
      "t": "今天看见的，你不会又乱写吧？",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "你就放心吧，现在两个人找到真爱不容易。",
      "gap": 0.5
