    {
      "v": "bu_xiaogu",
      "t": "没事，我不饿，我在那儿守着你。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Safe inside Chun Yuqiao's quiet flat at last, neither of them expects the hospital visitors to track him straight to his front door. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "下次见！",
      "gap": 0.3
    }
