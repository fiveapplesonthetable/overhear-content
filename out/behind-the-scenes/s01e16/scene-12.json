    {
      "v": "bu_xiaogu",
      "t": "我批准你，别着凉了。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "你不是把我拉黑了吗？",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "我今天下午又把你也拉回来了！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Wrapped up against the chill with his loyal team reunited behind him, Chun Yuqiao marches straight into the control booth. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
