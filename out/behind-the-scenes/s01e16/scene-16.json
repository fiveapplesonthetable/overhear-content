    {
      "v": "chun_yuqiao",
      "t": "没事。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "我请了年假，这几天我就照顾你了，你要是不嫌我烦的话。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "你不是一直都在照顾我吗？",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "我去给你倒杯水。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Their quiet hospital moment barely lasts a minute before two noisy entertainment reporters arrive together. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
