    {
      "v": "qin_xiao",
      "t": "主任，台里电话，现在怎么弄都是大麻烦。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Out of answers as the clock ticks down, the very executives who sidelined Chun Yuqiao rush straight to his sickroom for help. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "再见！",
      "gap": 0.3
