    {
      "v": "narrator",
      "t": "Lin Jie interrupts Bu Xiaogu's dramatic rehearsal and cheerfully points her toward the studio door where Chun Yuqiao is waiting inside. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "回头见！",
      "gap": 0.3
