    {
      "v": "bu_xiaogu",
      "t": "我可以先去说服那些广告商啊。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "老大跟他们开了八回会都没说服他们，肯定给你面子，去吧。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "那我去找邓主任商量商量，争取让电视台支持咱们。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xingzi and Kaiwen tease Bu Xiaogu's fiery ambition as she volunteers to win over both the advertisers and the television network. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
