      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Holding a birthday gift when she has never told anyone in the city her birthday, Bu Xiaogu wonders who her secret sender could be. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "下次见！",
      "gap": 0.3
    }
