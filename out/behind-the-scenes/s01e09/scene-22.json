    {
      "v": "bu_xiaogu",
      "t": "行，我知道了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Bu Xiaogu is stunned to hear that Chun Yuqiao talked about inviting her for tea, and Kaiwen cheerfully asks her to keep him posted. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
