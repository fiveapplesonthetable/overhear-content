    {
      "v": "bu_xiaogu",
      "t": "不不不，我没有这意思，怎么可能呢？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "不管怎样，别人可以看轻你、贬低你。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "但是你自己，千万不要这样说自己。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Chun Yuqiao reminds Bu Xiaogu that he personally championed her proposal and tells her never to belittle her own work. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
