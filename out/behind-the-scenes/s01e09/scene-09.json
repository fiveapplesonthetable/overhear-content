      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Worried that Wen Simo looked upset earlier, Bu Xiaogu waited outside until her legs went numb, softening Chun Yuqiao's stern mood. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
