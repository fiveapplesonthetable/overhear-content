    {
      "v": "chun_yuqiao",
      "t": "上次的事情，真是对不起啊。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "蛋糕的事，我不该随便发火。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "那样辜负了大家的心意，你帮我跟大伙说声抱歉。",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "别呀老大，您这话说的，本身也是我们不靠谱，该骂。",
      "gap": 0.5
    },
    {
      "v": "crew",
      "t": "饭到了，开饭了，大伙午休吧！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "老大，您的饭我也一块儿订了，您先歇会儿吃一口。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "好的，谢谢你。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Chun Yuqiao asks Kaiwen to pass along his apology to the crew for losing his temper over the cake, just as lunch arrives on set. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
