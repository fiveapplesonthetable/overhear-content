      "gap": 0.5
    },
    {
      "v": "xin_huimei",
      "t": "淳于总胃不太好，我帮他喝一杯，我先去漱个口。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xin Huimei publicly claims Chun Yuqiao as her boyfriend and rescues him from the awkward toast, though banquet tension lingers into the night. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xin_huimei",
      "t": "回头见！",
      "gap": 0.3
    }
