    {
      "v": "bu_xiaogu",
      "t": "要是主管问起我的话，就让他去找您！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Whisked out of the garage as the chairwoman's secret driver, Bu Xiaogu spends an unforgettable afternoon away from her desk. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "下次见！",
      "gap": 0.3
    }
