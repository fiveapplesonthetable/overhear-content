    {
      "v": "chun_yuqiao",
      "t": "出发之前写完一稿，到了欧洲你就没时间写了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Before Bu Xiaogu boards her first overseas shoot, Chun Yuqiao has one final casting score to settle behind closed doors. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "再见！",
      "gap": 0.3
    }
