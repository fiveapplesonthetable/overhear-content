    {
      "v": "chun_yuqiao",
      "t": "我们都会把她们照顾好的。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Having passed a thorough background check with flying colours, Chun Yuqiao pledges to guide Bu Xiaogu's growth as a producer. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
