    {
      "v": "xin_huimei",
      "t": "知道我起晚了，为什么不提醒我一下呢？",
      "gap": 0.5
    },
    {
      "v": "xin_huimei",
      "t": "打个电话或者发个信息也好呀。",
      "gap": 0.5
