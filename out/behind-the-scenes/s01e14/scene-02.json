    {
      "v": "chun_yuqiao",
      "t": "难免也会不靠谱一下，所以你别生气，以后不会了。",
      "gap": 0.5
    },
    {
      "v": "xin_huimei",
      "t": "不好意思啊，我去一下化妆间。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "好，我陪她去趟化妆间。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Hearing Chun Yuqiao call himself unreliable just to soothe Xin Huimei leaves the entire crew stunned. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
