    {
      "v": "ji_xiu",
      "t": "根本不是真正的粉丝人气，属于伪热度。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "叫凯文来。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "你有没有觉得，他不发脾气反而更吓人？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Armed with the data on the newcomer's fake buzz, Chun Yuqiao dispatches Kaiwen to set a textbook reality-TV trap. See you next time!",
      "gap": 0.5
    },
    {
      "v": "ji_xiu",
      "t": "下次见！",
      "gap": 0.3
    }
  ],
