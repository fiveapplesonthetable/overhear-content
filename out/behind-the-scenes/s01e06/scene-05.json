    {
      "v": "narrator",
      "t": "Amused by the checklist for a younger version of himself, Chun Yuqiao decides to switch from plain water to coffee. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "下次见！",
      "gap": 0.3
    }
