      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Though kept on the sidelines in administration, Bu Xiaogu gets wise advice that watching a storm from outside can teach more than standing in its eye. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
