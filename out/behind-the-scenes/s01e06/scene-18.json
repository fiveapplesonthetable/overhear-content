      "t": "好，老地方见。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "私人约会？老大？",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "老大露出了复仇之笑！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "While Kaiwen assumes Chun Yuqiao is going to gloat, Chun Yuqiao is actually heading out to sign Xin Huimei himself. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "再见！",
      "gap": 0.3
    }
