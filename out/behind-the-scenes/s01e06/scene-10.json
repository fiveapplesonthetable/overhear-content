    {
      "v": "kaiwen",
      "t": "我住一礼拜医院，回来之后我还盯他们俩。",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "谁要约老大？辛惠美！",
      "gap": 0.5
