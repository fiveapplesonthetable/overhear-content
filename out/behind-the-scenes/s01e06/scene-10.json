    {
      "v": "kaiwen",
      "t": "我回医院！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "不好意思，你继续说。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Just as Kaiwen prepares to return to work, word that Xin Huimei wants a private meeting with Chun Yuqiao catches everyone off guard. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "明天见！",
      "gap": 0.3
    }
