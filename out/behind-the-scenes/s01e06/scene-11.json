    {
      "v": "bianbian",
      "t": "但您这德吧，真不好说。",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "你说你作为一个文化人。",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "整天对人家八卦隐私那么感兴趣。",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "你说你现在这么不红，你觉得你自己算成功吗？",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "喂？喂？信号不好断了？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Instead of attacking Chun Yuqiao as planned, Bianbian leaves the radio host scrambling to cut the live line. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "回头见！",
      "gap": 0.3
    }
