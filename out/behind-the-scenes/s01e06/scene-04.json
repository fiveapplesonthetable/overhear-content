      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "是吗？小谷还回行政部吗？",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "她暂时不回来了。",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "她不回来比较好。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "你跟她相处的关系不好吗？",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "没有没有，我跟她是好朋友。",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "我是觉得她不适合待在行政部。",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "她应该去搞点制作，干点大事。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Even Bu Xiaogu's desk mate in administration can see that Xiaogu's real passion belongs in television production. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
  ],
