      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Chun Yuqiao refuses to trade on his private past for sympathy, leaving Xin Huimei even more intrigued by his quiet integrity. See you next time!",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "再见！",
      "gap": 0.3
    }
