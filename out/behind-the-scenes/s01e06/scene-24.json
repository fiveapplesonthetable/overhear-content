    {
      "v": "narrator",
      "t": "Kaiwen rewards Bianbian's peace offering with an assignment straight under Xingtian's toughest PR boss, Stella. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bianbian",
      "t": "下次见！",
      "gap": 0.3
    }
