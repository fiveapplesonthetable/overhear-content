    {
      "v": "bu_xiaogu",
      "t": "那就是说，辛惠美说的是真的了？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Yuqiao refuses to let online gossip distract from the live finale, leaving Xiaogu stunned on the pavement. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "回头见！",
      "gap": 0.3
    }
