      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xiaogu notices Li Mingji taking pills together and worries about his health right before he is called to the stage. See you next time!",
      "gap": 0.5
    },
    {
      "v": "crew",
      "t": "下次见！",
      "gap": 0.3
