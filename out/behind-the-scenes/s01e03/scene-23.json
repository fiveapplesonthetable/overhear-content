    {
      "v": "kaiwen",
      "t": "行啊，随时欢迎你们看一看。",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "您的冰美式不加糖，谢谢。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xiaogu calmly serves Qin Xiao's unsweetened iced coffee while Unit One gears up to prove itself under network supervision. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "再见！",
      "gap": 0.3
