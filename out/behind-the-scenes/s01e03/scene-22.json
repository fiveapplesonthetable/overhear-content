    {
      "v": "chun_yuqiao",
      "t": "制作一部都是高级员工，没有实习生。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "责任必须到人的话，人不是在你面前吗？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Yuqiao refuses to let an intern take the fall and shoulders full responsibility for Unit One himself. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
