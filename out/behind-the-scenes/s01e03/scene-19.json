    {
      "v": "stella",
      "t": "根据公司的规定，我这个公关总监签字就能立即生效。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Dismissed by Stella after a terrifying night at the station, Xiaogu leaves the office in tears. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xiaoye",
      "t": "再见！",
      "gap": 0.3
    }
