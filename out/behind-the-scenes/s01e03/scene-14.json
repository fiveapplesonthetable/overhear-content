    {
      "v": "chun_yuqiao",
      "t": "你们别找她了。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "李先生晕倒的事跟她没有任何关系。",
      "gap": 0.5
    },
    {
      "v": "chun_yuqiao",
      "t": "大家先别激动，等医院的消息。",
      "gap": 0.5
    },
    {
      "v": "wen_simo",
      "t": "请现场观众朋友们保持安静。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "When Li Mingji collapses onstage and suspicion falls on the backstage staff, Chun Yuqiao immediately steps forward to shield his team. See you next time!",
      "gap": 0.5
    },
    {
      "v": "wen_simo",
      "t": "再见！",
      "gap": 0.3
    }
