      "v": "narrator",
      "t": "Rushing into Studio One for the live finale, Bu Xiaogu calls her thesis advisor Professor Fang to ask for one last night on her paper. Listen to their phone conversation first.",
      "gap": 0.8
    },
    {
      "v": "bu_xiaogu",
      "t": "方老师，不好意思。",
      "gap": 0.55
    },
