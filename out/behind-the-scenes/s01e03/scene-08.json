      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Xiaogu wins Lin Jie's trust with her careful backstage work and heads off to the artist corridor. See you next time!",
      "gap": 0.5
    },
    {
      "v": "lin_jie",
      "t": "回头见！",
      "gap": 0.3
    }
