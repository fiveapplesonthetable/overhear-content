    {
      "v": "kaiwen",
      "t": "商量出个主意，一早上问罪来了。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Barely out of one crisis, Yuqiao, Xingzi, and Kaiwen walk straight into an early-morning reckoning with DTS network bosses. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
