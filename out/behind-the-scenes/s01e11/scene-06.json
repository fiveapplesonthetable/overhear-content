    {
      "v": "narrator",
      "t": "Teasing Xiaogu that six years of loyal service never earned her such special treatment from Manta Ray, Xingzi shoos her off toward human resources. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "下次见！",
      "gap": 0.3
