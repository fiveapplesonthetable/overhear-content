    {
      "v": "kaiwen",
      "t": "淳于总让我来的，车钥匙给我。",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "他就在后门口等你，快去吧！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "车走了，把记者引开了！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "行，让他们追我的车吧。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Driving Xin Huimei's car out as a decoy to draw the reporters away, Kaiwen clears the path for Huimei and the child to meet Chun Yuqiao safely. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
