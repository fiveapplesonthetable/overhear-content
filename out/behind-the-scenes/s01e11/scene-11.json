    {
      "v": "narrator",
      "t": "Ringing Chun Yuqiao's bell to speak from the heart, Bu Xiaogu freezes when Xin Huimei opens the door from inside and asks for privacy. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "下次见！",
      "gap": 0.3
    }
