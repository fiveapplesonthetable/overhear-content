    {
      "v": "xie_ling",
      "t": "我要让这档节目彻底终结！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Convinced that Chun Yuqiao's lingering prestige rests on Charming Voyage, Xie Ling resolves to have the delayed original show cancelled permanently. See you next time!",
      "gap": 0.5
    },
    {
      "v": "xie_ling",
      "t": "明天见！",
      "gap": 0.3
    }
