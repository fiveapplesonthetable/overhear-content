    {
      "v": "chun_yuqiao",
      "t": "希望星天接下来一切顺利。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Even though Xie Ling schemed against him for years, Chun Yuqiao sets personal grudges aside and objectively recommends him as the strongest replacement on the market. See you next time!",
      "gap": 0.5
