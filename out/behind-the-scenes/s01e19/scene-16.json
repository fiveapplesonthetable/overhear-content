    {
      "v": "xie_ling",
      "t": "你说什么？你把话给我说清楚了！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "谢老师，看这儿，看我嘴型：你缺德！",
      "gap": 0.5
    },
    {
      "v": "xie_ling",
      "t": "你们几个阴魂不散是吧？我已经把你们开除了，还不滚蛋！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "你让谁滚蛋呢？让你滚蛋！",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "到底要不要脸啊！",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "我想教训你不是一年两年了，你给我出来！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Told to his face that Xingtian abolished Chun Yuqiao's old executive rank and restored all four production units to equal footing, Xie Ling nearly comes to blows with Kaiwen in the hallway. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kaiwen",
      "t": "回头见！",
      "gap": 0.3
    }
  ],
