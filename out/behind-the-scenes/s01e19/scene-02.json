    {
      "v": "bu_xiaogu",
      "t": "明天一定会有好消息的。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Encouraged by the chairwoman's promise to give them an answer tomorrow, Xiaogu and Kaiwen celebrate settling both crises and look forward to welcoming their boss back. See you next time!",
      "gap": 0.5
    },
    {
      "v": "bu_xiaogu",
      "t": "明天见！",
      "gap": 0.3
    }
  ],
