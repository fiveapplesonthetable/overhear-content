    {
      "v": "narrator",
      "t": "With Xingzi guiding her, Xiaogu finally has an ally inside the chief editor's team — right before she overhears a troubling phone call. You learned \"hao lihai\", \"xuedao\", and \"haohao gongzuo\".",
      "gap": 0.5
    },
    {
      "v": "xingzi",
      "t": "明天见！",
      "gap": 0.3
    }
