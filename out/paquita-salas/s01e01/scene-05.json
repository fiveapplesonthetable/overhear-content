      "t": "¡Si estás espectacular! Estás preciosa.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "A ver un giro.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "El rojo es tu color.",
      "gap": 0.55
    },
    {
