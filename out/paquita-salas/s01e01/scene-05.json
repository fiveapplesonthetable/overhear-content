    },
    {
      "v": "narrator",
      "t": "'It's a little big.'",
      "gap": 0.45
    },
    {
      "v": "paquita",
      "t": "Vamos a sacarnos una foto para tu ex.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'We're going to take a photo for your ex.'",
      "gap": 0.45
