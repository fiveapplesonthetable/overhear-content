    },
    {
      "v": "alex",
      "t": "¿Me echáis una firma?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Could you sign here for me?'",
      "gap": 0.45
    },
    {
      "v": "alex",
