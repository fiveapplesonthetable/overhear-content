    },
    {
      "v": "narrator",
      "t": "'I can't do it on my own.'",
      "gap": 0.45
    },
    {
      "v": "paquita",
      "t": "Dame la mano.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Give me your hand.'",
      "gap": 0.45
    },
    {
      "v": "magui",
      "t": "¿Esto está clavado?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Is this nailed in?'",
