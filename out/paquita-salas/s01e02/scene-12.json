      "t": "Enhorabuena, estoy emocionadísimo.",
      "gap": 0.55
    },
    {
      "v": "director",
      "t": "Quería invitar al escenario a una persona muy importante.",
      "gap": 0.55
    },
    {
      "v": "director",
      "t": "Hoy terminan su trayectoria aquí en la escuela Primera Fila.",
      "gap": 0.55
    },
