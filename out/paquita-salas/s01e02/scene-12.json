      "gap": 0.45
    },
    {
      "v": "director",
      "t": "Hoy terminan su trayectoria aquí en la escuela Primera Fila.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Today they finish their journey here at the Primera Fila school.'",
      "gap": 0.45
