      "gap": 0.45
    },
    {
      "v": "paquita",
      "t": "Qué obrón ha hecho. Me voy a poner de pie.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'What a tremendous play she's put on. I'm going to stand up.'",
      "gap": 0.45
