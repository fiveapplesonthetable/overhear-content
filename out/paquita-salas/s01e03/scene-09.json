      "t": "Hombre, Arturo.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Well, Arturo.'",
      "gap": 0.45
    },
    {
      "v": "paquita",
      "t": "Buenas noches, Paquita.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Good evening, Paquita.'",
      "gap": 0.45
