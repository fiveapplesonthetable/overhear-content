  "segments": [
    {
      "v": "narrator",
      "t": "Paquita stops by a local bar in town, orders her usual gin and tonic from the bartender, and catches up with old friends. Listen to the Spanish first, then we'll go through it together.",
      "gap": 0.8
    },
    {
      "v": "paquita",
      "t": "Hombre, Arturo.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Buenas noches, Paquita.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "¿Qué tal?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Muy bien, ¿y tú, a dar una vuelta?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Sí, aquí, de visita.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Eso está bien, ¿qué vas a hacer?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Pues ponme un gin-tonic y unos torreznos.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Muy bien, de Larios, ¿verdad?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Como siempre.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Tú tan castiza.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "A la copa... convido yo.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Hombre, Pepe.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "¿Qué pasa, Paqui?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "¿Ya no quieres nada con los pobres?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Claro, como ahora juegas en primera división.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Ya me han dicho, ya, que estás entrenando un equipo de fútbol.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Sí, aquí seguimos, en el pueblo.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Pero no se te olvida, ¿eh?",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Ay, si las piedras de la plaza hablaran...",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Pues por mucho que juegue en primera división,",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "todavía hay... partidos amistosos.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Yo estoy dispuesto a jugar un partido amistoso",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "con prórroga y todo.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Que te caes.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Métete más.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "No llego.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "No puedo. No, no. Ponte así.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Cuidado con las medias, que son caras.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Calla.",
      "gap": 0.55
    },
    {
      "v": "paquita",
      "t": "Aquí.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
