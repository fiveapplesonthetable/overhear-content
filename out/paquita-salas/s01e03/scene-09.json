    {
      "v": "paquita",
      "t": "Muy bien, ¿y tú, a dar una vuelta?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Very good, and are you out for a walk?'",
      "gap": 0.45
