      "t": "Чего ты за своей бабой следи?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Чего ты не понял?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Может, выйдем?",
      "gap": 0.55
    },
    {
