    {
      "v": "narrator",
      "t": "Flashing back to reality, we see that when Alexey Smolin introduced himself as the Michelin inspector, Chef Barinov suffered a sudden stroke and collapsed on the spot before any tasting menu or coconut bet ever took place.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Ну не смотри на меня так.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Тебя нельзя так сильно перекормить.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "К вам пришёл инспектор Мишлен.",
      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "Здравствуйте, уважаемый Виктор Петрович.",
      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "Меня зовут Алексей Смолин.",
      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "Я сегодня инспектирую ваш ресторан.",
      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "С вами сейчас всё в порядке?",
      "gap": 0.55
    },
