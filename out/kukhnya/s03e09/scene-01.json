    {
      "v": "narrator",
      "t": "With the Chef acting as both the boss and the bad influence, Max has no way to refuse. Let us see how Vika reacts when they call the restaurant.",
      "gap": 0.5
    },
    {
      "v": "chef",
      "t": "Собирайся, пойдём скорее!",
      "gap": 0.3
