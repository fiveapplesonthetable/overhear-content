  "segments": [
    {
      "v": "narrator",
      "t": "Senya explains to Max that whenever Chef Barinov breaks up with a woman, he falls into deep sorrow and picks one unlucky cook as his round-the-clock companion. That very night, Max's phone rings at three in the morning.",
      "gap": 0.8
    },
    {
      "v": "senya",
      "t": "Ну всё, парень, попал ты.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Чего это я вдруг попал?",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Наш шеф расстаётся с женщиной.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Потом он уходит в глубокую грусть.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Ему там одному очень скучно.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Хватит меня лечить, я работаю.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Тебя ждёт следующая ступень дружбы.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Дружище, ты мне очень нужен.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Шеф, сейчас уже ночь на дворе.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Бери такси и приезжай ко мне.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Это дело жизни и смерти.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Хорошо, шеф, я уже выезжаю.",
