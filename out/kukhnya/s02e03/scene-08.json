  "segments": [
    {
      "v": "narrator",
      "t": "Sasha, a new waitress, accidentally drops something. She feels very bad and thinks she is going to be fired. Max tries to calm her down. Let's listen closely to their conversation in Russian first, and then walk through each line together.",
      "gap": 0.8
    },
    {
      "v": "sasha",
      "t": "Я не хотела, правда.",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Я сейчас все вытру.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Не надо плакать.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Все хорошо.",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Вы меня уволите?",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Вы расскажете все руководству.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Никуда я не пойду.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Ничего я не скажу.",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Извините меня.",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Я правда не хотела.",
      "gap": 0.55
    },
    {
