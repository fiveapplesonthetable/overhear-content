{
  "id": "kukhnya-s02e03-scene-13",
  "pair": "ru-en",
  "title": "Спор на кухне  (An Argument in the Kitchen)",
  "level": "A1 — Duolingo Section 2",
  "voices": {
    "narrator": "sky",
