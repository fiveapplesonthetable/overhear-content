    {
      "v": "fedya",
      "t": "Понял, желаю тебе приятного аппетита!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "To avoid chewing raw leather alone, Senya decides to disguise the sliced belt inside a fresh green salad. Next time you watch the episode, listen for the Russian expressions for 'to bring' and 'belt' — you will catch every word right away. See you in the next scene.",
      "gap": 0.5
    },
    {
      "v": "anya",
      "t": "Я всё равно выиграю наш спор!",
      "gap": 0.3
    }
