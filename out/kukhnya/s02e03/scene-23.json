        "line": 0,
        "cue": 351,
        "fragment": "Эв, дорогой, присаживайся."
      },
      {
        "line": 1,
        "cue": 352,
        "fragment": "Тимур, ты чего здесь?"
      },
      {
        "line": 2,
        "cue": 353,
        "fragment": "Елена Павловна сказала отвезти тебя по делам."
      },
      {
        "line": 3,
        "cue": 354,
        "fragment": "Надеюсь, у твоих дел есть симпатичная подружка."
      },
      {
        "line": 4,
        "cue": 355,
        "fragment": "Справедливость проявляется в воздаянии каждому по его заслугам."
      },
      {
        "line": 5,
        "cue": 356,
        "fragment": "Цицерон."
      },
      {
        "line": 6,
        "cue": 356,
        "fragment": "По-моему, это полная фигня."
      },
      {
        "line": 7,
        "cue": 357,
        "fragment": "Не жил Цицерон в 21 веке."
      },
      {
        "line": 8,
        "cue": 358,
        "fragment": "Люди обманывают"
      },
      {
        "line": 9,
        "cue": 359,
        "fragment": "Кто-то несет несправедливое наказание за другого."
      },
      {
        "line": 10,
        "cue": 363,
        "fragment": "В общем, жизнь сложная штука."
      },
      {
        "line": 11,
        "cue": 365,
        "fragment": "Хотя в этом, может, и есть справедливость."
      }
    ]
  }
