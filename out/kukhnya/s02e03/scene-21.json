  "segments": [
    {
      "v": "narrator",
      "t": "In this scene focused on the eaten belt, ENG Max's dangerous stunt goes horribly wrong when he accidentally slips. He finds himself actually hang. Let's listen closely to Senya and Fedya's exchange in Russian first, and then walk through each line together.",
      "gap": 0.8
    },
    {
      "v": "anya",
      "t": "Встали!",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "Салат не понравился.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Он его не пробовал.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "Вообще-то попробовал.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "У меня в салате ремень.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Мы просто поспорили.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Чтоб я ремень съел?",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Это не я.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Жрать будешь ты.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Пока всё не съешь, не уйдёшь.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "А можно хлеб?",
      "gap": 0.55
