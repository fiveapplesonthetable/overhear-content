    {
      "v": "louis",
      "t": "Хорошо.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Okay.' A crisp, everyday conversational reply meaning 'good' that you will hear constantly in Russian dialogue.",
      "gap": 0.4
    },
    {
      "v": "senya",
      "t": "Держи ремень.",
      "gap": 0.55
    },
    {
