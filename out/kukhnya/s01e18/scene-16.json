  {
   "v": "kostya",
   "t": "Нет, я просто хочу дать другую.",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "Не трогай ничего, иди отсюда!",
   "gap": 0.5
  },
  {
   "v": "kostya",
   "t": "Но я должен её забрать.",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "Я сказал, иди отсюда!",
   "gap": 0.5
  },
  {
   "v": "kostya",
   "t": "Хорошо, извините, я пойду.",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Kostya has to go away empty-handed, and the chef is left with the bottle. Remember \"idi otsyuda\", 'go from here', a rude way to tell someone to leave. See you next time!",
   "gap": 0.5
  },
  {
   "v": "kostya",
   "t": "Всего хорошего!",
   "gap": 0.3
  }
 ],
