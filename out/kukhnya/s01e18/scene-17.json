   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Дешевле найти новых людей.",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Какая разница, кто режет морковь?",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "Это моя команда!",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "Если ты их уволишь, ты потеряешь меня.",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Витя, просто сядь и успокойся.",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "Хорошо, разбирайтесь сами.",
   "gap": 0.5
  },
  {
   "v": "barinov",
   "t": "А я пока увольняюсь.",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Подожди, мы всё решим.",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Barinov threatens to quit, and Nagiyev has to talk him round. Keep the pair: \"uvolit\", to fire, and \"uvolitsya\", to quit. See you next time!",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Пока!",
   "gap": 0.3
  }
 ],
