   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "А что сказал шеф?",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Шеф ничего не сделал.",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Теперь мы без работы.",
   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "Что нам теперь делать?",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Не знаю, пойдём домой.",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Вот ваш расчёт.",
   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "Только двадцать тысяч?",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Остальное будет в конце месяца.",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "The payout is smaller than anyone expected, and the rest is promised for later. 'Raschyot' is a word for a final payment, and it is built on 'count'. See you next time!",
   "gap": 0.5
  },
  {
   "v": "nagiyev",
   "t": "Пока!",
   "gap": 0.3
  }
 ],
