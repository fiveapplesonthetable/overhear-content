    {
      "v": "fedya",
      "t": "Тебе надо выпить чего-нибудь крепкого.",
      "gap": 0.5
    },
    {
      "v": "senya",
      "t": "Хорошо, сейчас пойду поищу в баре.",
      "gap": 0.5
    },
    {
      "v": "senya",
      "t": "Если выживу, воровать продукты перестану!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Senya's resolve to stop stealing food lasts exactly as long as his stomach ache. Keep \"slyshish?\", you hear?, apart from \"slushat\", to listen on purpose. See you next time!",
      "gap": 0.5
    },
    {
      "v": "fedya",
      "t": "Удачи!",
      "gap": 0.3
    }
