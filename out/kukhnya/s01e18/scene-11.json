  "segments": [
    {
      "v": "narrator",
      "t": "The guys arrive at their destination and hesitate before going inside. Let's listen closely to their exchange in Russian first, and then walk through each line together.",
      "gap": 0.8
    },
    {
      "v": "anya",
      "t": "Ну что, мы приехали?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Да, мы на месте.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Нас уже ждут?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Да, они нас ждут.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Пошли узнаем, как дела.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Я немного волнуюсь.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Ребята, послушайте меня.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Я хочу вам что-то сказать.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "В последние дни я перегибал палку.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Я вел себя очень плохо.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Мы понимаем тебя.",
      "gap": 0.55
