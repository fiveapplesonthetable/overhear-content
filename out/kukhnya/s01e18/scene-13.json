  {
   "v": "fedya",
   "t": "Надо выпить перец и воду.",
   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "Ой, я больше не могу.",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Сеня, что с тобой?",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Сеня, открой глаза! Сеня!",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Сеня, держись!",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Senya collapses just as Fedya reaches for the pepper, and the scene ends on a note of alarm. Keep \"ne nado bylo\", you shouldn't have: it fits any mistake. See you next time!",
   "gap": 0.5
  },
  {
   "v": "fedya",
   "t": "Пока!",
   "gap": 0.3
  }
