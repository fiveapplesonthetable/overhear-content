  "segments": [
    {
      "v": "narrator",
      "t": "Max and Vika are together at last, and Max is thinking about what that really means. Hear it in Russian before we unpack it; the ideas are big but the words are small.",
      "gap": 0.8
    },
    {
      "v": "vika",
      "t": "О чём ты думаешь, Макс?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "О том, что у нас есть.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "А что у нас есть?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Мы есть друг у друга.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Это правда.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Многих часто терзают сомнения.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Какие сомнения?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Насколько тебе дорого то, что ты имеешь.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "А тебе дорого то, что у тебя есть?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Очень дорого.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "И мне, Макс.",
      "gap": 0.55
    },
    {
      "v": "max",
