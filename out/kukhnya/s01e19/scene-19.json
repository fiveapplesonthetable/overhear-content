    },
    {
      "v": "leva",
      "t": "Это прекрасно.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'This is wonderful.' Max puts 'this' up front so the listener immediately catches the tone, followed by 'perfectly'.",
