    },
    {
      "v": "narrator",
      "t": "'What?' Notice the word order: 'what' comes first, and 'what' finishes the sentence.",
      "gap": 0.4
    },
    {
      "v": "leva",
      "t": "Я думал о нас.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I thought about us.' Here 'I' sets up the idea, while 'us' comes at the end for emphasis.",
      "gap": 0.4
    },
