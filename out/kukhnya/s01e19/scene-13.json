   "t": "Идите работать!",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Хорошо, мы идем.",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "The old pair are back, as cheeky as ever. The word the cooks throw at each other, 'invalidy', is Barinov's favourite insult, and it has become the kitchen's password. See you next time!",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "До свидания!",
   "gap": 0.3
  }
