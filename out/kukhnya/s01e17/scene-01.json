      {
        "line": 0,
        "cue": 1,
        "fragment": "Я только чувствую, что я в гнилую сливу наступил."
      },
      {
        "line": 1,
        "cue": 2,
        "fragment": "Хватит ныть. У меня хорошее настроение."
      },
      {
        "line": 2,
        "cue": 3,
        "fragment": "Поэтому ты познаешь сейчас древнее искусство покупать на рынке."
      },
      {
        "line": 3,
        "cue": 4,
        "fragment": "Как ты думаешь, сколько дней этой треске?"
      },
      {
        "line": 4,
        "cue": 5,
        "fragment": "Да не так."
      },
      {
        "line": 4,
        "cue": 6,
        "fragment": "Учись."
      },
      {
        "line": 5,
        "cue": 7,
        "fragment": "Один. Сегодня привезли."
      },
      {
        "line": 6,
        "cue": 8,
        "fragment": "Смотри внимательно."
      },
      {
        "line": 6,
        "cue": 10,
        "fragment": "Смотри, губы поджал."
      },
      {
        "line": 7,
        "cue": 11,
        "fragment": "Это значит, что рыбе не менее трех дней."
      },
      {
        "line": 8,
        "cue": 12,
        "fragment": "Да какие три? Ну, ей максимум два."
      },
      {
        "line": 9,
        "cue": 13,
        "fragment": "О, нос почесал."
      },
      {
        "line": 10,
        "cue": 13,
        "fragment": "Это значит, что рыбе не меньше пяти дней."
      },
      {
        "line": 11,
        "cue": 14,
        "fragment": "Да еще ее замораживали."
      }
    ]
