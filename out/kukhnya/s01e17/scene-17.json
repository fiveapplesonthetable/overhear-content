    {
      "v": "narrator",
      "t": "Viktor goes to the rival restaurant and accuses the chef of stealing his new dish. We will hear it in Russian first, do not worry about catching every word.",
      "gap": 0.8
    },
    {
      "v": "viktor",
      "t": "Так, стоять.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "В чём дело?",
      "gap": 0.55
    },
    {
      "v": "viktor",
      "t": "Вы украли наше блюдо.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Мы его сами придумали.",
      "gap": 0.55
    },
    {
      "v": "viktor",
      "t": "Я так и знал.",
      "gap": 0.55
    },
    {
      "v": "viktor",
      "t": "Вы ничего не можете сами.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Посмотрите на эту дату.",
      "gap": 0.55
    },
    {
      "v": "viktor",
      "t": "Ну, ну.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Дайте мне меню, пожалуйста.",
      "gap": 0.55
