      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Пойдём, я подниму тебе настроение.",
      "gap": 0.55
    },
    {
      "v": "nastya",
      "t": "Привет! А вот и мы.",
      "gap": 0.55
