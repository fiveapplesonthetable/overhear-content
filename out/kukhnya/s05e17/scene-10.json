      "gap": 0.55
    },
    {
      "v": "nikita",
      "t": "Спасибо вам большое, Элеонора Андреевна.",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "Дальше ухаживай за Катей без криминала.",
