      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Good morning, here is money for candy.'",
      "gap": 0.45
    },
    {
      "v": "eva",
      "t": "Ну что, ты веришь мне теперь?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Well then, do you believe me now?'",
      "gap": 0.45
