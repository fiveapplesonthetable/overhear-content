      "t": "Ну как?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Как вы.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Еще раз огромное вам спасибо.",
      "gap": 0.55
    },
    {
