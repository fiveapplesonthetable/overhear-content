   "gap": 0.55
  },
  {
   "v": "sasha",
   "t": "Понятно, шеф, мы всё организуем.",
   "gap": 0.55
  },
  {
   "v": "barinov",
   "t": "Если рыба останется, я вас оштрафую!",
   "gap": 0.9
  },
  {
