  },
  {
   "v": "nastya",
   "t": "согласна",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ".",
   "gap": 0.4
  },
  {
   "v": "sasha",
   "t": "Вот и молодец, ты приняла решение.",
   "gap": 0.55
  },
  {
