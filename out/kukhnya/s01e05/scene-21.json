  },
  {
   "v": "fedya",
   "t": "полностью",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", 'completely', comes from the word for 'full'.",
   "gap": 0.4
  },
  {
   "v": "fedya",
   "t": "Сделай глубокий вдох.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Take a deep breath.' , 'a breath in', starts with ",
   "gap": 0.25
  },
  {
   "v": "fedya",
   "t": "вдох.",
