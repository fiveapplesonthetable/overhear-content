    {
      "v": "fedya",
      "t": "Делай каждое блюдо по очереди.",
      "gap": 0.5
    },
    {
      "v": "max",
      "t": "Хорошо, я понял твой совет.",
      "gap": 0.5
    },
    {
      "v": "fedya",
      "t": "Тогда начинай готовить спокойно!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Fedya's rule, that the rush is only in your head, works in an office as well as in a kitchen. A breath in and a breath out will help too.",
      "gap": 0.5
    },
    {
      "v": "fedya",
      "t": "Пока!",
      "gap": 0.3
    }
