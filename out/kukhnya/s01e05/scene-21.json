   "gap": 0.4
  },
  {
   "v": "fedya",
   "t": "Тогда начинай готовить спокойно!",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Then begin to cook calmly!' , 'calmly', is the adverb ",
