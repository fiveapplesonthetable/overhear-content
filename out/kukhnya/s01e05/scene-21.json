   "gap": 0.4
  },
  {
   "v": "fedya",
   "t": "А теперь медленный выдох.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'And now a slow exhale.' , 'a breath out', starts with ",
   "gap": 0.25
  },
  {
