   "gap": 0.55
  },
  {
   "v": "nastya",
   "t": "Я хотела отомстить Максиму через тебя.",
   "gap": 0.55
  },
  {
   "v": "kostya",
   "t": "Макс вполне заслуживает хорошего урока, знаешь.",
