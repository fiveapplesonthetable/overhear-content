   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Мы с тобой совсем не встречаемся.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'You and I are not dating at all.' 'You and I' comes out as ",
