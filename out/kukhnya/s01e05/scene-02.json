    {
      "v": "narrator",
      "t": "'It was incredibly romantic!'",
      "gap": 0.45
    },
    {
      "v": "sasha",
      "t": "Неужели ты влюбилась в него?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Did you really fall in love with him?'",
      "gap": 0.45
    },
    {
