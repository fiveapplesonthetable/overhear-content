  },
  {
   "v": "sasha",
   "t": "Хватит",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " away by ",
   "gap": 0.25
  },
  {
   "v": "sasha",
   "t": "плакать",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", 'to cry'. ",
