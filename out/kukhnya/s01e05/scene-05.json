  },
  {
   "v": "max",
   "t": "лучше",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "меня",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " to convey 'better of me'.",
   "gap": 0.4
  },
  {
   "v": "fedya",
   "t": "Уж точно намного лучше тебя!",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Certainly much better than you!' The same pattern applies with ",
   "gap": 0.25
  },
  {
   "v": "fedya",
   "t": "лучше",
   "gap": 0.25
  },
  {
   "v": "fedya",
   "t": "тебя",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ". Adding ",
