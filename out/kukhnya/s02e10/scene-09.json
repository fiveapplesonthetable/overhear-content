  "segments": [
    {
      "v": "narrator",
      "t": "Feeling responsible for the flood, Max invites Sasha to move into his apartment with him and Kostya. Although Sasha first suspects he is only asking out of guilt, she happily accepts and starts kissing him right on the kitchen table as Kostya walks in.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Слушай, я тут подумал.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Ты ко мне перейдешь?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Что ты чувствуешь вину.",
      "gap": 0.55
    },
    {
      "v": "sasha",
      "t": "Я сама разберусь со своими проблемами, правда.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Да я не из-за этого.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Я давно хотел предложить тебе.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Ну, а ты сам-то уверен?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "А чего нет?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Чего зря я время теряю?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Может, прямо здесь?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Не обращайте внимания.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Я вас не видел.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Костик, закрой глаза.",
      "gap": 0.9
