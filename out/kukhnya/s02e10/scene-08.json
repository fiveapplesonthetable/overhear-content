  "segments": [
    {
      "v": "narrator",
      "t": "Horrified that the kitchen is about to turn a live turtle into soup, vegetarian Nastya pleads with Fedya to spare the animal and give it to her instead. Softening under her gaze, Fedya hands the turtle over and promises to trick the guest with chicken marinated in fish stock.",
      "gap": 0.8
    },
    {
      "v": "fedya",
      "t": "Не будешь ее готовить?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Не буду.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "А готовить завтра буду.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Отдай ее мне?",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "Я тебя очень прошу.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Не смотри на меня так.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "На, забирай.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "А как же суп?",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "Курица, замаринованная в рыбе.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Они никогда не догадаются.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "То есть вместо нее умрет курица?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "А то сейчас заберу.",
      "gap": 0.55
    },
    {
      "v": "fedya",
      "t": "Так, иди.",
      "gap": 0.9
    },
    {
