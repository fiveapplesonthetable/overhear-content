   "t": "Привет, Макс.",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Что тебе надо?",
   "gap": 0.5
  },
  {
   "v": "kostya",
   "t": "Макс, возвращайся.",
   "gap": 0.5
  },
  {
   "v": "kostya",
   "t": "Нам тебя не хватает.",
   "gap": 0.5
