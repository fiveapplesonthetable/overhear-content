  {
   "v": "kostya",
   "t": "Мы поделим квартиру на троих.",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Я постараюсь приехать.",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Kostya has asked Max to come back, and Max says he'll try. That's the end of the flat-swapping for now. Talk soon.",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Пока!",
   "gap": 0.3
