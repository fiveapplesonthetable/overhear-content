  {
   "v": "narrator",
   "t": "It's morning in Lyova's flat, and Barinov has made breakfast for everyone. Lyova suspects it's his way of apologising. Listen in Russian first.",
   "gap": 0.8
  },
  {
   "v": "mama",
   "t": "Доброе утро, Лёва.",
   "gap": 0.55
  },
  {
   "v": "lyova",
   "t": "Доброе утро.",
   "gap": 0.55
  },
  {
   "v": "mama",
   "t": "Виктор приготовил такой омлет.",
   "gap": 0.55
  },
  {
