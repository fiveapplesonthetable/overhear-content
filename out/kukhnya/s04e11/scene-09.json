  "segments": [
    {
      "v": "narrator",
      "t": "Instead of changing Vika's car tires after work, Max goes out for celebratory drinks with Denis and Kostya, then tiptoes home late at night with a flimsy excuse.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Пацаны, сегодня вечером отдыхаем!",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Нагиев взял меня музыкантом.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Поздравляю тебя, это отлично!",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Только сидим недолго сегодня.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Здравствуй, любимая моя жена.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Ты вообще на часы смотрел?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "А у меня же нет часов.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Викуля, ну прости меня, пожалуйста.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Ладно, тихо заходи в дом.",
      "gap": 0.55
    },
    {
