  "segments": [
    {
      "v": "narrator",
      "t": "Out in the courtyard between the two restaurants, Vika spots Chef Barinov and German standing side by side and hopes for a truce — right before both chefs trade new sabotage accusations.",
      "gap": 0.8
    },
    {
      "v": "vika",
      "t": "О, вы стоите рядом и не дерётесь.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Неужели решили заключить перемирие?",
      "gap": 0.55
    },
    {
      "v": "german",
      "t": "Он лишил весь ресторан электричества!",
      "gap": 0.55
    },
    {
      "v": "german",
      "t": "Разве это акт перемирия?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Витя, ты вообще в своём уме?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Да вы ничего не докажете!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Что там случилось на кухне?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "У вас на кухне живая змея!",
      "gap": 0.55
    },
    {
      "v": "german",
      "t": "Вот так, око за око.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Ну, вы у меня ещё попляшете!",
