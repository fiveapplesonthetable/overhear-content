      "t": "Мне тебя и так очень...",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I already love you so much as it is...'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Костян, спасай меня!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Kostyan, save me right now!'",
      "gap": 0.45
    },
    {
