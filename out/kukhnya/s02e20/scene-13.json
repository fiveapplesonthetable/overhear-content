      "t": "Я ж тебя предупреждал!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I warned you not to come in here!'",
      "gap": 0.45
    },
    {
      "v": "barinov",
      "t": "Настя, подожди, потом поговорим.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Nastya, wait, we will talk about it later.'",
