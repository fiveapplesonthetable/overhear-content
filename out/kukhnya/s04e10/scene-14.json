  "segments": [
    {
      "v": "narrator",
      "t": "Out by the van, Timur defends his zombie-bitten nephew on grounds of family honor, and when a groaning Chef Barinov stumbles out, Louis mistakes his hangover for the zombie virus.",
      "gap": 0.8
    },
    {
      "v": "timur",
      "t": "Ты чего, это же мой племянник!",
      "gap": 0.55
    },
    {
      "v": "louis",
      "t": "Если он укусит, вы станете зомби!",
      "gap": 0.55
    },
    {
      "v": "timur",
      "t": "У нас укусить старшего — это позор.",
      "gap": 0.55
    },
    {
      "v": "louis",
      "t": "Тогда мы с вами никуда не поедем.",
      "gap": 0.55
    },
