  "segments": [
    {
      "v": "narrator",
      "t": "Inside Senya's action-movie fantasy, Dmitry Nagiyev bursts into the dining room as a slick gang boss taking the restaurant hostage, only to discover one heroic cook is missing.",
      "gap": 0.8
    },
    {
      "v": "nagiyev",
      "t": "Добрый день, господа и дамы.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Я позволю себе поправить вас.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Мы не террористы, мы бизнесмены.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "А сейчас прошу всех в зал.",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Ты слышала про стокгольмский синдром?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Жертвы испытывают симпатию к захватчикам.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Извините, пожалуйста, можно вопрос?",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Можно бармена ко мне привязать?",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "По списку не хватает повара.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Его зовут Арсений Чуганин.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Где этот опасный повар?",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Он сегодня на кухне.",
      "gap": 0.9
