  "segments": [
    {
      "v": "narrator",
      "t": "Just as the villain aims a pistol at Senya's back, Chef Barinov steps in with a tray of roast beef to stop the bullets and finishes the fight by dropping the chandelier.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Братан, ты просто лучший.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Вы слишком рано радуетесь!",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Сейчас поварёнок получит своё.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "А говядина сегодня жестковата.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Люблю оливки с косточкой.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "И это всё, на что ты способен?",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Виктория Сергеевна, я же вам говорил.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Эту люстру давно стоит заменить.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Я слишком молод для всего этого.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Слишком молод для такой ерунды.",
      "gap": 0.55
    },
    {
      "v": "senya",
      "t": "Мы победили всех врагов!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Отличная работа, сержант Сеня!",
