   "gap": 0.25
  },
  {
   "v": "max",
   "t": "помните",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " is \"do you remember\", formal, and ",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "меня",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " is \"me\" as the object.",
   "gap": 0.4
  },
  {
   "v": "nagiyev",
   "t": "Конечно же, я вас совсем не помню.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Of course, I do not remember you at all.' ",
   "gap": 0.25
  },
  {
   "v": "nagiyev",
   "t": "Конечно же",
   "gap": 0.25
  },
  {
