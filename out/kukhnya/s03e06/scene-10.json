  "segments": [
    {
      "v": "narrator",
      "t": "Since Max was punished with a waiter shift, he has to serve Nagiyev and Kristina's table. Nagiyev fires him on the spot, and Kristina immediately hires him back.",
      "gap": 0.8
    },
    {
      "v": "nagiyev",
      "t": "Что скажешь, моя бывшая дорогая?",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Предлагаю нам мирно разойтись.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Здравствуйте, чего-нибудь сейчас желаете?",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Желаем тебя больше здесь не видеть никогда.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Максим, ты уволен, иди домой.",
      "gap": 0.55
    },
    {
      "v": "kristina",
      "t": "Не хочу тебя расстраивать, но Максим не уволен.",
      "gap": 0.55
    },
    {
      "v": "kristina",
      "t": "Ну тогда я беру его обратно.",
      "gap": 0.55
    },
    {
      "v": "kristina",
      "t": "Максим, поздравляю, ты снова принят.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Не торопись так рано улыбаться.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Два месяца будешь работать бесплатно.",
      "gap": 0.55
    },
    {
      "v": "kristina",
      "t": "Ещё одно такое грубое оскорбление.",
      "gap": 0.55
    },
    {
