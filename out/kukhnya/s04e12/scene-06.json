  "segments": [
    {
      "v": "narrator",
      "t": "After gutting the free sample fish from Timur, Lyova walks into Chef Barinov's office holding a glittering gemstone that sparks a wild diamond-smuggling theory.",
      "gap": 0.8
    },
    {
      "v": "lyova",
      "t": "Шеф, посмотрите, а что это?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Спокойно, Лёва, кажется, это то.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Ты помнишь, откуда у нас рыба?",
      "gap": 0.55
    },
    {
      "v": "lyova",
      "t": "Рыба у нас из Якутии.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "А в Якутии у нас что?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Правильно, там добывают настоящие алмазы!",
      "gap": 0.55
    },
    {
      "v": "lyova",
      "t": "Шеф, неужели это контрабанда?",
      "gap": 0.55
    },
    {
      "v": "lyova",
      "t": "Может, нам в полицию позвонить?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Алло, Тимур, это Виктор Петрович!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Помнишь, я утром рыбу брал?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "У тебя ещё осталась эта рыба?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Привози сюда вообще всю рыбу!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Да, мне рыба очень понравилась!",
