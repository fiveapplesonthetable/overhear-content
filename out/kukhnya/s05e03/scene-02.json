  "title": "Встреча Баринова и Элеоноры  (Barinov and Eleonora's Reunion)",
  "level": "A1 — Duolingo Section 2",
  "labels": {
    "barinov": "Шеф",
    "eleonora": "Элеонора",
    "katya": "Катя"
