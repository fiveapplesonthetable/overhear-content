  "pair": "ru-en",
  "title": "Гнев шефа  (The Chef's Anger)",
  "level": "A1 — Duolingo Section 2",
  "voices": {
    "narrator": "sky",
    "anya": "alisa",
    "anja": "anja",
    "angelina": "angelina"
