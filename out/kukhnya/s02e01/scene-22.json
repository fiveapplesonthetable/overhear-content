  "segments": [
    {
      "v": "narrator",
      "t": "Max confidently walks into the restaurant's main dining area during his shift. He immediately spots Vika talking with their new strict boss near the bar. Max completely fails to understand the gravity of the situation and speaks out loud without thinking.",
      "gap": 0.8
    },
    {
      "v": "anya",
      "t": "Привет, Вика.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Макс, иди отсюда.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Почему ты такая злая?",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "У нас всё отлично.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Вик,",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Походу, сработал твой план.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Замолчи, пожалуйста.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Ты всё испортил.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Я не понимаю.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Что я сделал не так?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Это наш новый хозяин.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Ой, извините меня.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Я пойду на кухню.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Let us break down this interaction.",
      "gap": 0.4
