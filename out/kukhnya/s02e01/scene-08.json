  "segments": [
    {
      "v": "narrator",
      "t": "Outside the restaurant, Max chains himself in a foolish attempt to prove his devotion and force Victoria to talk. Instead of being moved, Victoria calls him a complete fool and walks away, leaving him stuck alone.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Видишь, теперь я никуда не уйду.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Макс, что это у тебя на руке?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я сделал это только ради тебя!",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Ну ты просто полный дурак!",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Зато теперь у нас есть время.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "У меня нет времени на твои глупости.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Подожди, не уходи от меня!",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Сиди здесь один со своими идеями.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Ты куда идёшь, Вика?",
