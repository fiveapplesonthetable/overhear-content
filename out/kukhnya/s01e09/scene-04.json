   "gap": 0.55
  },
  {
   "v": "alisa",
   "t": "Она говорит, слава богу, не похожа!",
   "gap": 0.55
  },
  {
   "v": "barinov",
   "t": "Это она так шутит.",
   "gap": 0.55
  },
  {
