   "gap": 0.5
  },
  {
   "v": "alisa",
   "t": "Давай в прятки!",
   "gap": 0.5
  },
  {
   "v": "lyova",
   "t": "А кто будет прятаться?",
   "gap": 0.5
  },
  {
