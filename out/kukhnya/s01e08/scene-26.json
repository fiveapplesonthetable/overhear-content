      "v": "ainura",
      "t": "Ой, шеф, я же на работе!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Oh, Chef, I am at work after all!' Ainura rejects the offer, reminding him she is on shift.",
      "gap": 0.4
    },
