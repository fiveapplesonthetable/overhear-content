      "gap": 0.5
    },
    {
      "v": "barinov",
      "t": "Сколько тебе надо будет мяса продать, чтобы рассчитаться?",
      "gap": 0.5
    },
    {
      "v": "barinov",
      "t": "Целые фуры мяса!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Flush with victory at the poker table, Barinov has no idea that the meat king will take his joke about truckloads of meat literally. Until next time!",
      "gap": 0.5
    },
    {
      "v": "barinov",
      "t": "До встречи!",
      "gap": 0.3
    }
