  {
   "v": "max",
   "t": "Вы такого никогда не пробовали.",
   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "Главное, чтобы было вкусно.",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Это не то обычное месиво.",
   "gap": 0.5
  },
  {
   "v": "senya",
   "t": "Ладно, неси скорее на стол!",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Сейчас я вас всех удивлю!",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Max promises an unforgettable lunch, and the cooks aren't sure whether to be pleased or worried. Notice \"pal'chiki oblizhete\", the Russian for \"finger-licking\".",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Пока!",
   "gap": 0.3
  }
 ],
