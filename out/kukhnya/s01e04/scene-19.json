   "t": "на стол!",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", literally 'onto the table', uses the little word for a surface.",
   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Сейчас я вас всех удивлю!",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Now I will surprise you all!' ",
