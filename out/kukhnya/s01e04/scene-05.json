  "segments": [
    {
      "v": "narrator",
      "t": "The chef is fed up with Max's naps, but Max is fed up with peeling bananas. Barinov gives him his first real job: cooking staff lunch, with a warning about what happens if they don't like it. Here's the Russian first.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Здесь не ночлежка, а работа!",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Шеф, вы всё равно не даёте мне готовить.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я уже отклеил все этикетки от бананов.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Хорошо, хочешь готовить — будешь готовить!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Внимание, повара ресторана!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Сегодня обед для персонала готовит наш огузок.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Это очень ответственное задание.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Если им не понравится, они съедят тебя.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Ты меня понял?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Да, шеф, я всё понял.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я так мечтал готовить на кухне.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Ну что, ты доволен?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я очень рад, шеф, только выпью кофе.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Быстро переодевайся, работаем!",
      "gap": 0.9
    },
