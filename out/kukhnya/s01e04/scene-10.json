    {
      "v": "barinov",
      "t": "Ты ходил в соседний ресторан?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Did you go to the neighboring restaurant?'",
      "gap": 0.45
    },
    {
      "v": "fedya",
      "t": "Нет, я никуда не ходил.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'No, I did not go anywhere.'",
      "gap": 0.45
    },
