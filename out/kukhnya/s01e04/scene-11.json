      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Watching her from afar again?'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Она кажется такой недоступной сегодня.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'She seems so unapproachable today.'",
      "gap": 0.45
