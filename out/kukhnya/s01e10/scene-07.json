  },
  {
   "v": "max",
   "t": "извини",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " 'Oh, Kostya is calling, sorry!' The action word means \"rings\" or \"calls\", the phone word. The third word marks the casual \"sorry\" the boy used in the first scene. Max waves his phone as he says it.",
   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Алло, Костя, говори громче!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Алло",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "Костя",
