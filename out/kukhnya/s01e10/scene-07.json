   "t": "говори",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "громче",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " 'Hello, Kostya, speak louder!' The first word is the phone hello. Here, 'louder' shows is the comparative form of Here, 'loudly' shows. Max shouts into a phone that has not rung, and Vika is watching.",
   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Плохо слышно, я сейчас подойду!",
   "gap": 0.55
  },
