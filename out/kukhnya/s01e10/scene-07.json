 "segments": [
  {
   "v": "narrator",
   "t": "Vika has heard that Max is avoiding her, and she corners him in the restaurant. Max does what any brave man would do: he pretends to take a phone call. Over to the Russian.",
   "gap": 0.8
  },
  {
   "v": "vika",
   "t": "Макс, нам надо серьёзно поговорить!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Привет, Вика! Рад тебя видеть.",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Ой, Костя звонит, извини!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Алло, Костя, говори громче!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Плохо слышно, я сейчас подойду!",
   "gap": 0.55
  },
  {
   "v": "vika",
   "t": "Макс, подожди, не уходи!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Вика, это очень срочное дело!",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Костя, а ты чего звонил?",
   "gap": 0.55
  },
  {
   "v": "kostya",
   "t": "В смысле, я тебе не звонил.",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Сделай вид, что нужна помощь!",
   "gap": 0.55
  },
  {
   "v": "kostya",
   "t": "А, ты прячешься от Вики?",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Да, подыграй мне, пожалуйста!",
   "gap": 0.55
  },
  {
   "v": "kostya",
   "t": "Ну давай, пошли на склад.",
   "gap": 0.55
  },
  {
   "v": "max",
   "t": "Спасибо, друг, ты меня спас!",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Right, back to the start, one line at a time.",
