    },
    {
      "v": "vika",
      "t": "Виктор Петрович, я совсем забыла.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Viktor Petrovich, I completely forgot.'",
      "gap": 0.45
    },
    {
      "v": "vika",
      "t": "Вот наличные деньги на свежую икру.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Here is the cash for fresh caviar.'",
      "gap": 0.45
