    {
      "v": "barinov",
      "t": "Огромное спасибо, моя дорогая Вика.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Thank you very much, my dear Vika.'",
      "gap": 0.45
    },
    {
      "v": "barinov",
      "t": "Ты спасаешь наш вечерний банкет.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'You are saving our evening banquet.'",
      "gap": 0.45
