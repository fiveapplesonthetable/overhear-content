  "segments": [
    {
      "v": "narrator",
      "t": "When Vika smells alcohol behind the bar and asks Kostya if he broke a bottle, Kostya turns to Max to back up his alibi. Refusing to break his promise of honesty, Max tells Vika the truth, which finally convinces her to let him help with the crib.",
      "gap": 0.8
    },
    {
      "v": "vika",
      "t": "Ты что-то разбил?",
      "gap": 0.55
    },
    {
      "v": "kostya",
      "t": "Я? Нет, я ничего не разбивал.",
      "gap": 0.55
    },
