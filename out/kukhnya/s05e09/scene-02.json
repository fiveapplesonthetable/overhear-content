    {
      "v": "narrator",
      "t": "That brings this kitchen announcement to a close. Notice how Max uses the present tense to declare he is quitting lying right now, and how Lyova snaps everyone back to work. See you in the next scene.",
      "gap": 0.5
    },
    {
      "v": "anya",
      "t": "Говорю только правду!",
      "gap": 0.3
    }
