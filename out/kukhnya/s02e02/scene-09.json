      "v": "narrator",
      "t": "Kostya and Max are getting ready to distribute food to the homeless. A colleague makes a snarky comment. Let's listen closely to their exchange in Russian first, and then walk through each line together.",
      "gap": 0.8
    },
    {
      "v": "anton",
      "t": "Все, я готов.",
      "gap": 0.55
    },
    {
      "v": "anton",
      "t": "Пойдем.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Все, давайте.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Привет бомжам.",
      "gap": 0.55
    },
    {
      "v": "anton",
      "t": "Не бомжам, а бездомным.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Смотрите.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Заразу не принесите в дом.",
      "gap": 0.55
    },
    {
      "v": "anton",
      "t": "От кого?",
      "gap": 0.55
    },
