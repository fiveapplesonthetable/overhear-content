      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "Я без машины.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "А вас вроде в гардероб позовут.",
      "gap": 0.55
    },
    {
      "v": "inspector",
      "t": "Что происходит?",
      "gap": 0.55
