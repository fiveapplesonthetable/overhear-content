      "t": "Now let's break down each line of their conversation.",
      "gap": 0.4
    },
    {
      "v": "vika",
      "t": "Это наш шеф-повар Виктор Петрович.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'This is our head chef, Viktor Petrovich.'",
      "gap": 0.45
