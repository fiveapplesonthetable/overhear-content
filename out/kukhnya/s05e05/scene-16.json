  "segments": [
    {
      "v": "narrator",
      "t": "When Elena steps back into the dining room to pick up her purse, the guest whom Barinov warned earlier leaps into action, seizing Elena's bag and shouting for hotel security to arrest the supposed thief.",
      "gap": 0.8
    },
    {
      "v": "gost",
      "t": "Стойте, отдайте сумку!",
      "gap": 0.55
    },
    {
