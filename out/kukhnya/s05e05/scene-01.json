    {
      "v": "max",
      "t": "Не важно, кто мне это сказал.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'It does not matter who told me this.'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Главное, что я здесь.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'The main thing is that I am here.'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Я готов быть отцом этого ребёнка.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I am ready to be the father of this child.'",
      "gap": 0.45
    },
    {
      "v": "vika",
      "t": "Как благородно.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'How noble.'",
      "gap": 0.45
    },
    {
      "v": "vika",
      "t": "Расслабься.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Relax.'",
      "gap": 0.45
    },
    {
      "v": "vika",
      "t": "Это не твой ребёнок.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'This is not your child.'",
      "gap": 0.65
