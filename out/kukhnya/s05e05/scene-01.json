      "t": "'The rookie has returned!'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Вика, подожди!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Vika, wait!'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Нам нужно поговорить!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'We need to talk!'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Я знаю, что ты беременная!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I know that you are pregnant!'",
      "gap": 0.45
    },
    {
      "v": "vika",
      "t": "Кто тебе сказал?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Who told you?'",
      "gap": 0.45
