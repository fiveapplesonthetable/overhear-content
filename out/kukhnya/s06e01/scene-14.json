      "v": "narrator",
      "t": "At the wedding banquet, Chef Barinov pulls Eleonora and Nagiyev aside to complain that Eleonora's mother has been harassing him in the kitchen all day—only to hear a chilling truth.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Сочувствую, Дима.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Поздравляю, Элеонора.",
      "gap": 0.55
    },
