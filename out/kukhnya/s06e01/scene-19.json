  "segments": [
    {
      "v": "narrator",
      "t": "Troubled by his hallucinations of his late mother-in-law, Chef Barinov visits his doctor friend, who examines his test results and delivers a grim warning about his heart.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Ладно тебе, я даже болезней таких не знаю.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "У тебя очень слабый организм.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "И сердце слабое.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "Инсульт даром не проходит.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "И галлюцинации просто так не появляются.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "И сколько мне осталось?",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "Может пять лет, а может и год.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "Тебе надо бросить работу.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Бросить совсем?",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "Готовь спокойно у себя дома на кухне.",
      "gap": 0.55
    },
    {
      "v": "doctor",
      "t": "Но никаких стрессов на работе.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Я тебя услышал.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "barinov",
      "t": "Ладно тебе, я даже болезней таких не знаю.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Come on, I do not even know such illnesses.'",
      "gap": 0.45
    },
    {
      "v": "doctor",
      "t": "У тебя очень слабый организм.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Your body is very weak.'",
      "gap": 0.45
    },
    {
      "v": "doctor",
      "t": "И сердце слабое.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'And your heart is weak.'",
      "gap": 0.45
    },
    {
      "v": "doctor",
      "t": "Инсульт даром не проходит.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'A stroke does not pass without consequences.'",
      "gap": 0.45
