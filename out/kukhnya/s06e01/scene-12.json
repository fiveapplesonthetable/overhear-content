  "segments": [
    {
      "v": "narrator",
      "t": "Dressed in her bridal gown, Eleonora receives a heartfelt apology from Katya before Dmitry Nagiyev hurries in wearing his tailcoat so they do not miss their appointment at the registry office.",
      "gap": 0.8
    },
    {
      "v": "eleonora",
      "t": "Никита, давай завтра.",
      "gap": 0.55
    },
    {
      "v": "katya",
      "t": "Мама, ты роскошно выглядишь.",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "Все, шучу, шучу.",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "Я говорила, что я здесь ни при чем.",
      "gap": 0.55
    },
    {
      "v": "katya",
      "t": "Извини, я была неправа.",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "А где мой суженый?",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "Мы ведь в ЗАГС так можем опоздать.",
      "gap": 0.55
    },
    {
      "v": "eleonora",
      "t": "Я уж думала, что ты от меня сбежал.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
      "t": "Хорошо бы, шучу.",
      "gap": 0.55
    },
    {
      "v": "nagiyev",
