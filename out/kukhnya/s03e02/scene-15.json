    {
      "v": "narrator",
      "t": "At the end of the shift, Vika reads out each waiter's tip total: Ilya edges out Max by fifty rubles, but to everyone's surprise, Nastya wins the entire pool.",
      "gap": 0.8
    },
    {
      "v": "anya",
      "t": "Да не важно. Поехали домой.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Поехали.",
      "gap": 0.55
    },
    {
