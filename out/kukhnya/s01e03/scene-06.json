   "v": "max",
   "t": "ему",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ".",
   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Мне же теперь полный конец.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'I am completely finished now.' Literally, this translates to 'to me, you know, now a full end'. This is how people say 'I am done for' using the word for 'end', which is ",
   "gap": 0.25
  },
  {
