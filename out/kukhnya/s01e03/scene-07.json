      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "The judge is not about to give back his licence, and Barinov slinks back to the kitchen. Take that last phrase with you: it's how Russians say \"count yourself lucky\".",
      "gap": 0.5
    },
    {
      "v": "judge",
      "t": "Пока!",
      "gap": 0.3
