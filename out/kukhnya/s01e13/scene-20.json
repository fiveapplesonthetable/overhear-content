   "t": "Сейчас скажем.",
   "gap": 0.55
  },
  {
   "v": "nagiev",
   "t": "Александр Дель Пьеро.",
   "gap": 0.55
  },
  {
   "v": "anya",
   "t": "Сказал, что выставка отменяется.",
   "gap": 0.55
  },
  {
   "v": "nagiev",
   "t": "С московского телефона звонят?",
   "gap": 0.55
  },
  {
   "v": "nagiev",
   "t": "Да, вот номер.",
   "gap": 0.55
  },
  {
   "v": "nagiev",
   "t": "Набирайте.",
   "gap": 0.55
  },
  {
