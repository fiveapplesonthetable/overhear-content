  },
  {
   "v": "vika",
   "t": "себе",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " is 'in yourself'.",
   "gap": 0.4
  },
  {
   "v": "max",
   "t": "Меня всегда удивляло...",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'I have always wondered...' Let's look at this part: ",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "Меня",
   "gap": 0.25
  },
  {
   "v": "max",
