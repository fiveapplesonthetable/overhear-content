  {
   "v": "max",
   "t": "Разреши мне объяснить, в чём дело.",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Ты весь день от меня бегаешь!",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Мне надо подумать.",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Поговорим через три дня, когда прилечу.",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Вика, доброе утро!",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Я тебе кофе принёс.",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Я тебя ненавижу!",
   "gap": 0.5
  },
  {
   "v": "max",
   "t": "Ты не любишь кофе?",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Да какой к чёрту кофе!",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Я из-за тебя не полетела в Милан!",
   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Vika blames Max for the missed trip, and the coffee doesn't help. Next scene, someone else's problems.",
