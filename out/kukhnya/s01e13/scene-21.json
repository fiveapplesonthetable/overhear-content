   "v": "narrator",
   "t": " after ",
   "gap": 0.25
  },
  {
   "v": "elena",
   "t": "нет",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ". That negating word stands for 'there is not'.",
   "gap": 0.4
  },
  {
   "v": "elena",
   "t": "и фара разбита.",
   "gap": 0.55
  },
  {
