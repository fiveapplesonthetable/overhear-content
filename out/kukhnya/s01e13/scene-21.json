  },
  {
   "v": "narrator",
   "t": "'Well, the bumper is gone and the headlight is smashed.' -- Elena inspects her ruined vehicle.",
   "gap": 0.4
  },
  {
   "v": "elena",
   "t": "и фара разбита.",
