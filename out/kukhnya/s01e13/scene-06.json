   "t": "Быстро берите все сети!",
   "gap": 0.55
  },
  {
   "v": "barinov",
   "t": "Берите большие и маленькие.",
   "gap": 0.55
  },
  {
   "v": "barinov",
   "t": "Берите всё, что у нас есть.",
   "gap": 0.55
  },
  {
