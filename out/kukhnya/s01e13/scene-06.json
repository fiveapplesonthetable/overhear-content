   "t": "Один спрятался под столом.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'One hid under the table.' The creature hid itself, so ",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "спрятался",
   "gap": 0.25
  },
  {
   "v": "narrator",
