   "t": "есть",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " means 'at us there is', spoken shorthand for 'we have'. ",
   "gap": 0.25
  },
  {
   "v": "barinov",
   "t": "всё",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", ",
