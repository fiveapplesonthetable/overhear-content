  "segments": [
    {
      "v": "narrator",
      "t": "Max is in the stockroom on his punishment shift when he drops a box, and something escapes. The chef comes running in and shouts for nets. First, the Russian.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Блин, блин, блин, блин.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я уронил коробку на пол.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Они очень быстро бегают.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Что ты опять натворил, Макс?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Я просто хотел взять продукты.",
      "gap": 0.55
    },
