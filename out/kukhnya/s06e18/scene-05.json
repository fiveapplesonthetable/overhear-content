    {
      "v": "narrator",
      "t": "Senya thinks he has pulled off a brilliant campaign move, while outside in the courtyard a buyer arrives to look at Mikhail's pony. See you in the next scene.",
      "gap": 0.5
    },
    {
      "v": "anya",
      "t": "На, держи и работай!",
      "gap": 0.3
    }
