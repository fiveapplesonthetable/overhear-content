  "segments": [
    {
      "v": "narrator",
      "t": "Right after thanking the team and ordering everyone back to work, Senya doubles over from food poisoning. Fedya realizes Timur rigged the vote, a food fight erupts, and Eleonora catches Mikhail with the pony that bit her investor.",
      "gap": 0.8
    },
