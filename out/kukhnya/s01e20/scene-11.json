    {
      "v": "vika",
      "t": "Все хотят видеть вас.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Everyone wants to see you.' Vika chimes in to confirm his sudden burst of popularity.",
      "gap": 0.4
    },
    {
      "v": "barinov",
      "t": "У нас много гостей?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Do we have many guests?' Barinov checks if this internet fame translates to actual restaurant customers.",
      "gap": 0.4
    },
    {
      "v": "vika",
      "t": "Да, все столики заняты.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Yes, all tables are taken.' Vika confirms the dining room is completely packed.",
