    {
      "v": "barinov",
      "t": "Спасибо, я пойду работать.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Thank you, I will go work.' Barinov politely excuses himself to return to his duties.",
      "gap": 0.4
