  "segments": [
    {
      "v": "narrator",
      "t": "The restaurant owner calls the Chef to his table and tells him that he is now very famous. They talk about the video on the internet, which has many views. The Chef is very surprised by this news.",
      "gap": 0.8
    },
    {
      "v": "nagiyev",
      "t": "Посмотри на это видео.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Я не понимаю. Я уволен?",
      "gap": 0.55
    },
