      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Barinov learns to his shock that Claude Monet was sold behind his back, dismissed with the borrowed English phrase 'nothing personal, just business'. See you next time!",
      "gap": 0.5
    },
    {
      "v": "nagiyev",
      "t": "Удачи!",
      "gap": 0.3
