  "segments": [
    {
      "v": "narrator",
      "t": "When Max brings Katya's steaming, dramatic molecular dishes into the dining room, the guests at the neighboring tables are so impressed that everyone wants to order them.",
      "gap": 0.8
    },
    {
      "v": "anya",
      "t": "Итак, ваш заказ.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "А это что?",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Честно говоря, ерунда.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "А вы попробуйте. Это очень вкусно.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Высокая кухня от повара из Парижа.",
      "gap": 0.55
    },
    {
