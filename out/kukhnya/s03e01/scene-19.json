    {
      "v": "vika",
      "t": "Да, добрый вечер.",
      "gap": 0.55
    },
    {
      "v": "lyova",
      "t": "Поднимайтесь на борт. Ну, как вам?",
      "gap": 0.55
    },
    {
      "v": "vika",
