      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'How did the family reunion go?'",
      "gap": 0.45
    },
    {
      "v": "barinov",
      "t": "Знаю я всё, знаю.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I know everything, I know.'",
      "gap": 0.45
    },
    {
