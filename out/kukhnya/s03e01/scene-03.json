  "segments": [
    {
      "v": "narrator",
      "t": "In the dining room near the bar, art director Vika Goncharova hands Max a hefty fine for his mistake, and when he tries to ask her out after work, she raises the penalty even higher.",
      "gap": 0.8
    },
    {
      "v": "vika",
      "t": "Лавров, штраф три тысячи.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Три тысячи?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Так, давай убирай.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Мы с тобой в кафешку сходим?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "То, что я взяла тебя, ничего не значит.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "У нас деловые отношения.",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Понятно?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Понятно. Но после смены сходим?",
      "gap": 0.55
    },
    {
      "v": "vika",
      "t": "Штраф пять тысяч.",
      "gap": 0.55
    },
    {
      "v": "nastya",
      "t": "Кажется, пинается.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "У него сейчас рост восемь сантиметров.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Как он может пинаться?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go back through their conversation line by line and unpack the Russian phrasing.",
      "gap": 0.4
    },
    {
      "v": "vika",
      "t": "Лавров, штраф три тысячи.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Lavrov, a fine of three thousand.'",
