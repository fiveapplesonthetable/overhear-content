      "t": "Я мама Лёвы, Вера Ивановна.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I am Lyova's mother, Vera Ivanovna.'",
      "gap": 0.45
    },
    {
      "v": "lyova",
      "t": "Очень приятно познакомиться.",
      "gap": 0.55
    },
    {
