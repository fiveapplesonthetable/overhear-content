  "pair": "ru-en",
  "title": "Ночные пирожные на кухне  (Late-Night Pastries in the Kitchen)",
  "level": "A1 — Duolingo Section 2",
  "voices": {
    "narrator": "sky",
    "anya": "alisa",
    "gulya": "anja",
    "lyova": "angelina"
  },
