   "t": "ко",
   "gap": 0.25
  },
  {
   "v": "lyova",
   "t": "мне",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " has an extra 'o' to make it easier to say.",
   "gap": 0.4
  },
  {
   "v": "guest",
   "t": "Вот моя претензия, держи.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Here is my complaint, take it.' We will analyze the sentence: ",
