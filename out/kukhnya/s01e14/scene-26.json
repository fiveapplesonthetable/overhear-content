  "segments": [
    {
      "v": "narrator",
      "t": "The evening is over, and Max has some thoughts about responsibility. Barinov's conclusion is much more practical.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Ответственность — странная штука.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "С одной стороны, мы её боимся.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "А с другой стороны...",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Именно благодаря ей завоёвываем уважение.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "И становимся ближе друг к другу.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Совершая безответственные поступки...",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Мы делаем правильные выводы.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Всё, на работе больше не пью.",
