   "gap": 0.9
  },
  {
   "v": "narrator",
   "t": "Vika gives Max a nickname, and the night ends warmly at the bar. One more talk is waiting in the office. Until next time.",
   "gap": 0.5
  },
  {
   "v": "vika",
   "t": "Пока!",
   "gap": 0.3
