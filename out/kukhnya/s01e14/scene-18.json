   "t": "Терминатор готов готовить еду.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'The terminator is ready to cook food.' Now we can focus on the phrase: ",
   "gap": 0.25
  },
  {
   "v": "fedya",
   "t": "готов",
   "gap": 0.25
  },
