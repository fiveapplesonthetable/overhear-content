      "v": "barinov",
      "t": "Берем вторую миску.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "И трясем.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Чеснок очищен.",
