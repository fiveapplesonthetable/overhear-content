    },
    {
      "v": "timur",
      "t": "Да, все в порядке.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Yes, everything is in order.'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Как говорил наш капитан, кто не врет.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'As our captain used to say, whoever does not lie.'",
      "gap": 0.45
    },
    {
      "v": "timur",
      "t": "Молодец, Агузок.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Good job, Oguzok.'",
