  "segments": [
    {
      "v": "narrator",
      "t": "Thinking on his feet to salvage the situation, Chef Barinov claims he was purposely holding back his congratulations until tonight so he would not spoil his big birthday surprise. Though skeptical, Elena agrees to wait and see what he has prepared for the evening.",
      "gap": 0.8
    },
    {
      "v": "elena",
      "t": "Витя, это фиаско!",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Держусь, тебя не поздравляю.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "А ты не можешь потерпеть до вечера!",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "То есть ты подготовил мне сюрприз?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Вот именно, сюрприз!",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "Просто я не верю.",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "Обычно у тебя сюрпризы случаются сами собой.",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "Потом ты просто просишь за них прощения.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Вот увидим вечером!",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "Спасибо большое, очень приятно.",
      "gap": 0.55
    },
    {
      "v": "elena",
      "t": "Я позвоню и отметим.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "До вечера, любимая!",
      "gap": 0.9
