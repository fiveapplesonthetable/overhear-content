  "segments": [
    {
      "v": "narrator",
      "t": "Max has been trying to copy Barinov's famous pâté, and he thinks he has done it. He goes to the chef to announce it, and Barinov listens with growing disbelief.",
      "gap": 0.8
    },
    {
      "v": "max",
      "t": "Шеф, я сделал это.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Что сделал?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Ваш паштет.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Мой паштет?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Получилось один в один.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Даже чуть-чуть лучше.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Да ладно?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Да.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Не может быть.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Попробуйте сами.",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Ну, посмотрим.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "max",
      "t": "Шеф, я сделал это.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Chef, I did it.'",
      "gap": 0.45
    },
    {
      "v": "barinov",
      "t": "Что сделал?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Did what?'",
      "gap": 0.45
