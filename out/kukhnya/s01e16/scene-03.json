      "t": "Вы куда смотрите?",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "В моём дворе мигранты.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Из ресторана Аркабалена.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Они режут живого барана.",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "А вы там спите?",
      "gap": 0.55
    },
    {
      "v": "anya",
      "t": "Приезжайте быстро.",
      "gap": 0.55
    },
