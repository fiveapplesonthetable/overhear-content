      "v": "narrator",
      "t": "The Chef tastes the pâté that Maks prepared. Maks is waiting for a compliment. Let's listen closely to their exchange in Russian first, and then walk through each line together.",
      "gap": 0.8
    },
    {
      "v": "barinov",
      "t": "Неплохо.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Да?",
      "gap": 0.55
    },
    {
      "v": "barinov",
      "t": "Только это не мой паштет.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Как?",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "Та же консистенция.",
      "gap": 0.55
    },
    {
      "v": "max",
      "t": "И состав я подобрал.",
      "gap": 0.55
    },
