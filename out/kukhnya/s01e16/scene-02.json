      {
        "line": 0,
        "cue": 10,
        "fragment": "А где огнетушитель?"
      },
      {
        "line": 1,
        "cue": 11,
        "fragment": "Он же висел у вас в прошлый раз."
      },
      {
        "line": 2,
        "cue": 12,
        "fragment": "Вы что, издеваетесь, что ли?"
      },
      {
        "line": 3,
        "cue": 14,
        "fragment": "Не годим."
      },
      {
        "line": 4,
        "cue": 15,
        "fragment": "Браку! Ну вот, нормальный огнетушитель."
      },
      {
        "line": 5,
        "cue": 16,
        "fragment": "А пломба где?"
      },
      {
        "line": 7,
        "cue": 19,
        "fragment": "А можно узнать, чем вызван столь бурный интерес к пожарной безопасности моего"
      },
      {
        "line": 8,
        "cue": 20,
        "fragment": "ресторана? Можно."
      },
      {
        "line": 9,
        "cue": 21,
        "fragment": "Интерес вызван борьбой с халатностью руководства,"
      },
      {
        "line": 10,
        "cue": 22,
        "fragment": "а также с безобразным состоянием пожарной техники и звонком моему"
      },
      {
        "line": 11,
        "cue": 23,
        "fragment": "начальнику из соседнего ресторана."
      },
      {
        "line": 12,
        "cue": 25,
        "fragment": "Понятно."
      },
      {
        "line": 13,
        "cue": 26,
        "fragment": "Ну что, до завтра."
      }
    ]
