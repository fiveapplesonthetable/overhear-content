{
  "id": "kukhnya-s01e16-scene-02",
  "pair": "ru-en",
  "title": "Случайный звонок  (An Accidental Call)",
  "level": "A1 — Duolingo Section 2",
  "voices": {
    "narrator": "sky",
    "anya": "alisa",
    "leva": "anja",
    "guest": "angelina"
