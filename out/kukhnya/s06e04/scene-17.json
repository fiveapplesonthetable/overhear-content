    {
      "v": "narrator",
      "t": "At Lyova's apartment, sweet Gulya finishes washing all the windows, and Vera Ivanovna's nosy friend warns her to watch her money around quiet housekeepers—right before asking to borrow five thousand rubles.",
      "gap": 0.8
    },
    {
      "v": "gulya",
      "t": "Вера Ивановна, я помыла все окна.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Спасибо тебе, Гуля.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Отдохни пока, посиди.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Можешь телевизор посмотреть в комнате.",
      "gap": 0.55
    },
    {
      "v": "gulya",
      "t": "Хорошо, спасибо большое.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Конечно, радуйся, но все-таки будь осторожна.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "У моей подруги тоже была вот такая домработница.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Такая тихая и скромная девушка.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "А в один день вдруг пропали все деньги.",
      "gap": 0.55
    },
    {
      "v": "gulya",
      "t": "Я совсем не такая.",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Вера, ты мне пять тысяч дашь до пенсии?",
      "gap": 0.55
    },
    {
      "v": "guest",
      "t": "Да, сейчас принесу.",
      "gap": 0.9
