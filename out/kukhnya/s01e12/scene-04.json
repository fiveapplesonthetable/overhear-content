   },
   {
    "line": 1,
    "cue": 27,
    "fragment": "О, привет, Ваваренок."
   },
   {
    "line": 2,
    "cue": 28,
    "fragment": "Ай!"
   },
   {
    "line": 3,
    "cue": 29,
    "fragment": "Чего такое?"
   },
   {
    "line": 4,
    "cue": 30,
    "fragment": "Чего-то букует."
   },
   {
    "line": 5,
    "cue": 31,
    "fragment": "С какой стороны?"
   },
   {
    "line": 6,
    "cue": 31,
    "fragment": "Да с правой."
   },
   {
    "line": 7,
    "cue": 32,
