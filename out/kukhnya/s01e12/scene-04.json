    {
      "v": "max",
      "t": "У меня сильно колет в боку.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I have a sharp pain in my side.'",
      "gap": 0.45
    },
    {
      "v": "sasha",
      "t": "С какой именно стороны?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'On which side exactly?'",
      "gap": 0.45
    },
    {
      "v": "max",
      "t": "Вот здесь, с правой стороны.",
      "gap": 0.55
