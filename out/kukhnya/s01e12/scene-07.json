   "v": "barinov",
   "t": "Не надо учить меня дисциплине!",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'Do not teach me discipline!' Let's focus on this line: ",
   "gap": 0.25
  },
  {
   "v": "barinov",
   "t": "Не",
