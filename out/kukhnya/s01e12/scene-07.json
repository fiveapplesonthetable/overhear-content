  },
  {
   "v": "barinov",
   "t": "меня",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", meaning 'me'.",
   "gap": 0.4
  },
  {
   "v": "senya",
   "t": "Мы просто очень стараемся для вас.",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'We are simply trying very hard for you.' The verb ",
