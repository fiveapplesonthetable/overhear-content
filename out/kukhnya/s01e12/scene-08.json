  },
  {
   "v": "max",
   "t": "формат",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "открытой",
   "gap": 0.25
  },
  {
   "v": "max",
   "t": "кухни",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " is phrased smoothly as 'format of open kitchen'.",
   "gap": 0.4
  },
  {
