      "t": "TS1이 어디입니까?",
      "gap": 0.55
    },
    {
      "v": "camera_pd",
      "t": "저 따라오세요.",
      "gap": 0.55
    },
    {
      "v": "yejin",
      "t": "혹시 방금 이것도 찍었어요?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Let's unpack those eight lines one turn at a time.",
