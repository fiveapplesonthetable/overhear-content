      "t": "TS1이 어디입니까?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Where is TS1?'",
      "gap": 0.45
    },
    {
      "v": "camera_pd",
      "t": "저 따라오세요.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Follow me.'",
      "gap": 0.45
