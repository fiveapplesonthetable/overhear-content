    {
      "v": "seungchan",
      "t": "죄송하단 말은 할 수가 없고, 악순환이네요.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "You picked up how to say something upsets you, a warm 'thank you', and the word for a no-win loop. Time for the live broadcast!",
      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "또 만나요!",
      "gap": 0.3
