    {
      "v": "narrator",
      "t": "Now you even get the Korean pun inside The Producers! Congratulations on completing Episode One from first sprint to final candle. Until next time!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "안녕히 계세요!",
      "gap": 0.3
