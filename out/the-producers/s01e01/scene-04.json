      "gap": 0.5
    },
    {
      "v": "taeho",
      "t": "처음부터 안 된다고 선을 그어놓는 게 좋아.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "You picked up the phrase for every morning, two meanings of the word for chart and ticket, and a crisp way to say 'there are none'. Next stop: lunch!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "또 만나요!",
      "gap": 0.3
    }
