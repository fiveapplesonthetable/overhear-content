    {
      "v": "joonmo",
      "t": "반성합니다, 죄송합니다.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "From scheduling a meeting at four to saving someone's appetite at dinner and apologizing for your mistake, you survived the hearing room. Until next time!",
      "gap": 0.5
    },
    {
      "v": "commissioner",
      "t": "안녕히 가세요!",
      "gap": 0.3
