    {
      "v": "writer",
      "t": "이번 녹화 게스트 미쓰에이 어떻게 됐어요?",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "전화하면 바로 돼.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "You learned how to talk about phoning someone, say 'right away', and ask how a plan turned out. Next up: that fateful phone call!",
      "gap": 0.5
    },
    {
      "v": "writer",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
