  "segments": [
    {
      "v": "narrator",
      "t": "Back in the meeting room for his weekend travel show, writer Son Ji-yeon makes excuses for the late head writer, suggests filming on Jeju Island, and asks whether Joon-mo can book girl group Miss A. Listen for the expressions for 'right away' and 'if I make one phone call'.",
      "gap": 0.8
    },
    {
      "v": "writer",
      "t": "방금 통화했는데요, 지금 마포대교 건너고 계신대요.",
      "gap": 0.55
    },
    {
      "v": "writer",
      "t": "금방 오신대요.",
      "gap": 0.55
    },
    {
      "v": "joonmo",
      "t": "다음 주 아이템은 나왔어?",
      "gap": 0.55
    },
    {
      "v": "writer",
      "t": "제주도 한번 가시죠.",
      "gap": 0.55
    },
    {
      "v": "joonmo",
      "t": "지난 시즌 마지막 촬영지가 어디였지?",
      "gap": 0.55
    },
    {
      "v": "writer",
      "t": "제주도요.",
      "gap": 0.55
    },
    {
      "v": "writer",
      "t": "이번 녹화 게스트 미쓰에이 어떻게 됐어요?",
      "gap": 0.55
    },
    {
      "v": "joonmo",
      "t": "전화하면 바로 돼.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "writer",
      "t": "방금 통화했는데요, 지금 마포대교 건너고 계신대요.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I just spoke with her on the phone, she says she's crossing Mapo Bridge now.'",
      "gap": 0.45
    },
    {
      "v": "writer",
      "t": "금방 오신대요.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'She says she'll be right here.'",
      "gap": 0.45
    },
    {
      "v": "joonmo",
      "t": "다음 주 아이템은 나왔어?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Did next week's episode topic come out?'",
      "gap": 0.45
    },
    {
      "v": "writer",
      "t": "제주도 한번 가시죠.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Let's take a trip to Jeju Island.'",
      "gap": 0.45
    },
    {
      "v": "joonmo",
      "t": "지난 시즌 마지막 촬영지가 어디였지?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Where was last season's final filming location?'",
      "gap": 0.45
    },
    {
      "v": "writer",
      "t": "제주도요.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Jeju Island.'",
      "gap": 0.45
    },
    {
      "v": "writer",
      "t": "이번 녹화 게스트 미쓰에이 어떻게 됐어요?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'How did things turn out with Miss A as guests for this shoot?'",
      "gap": 0.45
    },
    {
      "v": "joonmo",
      "t": "전화하면 바로 돼.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'One phone call and it's done right away.'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
      "gap": 0.75
    },
    {
      "v": "writer",
      "t": "방금 통화했는데요, 지금 마포대교 건너고 계신대요.",
      "gap": 0.5
