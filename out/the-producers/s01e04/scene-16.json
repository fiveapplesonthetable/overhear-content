    {
      "v": "manager",
      "t": "보살은 화를 안 내잖아.",
      "gap": 0.5
    },
    {
      "v": "ilyong",
      "t": "이 스프레이로 물 뿌리고 신디가 깨면 까나리카노를 내밀면 돼.",
      "gap": 0.5
    },
    {
      "v": "ilyong",
      "t": "까나리카노를 마시고 뿜는 표정이 웃겨야 되거든.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Plotting a dawn wakeup prank with fish-sauce coffee while the star rehearses a sweet new image sets up pure variety-show chaos. See you soon!",
      "gap": 0.5
    },
    {
      "v": "ilyong",
      "t": "다음에 만나요.",
      "gap": 0.3
    }
