    {
      "v": "seungchan",
      "t": "백승찬입니다.",
      "gap": 0.5
    },
    {
      "v": "actress",
      "t": "그래요, 백승찬 피디. 수고했어요, 오늘.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "You heard Ryu Il-yong check in kindly at the office before Youn Yuh-jung calls about a jar of homemade plum tea she left behind. Until next time.",
      "gap": 0.5
    },
    {
      "v": "actress",
      "t": "다음에 봐요!",
      "gap": 0.3
    }
