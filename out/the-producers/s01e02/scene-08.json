  "segments": [
    {
      "v": "narrator",
      "t": "Chief producer Kim Tae-ho announces the assignments for the new rookies. Although Baek Seung-chan hoped for Entertainment Weekly, he gets placed in a struggling team. Listen to the Korean first, then we'll go through it together.",
      "gap": 0.8
    },
    {
      "v": "taeho",
      "t": "드디어 너희들 업무 배정하는 날이다.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "그 다음은 백승찬이.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "1지망이 연예가중계야?",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "특이하네. 기특해.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "신입이 연예가중계 지망하고, 네가 처음이야.",
      "gap": 0.55
    },
    {
      "v": "seungchan",
      "t": "열심히 하겠습니다.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "그래. 너는 1박 2일.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "그 팀 지금 분위기가 뭐 그렇게 좋진 않을 거야.",
      "gap": 0.55
    },
    {
      "v": "taeho",
      "t": "가서 네가 선배님들 기분 좀 업시켜 드리고.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "taeho",
      "t": "드디어 너희들 업무 배정하는 날이다.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Tae-ho starts with excitement.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "그 다음은 백승찬이.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He calls the next rookie.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "1지망이 연예가중계야?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He reads Seung-chan's application.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "특이하네. 기특해.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He sounds impressed.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "신입이 연예가중계 지망하고, 네가 처음이야.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He praises the rookie's bravery.'",
      "gap": 0.45
    },
    {
      "v": "seungchan",
      "t": "열심히 하겠습니다.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Seung-chan bows proudly.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "그래. 너는 1박 2일.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Tae-ho pulls the rug out.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "그 팀 지금 분위기가 뭐 그렇게 좋진 않을 거야.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He gives a subtle warning.'",
      "gap": 0.45
    },
    {
      "v": "taeho",
      "t": "가서 네가 선배님들 기분 좀 업시켜 드리고.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He gives the rookie an impossible task.'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
