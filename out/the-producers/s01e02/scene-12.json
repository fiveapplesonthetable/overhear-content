      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "You heard Ye-jin press Cindy's manager over where CEO Byun is hiding while Cindy coolly dismisses the station's threats from her office. See you next time.",
      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "다음에 봐요!",
      "gap": 0.3
    }
