    {
      "v": "joonmo",
      "t": "예진이가 먹고 싶은 거 위주로 시켰구먼, 걔가 산낙지 킬러거든.",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "뭘 보냐?",
      "gap": 0.5
