      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Offering a hangover drink, asking if you made any mistakes last night, and checking credit-card alerts gives you natural morning-after Korean office talk. See you next time!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
