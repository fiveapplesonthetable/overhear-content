      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "그건 어렵습니다.",
      "gap": 0.5
    },
    {
      "v": "manager",
      "t": "핑크 어려워요? 요새 자막들 컬러풀하던데.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "아니, 핑크가 어려운 게 아니라 그런 거짓말이 어렵다고요.",
      "gap": 0.5
    },
    {
      "v": "manager",
      "t": "다큐 찍으러 오셨어요?",
      "gap": 0.5
    },
    {
      "v": "manager",
      "t": "이거 예능이잖아요, 재밌어야죠.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "저희는 리얼 예능입니다, 더 정확하게는 리얼 야생 로드 버라이어티!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Asking to cut footage, add pink captions, and tell apart variety comedy from a documentary gives you vivid Korean vocabulary from television sets. Until next time!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
  ],
