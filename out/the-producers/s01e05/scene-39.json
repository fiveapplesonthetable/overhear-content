    {
      "v": "joonmo",
      "t": "넌 전화기를 놓고 가면 어떡하냐, 나는 꼼장어도 추가하려고.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "그날 거기서 카드로 7만 원 결제하셨다면서요.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "근데 그 포장마차 카드 안 된대요, 이제 기억나십니까?",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "선배님이 편집해버린 그날 밤 예진 선배님 이야기 기억나세요?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Catching a white lie through a cash-only street tent and asking someone if they remember what they tried to edit out brings the mystery of Episode 5 full circle. Until next time!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
