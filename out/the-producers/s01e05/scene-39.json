    {
      "v": "joonmo",
      "t": "왜 못 보내, 예진 선배가 날 좋아한대잖아.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "그러니까 둘이만 보내기 싫어!",
      "gap": 0.5
