    {
      "v": "yejin",
      "t": "나 봐라, 이거 연예인 특혜 아니니?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Rushing to the emergency room for an injured friend and grumbling playfully about celebrity treatment gives you vivid Korean hospital conversation. See you next time!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
