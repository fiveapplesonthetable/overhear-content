    {
      "v": "narrator",
      "t": "Checking on an injured friend, apologizing through tears for causing trouble, and offering silent comfort brings Episode 6 to an emotional close. Until next time!",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "다음에 또 만나요!",
      "gap": 0.3
    }
