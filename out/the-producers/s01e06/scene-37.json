      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "너한테 민폐 끼치고 너 불편하게 만들었다, 진짜 미안하다!",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "야, 너 우니?",
      "gap": 0.5
