    {
      "v": "seungchan",
      "t": "그렇다면 다행입니다, 이렇게 올라오는 거구나!",
      "gap": 0.5
    },
    {
      "v": "cindy",
      "t": "PD가 출연자를 보호해줘야지 자기가 더 무서워하고 있어!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "그렇게까지 무서운 건 아닙니다.",
      "gap": 0.5
