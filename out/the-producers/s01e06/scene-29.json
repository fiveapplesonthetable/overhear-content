      "v": "cindy",
      "t": "안 무서우면 이것 좀 놓지?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Testing a shaky stage lift and getting teased by a performer for clinging to the safety rail gives you charming, memorable Korean dialogue. See you next time!",
      "gap": 0.5
    },
    {
      "v": "cindy",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
