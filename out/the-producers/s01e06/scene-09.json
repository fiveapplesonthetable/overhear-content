    {
      "v": "colleague",
      "t": "무대 연출할 PD가 있어야지!",
      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "뭔 소리야, 그건 네가 해야지!",
      "gap": 0.5
    },
    {
      "v": "colleague",
      "t": "그럼 그 수많은 귀빈들은 누가 의전하니?",
      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "아 잘났다 정말, 그래서 무대에 누구누구 오르는데?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Asking a colleague for backup on a big event and rolling your eyes at shameless boss-pleasing gives you sharp, realistic Korean workplace humor. Until next time!",
      "gap": 0.5
    },
    {
      "v": "yejin",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
