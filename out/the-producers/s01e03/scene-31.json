    {
      "v": "joonmo",
      "t": "나 속이 안 좋다니까!",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "선배님 드시고 싶은 걸로 먹겠습니다.",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "주말마다 국장 따라 등산 가서 나 없던 근육 생긴 거 봐요, 형.",
      "gap": 0.5
