    {
      "v": "seungchan",
      "t": "이 여자랑 저 여자는 막 친하게 지내요.",
      "gap": 0.5
    },
    {
      "v": "seungchan",
      "t": "저는 이런 자유분방한 분위기 정말 적응 안 됩니다.",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Comforting a colleague in Korean often blends blunt honesty with warm encouragement like saying you can do both work and love. See you next time.",
      "gap": 0.5
    },
    {
      "v": "hyejoo",
      "t": "다음에 만나요!",
      "gap": 0.3
    }
  ],
