    {
      "v": "ilyong",
      "t": "그 집에서 김밥을 왜 먹어요?",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "From office receipts and company cards to favorite street-food dishes, you now have practical Korean phrases for both work expenses and lunch spots. Until next time!",
      "gap": 0.5
    },
    {
      "v": "ilyong",
      "t": "안녕히 계세요!",
      "gap": 0.3
    }
