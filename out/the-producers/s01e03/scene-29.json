    {
      "v": "rep",
      "t": "공연 앞두고는 전화를 꺼 두셔서요.",
      "gap": 0.5
    },
    {
      "v": "byun",
      "t": "라 피디님? 우리 오랜만이네.",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "우리가 통화할 일이 있습니까?",
      "gap": 0.5
    },
    {
      "v": "byun",
      "t": "나도 없을 줄 알았는데 생겼네.",
      "gap": 0.5
    },
    {
      "v": "byun",
      "t": "그쪽 팀 막내 피디라는 사람이 날 찾아왔어요.",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "뭐라고요? 거기 어딥니까?",
      "gap": 0.5
    },
    {
      "v": "joonmo",
      "t": "내가 지금 급한 일이 좀 생겨서요!",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Saying it has been a long time and excusing yourself when an urgent matter comes up are essential phrases for Korean phone calls. See you next time.",
      "gap": 0.5
    },
    {
      "v": "byun",
      "t": "다음에 봐요.",
      "gap": 0.3
    }
  ],
