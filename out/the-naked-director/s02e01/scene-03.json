    {
      "v": "narrator",
      "t": "Right outside the interview room, young director Student hurries Muranishi along while Kawada hands out cash advances and keeps their bustling new headquarters running smoothly.",
      "gap": 0.8
    },
    {
      "v": "student",
      "t": "監督、時間です。急ぎましょう。",
      "gap": 0.55
    },
    {
      "v": "student",
      "t": "今日の出演者は、よし、いるな。",
      "gap": 0.55
    },
    {
      "v": "student",
      "t": "社長、仮払いお願いします。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "ちょっと待ってくださいね。はい。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "もし女優が泣きだしたら、これを見せてください。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "その代わり、今日中に必ず撮りきってください。",
      "gap": 0.55
    },
    {
      "v": "student",
      "t": "はい、分かりました。了解です！",
      "gap": 0.55
    },
    {
      "v": "student",
      "t": "みんな乗り込むよ。忘れ物ないようにね。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "これ、配送先違いますよ。お願いしますよ。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "村西さん、今日もよろしくお願いします。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さあそれでは皆さん参りましょう！記念すべき年の始まりです。",
