  "title": "黒木さん、あなたテレビいいですよ  (Ms. Kuroki, You're Great on Television)",
  "level": "A1 — beginner",
  "labels": {
    "editor": "編集者",
    "kuroki": "黒木",
    "muranishi": "村西"
