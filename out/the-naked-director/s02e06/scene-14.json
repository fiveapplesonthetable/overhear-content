      "t": "はい、最高です！いい感じじゃないの。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "上出来だな。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "ああ。これでやっと作品作りができる。",
      "gap": 0.55
    },
