    {
      "v": "narrator",
      "t": "In sharp contrast to Muranishi's implosion, Kawada and Toshi celebrate brisk sales at their bustling workshop—and bring in their former female colleague to direct their first new production.",
      "gap": 0.8
    },
    {
      "v": "toshi",
      "t": "なかなか重いなこれ。はい、戻ったぞ。",
      "gap": 0.55
    },
