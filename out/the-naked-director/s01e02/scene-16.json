    {
      "v": "muranishi",
      "t": "即金で五千万出しますよ。",
      "gap": 0.5
    },
    {
      "v": "keieisha",
      "t": "ちょっと幹部連中と話してきます。",
      "gap": 0.5
    },
    {
      "v": "kawada",
      "t": "ずっと待ってました、あなたのような人を。",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "いけます！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Remember \"muri\" whenever a plan sounds impossible, \"mochiron\" for an easy 'of course', and \"ikemasu\" when everything clicks into place. Until next scene.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "また会いましょう。",
      "gap": 0.3
    }
