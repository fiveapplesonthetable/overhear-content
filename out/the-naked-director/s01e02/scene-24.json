      "t": "やった！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Yay!'",
      "gap": 0.45
    },
    {
      "v": "daisuke",
      "t": "廊下で遊んできていい？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Can I go play in the hallway?'",
      "gap": 0.45
    },
    {
      "v": "mayumi",
      "t": "これからもたまに会ってくれる？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Will you still come see us once in a while from now on?'",
      "gap": 0.45
    },
    {
