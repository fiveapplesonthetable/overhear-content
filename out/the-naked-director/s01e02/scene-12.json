    {
      "v": "narrator",
      "t": "Remember \"oku\" for units of one hundred million, \"shitsurei shimasu\" for excusing yourself cleanly from a room, and \"aete yokatta\" to tell someone it was great meeting them. Goodbye until next time.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "さようなら。",
      "gap": 0.3
