    },
    {
      "v": "client_f",
      "t": "ケガ人見捨てて行けないでしょ。ごはん買ってくる。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I couldn't just abandon an injured guy and leave. I'll go buy us some food.'",
      "gap": 0.45
    },
    {
      "v": "client_f",
      "t": "トシ！ここにいたらヤバいよ。下に来てた、早く！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Toshi! Staying here is bad news—they're downstairs, hurry!'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "こっちじゃない、こっち！おい、開けてくれ、頼むから！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Not that way, over here! Hey, open the door, I'm begging you!'",
