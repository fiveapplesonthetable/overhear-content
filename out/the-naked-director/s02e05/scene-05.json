    },
    {
      "v": "client_f",
      "t": "トシ！ヤバい、もうダメ…",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Toshi! Oh no, we're done for...'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "追われてんだよ。かくまってくれよ、頼む！ちょっとでいいんだよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'People are chasing us—please hide us! Just for a little bit.'",
      "gap": 0.45
    },
    {
      "v": "client_f",
      "t": "困ります、警察呼びますよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Stop this, or I will call the police!'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "すまん、もうちょっとだけここにいさせてくれよ。",
      "gap": 0.55
    },
    {
