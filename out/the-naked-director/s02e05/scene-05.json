  "segments": [
    {
      "v": "narrator",
      "t": "Hiding in a hotel after the gangland shooting, Toshi and the young hostess barely escape when gangland pursuers storm their floor—ducking into a neighboring room where Kawada happens to be tied up.",
      "gap": 0.8
    },
    {
      "v": "toshi",
      "t": "つきあわせて悪かったな。",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "ケガ人見捨てて行けないでしょ。ごはん買ってくる。",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "トシ！ここにいたらヤバいよ。下に来てた、早く！",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "こっちじゃない、こっち！おい、開けてくれ、頼むから！",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "トシ！ヤバい、もうダメ…",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "追われてんだよ。かくまってくれよ、頼む！ちょっとでいいんだよ。",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "困ります、警察呼びますよ。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "すまん、もうちょっとだけここにいさせてくれよ。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "えっ、誰？",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "川田！",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "あっ、トシじゃん。何やってんだよ？こんなとこで。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "いや、こっちのセリフだよ。",
      "gap": 0.9
