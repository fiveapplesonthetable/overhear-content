      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Cheering on the junior directors she trained, the veteran staff director leaves the studio behind with her head held high.",
      "gap": 0.5
    },
    {
      "v": "reika",
      "t": "またね。",
      "gap": 0.3
    }
