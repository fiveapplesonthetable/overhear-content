      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Laughing over household chores in their small apartment, Kuroki and her friend toast to living freely on their own terms.",
      "gap": 0.5
    },
    {
      "v": "kuroki",
      "t": "また明日。",
      "gap": 0.3
