  "segments": [
    {
      "v": "narrator",
      "t": "Cut straight from Takei's taunt about flying into the sky to an island airfield, where Muranishi unveils a small plane for his aerial finale over the bay. Listen to the Japanese first.",
      "gap": 0.8
    },
    {
      "v": "student",
      "t": "ホントに空を飛ぶの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "当たり前だろ。こいつで真珠湾の上を飛ぶ。",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "ちょっと待って、地上で撮るんじゃないの？って。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それじゃ迫力が出ないだろ。世界初の映像を撮るんだ。",
