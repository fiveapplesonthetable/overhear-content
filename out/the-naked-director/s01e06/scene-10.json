      "t": "がっかりさせないでよって。",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "もちろんだ。よーし、本番いこう！アクション！",
      "gap": 0.5
    },
    {
      "v": "muranishi",
