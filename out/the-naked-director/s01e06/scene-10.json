      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Keep an ear out for 'mukiatte agete kudasai', 'please face her sincerely', and 'gakkari sasenaide', 'don't disappoint me'. See you next time.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "じゃあね。",
      "gap": 0.3
    }
