  "segments": [
    {
      "v": "narrator",
      "t": "Arriving at a spacious rented villa, the crew discovers that their fluent coordinator grew up in northern Tokyo. Inside, Muranishi pitches his grand spy story to the assembled cast and quietly checks on their acting ability. Let's listen in Japanese first.",
      "gap": 0.8
    },
    {
      "v": "driver",
      "t": "はい、到着です。",
      "gap": 0.55
    },
    {
      "v": "reika",
      "t": "ここに泊まれるの？すごい！",
      "gap": 0.55
    },
    {
      "v": "reika",
      "t": "日本語ペラペラだけど、どこ出身？",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "東京です。ほとんどハワイにいるから大丈夫！",
      "gap": 0.55
    },
    {
      "v": "reika",
      "t": "やっぱ日本人じゃん！ハワイ案内できるの？",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "もちろん！心配しすぎだよ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちゃんとキャストはそろってるんだろうな？",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "もちろんです！村西さん、どうぞ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "監督の村西だ。今回の作品は悪の組織と戦う超大作だ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "役者の質が低くないか？大丈夫なんだろうな？",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "大丈夫、大丈夫。芝居は完璧ですから。",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "玄関だ。彼女かも！",
