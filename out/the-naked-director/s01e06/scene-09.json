    {
      "v": "muranishi",
      "t": "分かった。移動中に脚本を書き直す。撤収だ！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Refusing to halt mid-shoot before calling a sudden location wrap keeps the crew one step ahead of trouble. Until next time.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "またね。",
      "gap": 0.3
