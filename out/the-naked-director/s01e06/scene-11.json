      "gap": 0.5
    },
    {
      "v": "furuya",
      "t": "なあ、トシ。",
      "gap": 0.5
    },
    {
      "v": "furuya",
      "t": "池沢より上に行きたいか？",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "はい。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Notice the contrast between 'omote', above ground in legitimate shops, and 'ura', the underground market. Until next time.",
      "gap": 0.5
    },
    {
      "v": "furuya",
      "t": "じゃあね。",
      "gap": 0.3
    }
