      "t": "おい、ちょっと待ってくれ！",
      "gap": 0.55
    },
    {
      "v": "driver",
      "t": "約束どおり、すぐに解放して。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "痛い、痛い！何だよ、おい、離せよ！",
