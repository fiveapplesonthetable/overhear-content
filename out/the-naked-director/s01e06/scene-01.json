  "segments": [
    {
      "v": "narrator",
      "t": "In episode six of The Naked Director, Muranishi plans an ambitious overseas shoot to turn his struggling company around. In Tokyo, Toshi lines up a cheap local coordinator while Kawada quietly brings emergency cash for the trip. Let's hear the Japanese dialogue first.",
      "gap": 0.8
    },
    {
      "v": "toshi",
      "t": "ハワイのコーディネーター安く雇えたからよ。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "女優の出演も交渉してくれるらしいぞ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本当か。メジャーな作品にしないとな。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "出どころは聞かないでください。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "川田さん、ありがとうございます。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "わがままを聞くのは今回で最後ですから。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "おい、お前ら遊びに行くんじゃねえからな。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "つまんねえの撮ったら許さねえからな。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ、任せとけ。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "村西さん、くれぐれもよろしくお願いします。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい、いってきます。行くぞ！",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "お前ら、一発逆転ホームラン頼んだぞ！",
