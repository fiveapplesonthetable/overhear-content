    {
      "v": "narrator",
      "t": "Whispering Muranishi's plea under his breath, Toshi bursts into Furuya's office to end the boss's reign and falls under the blades of Furuya's bodyguards.",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "さようなら。",
      "gap": 0.3
