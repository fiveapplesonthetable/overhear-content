  "segments": [
    {
      "v": "narrator",
      "t": "After walking a young hostess back to her apartment, Toshi spots an older woman demanding monthly cash from her in the freezing cold and steps in to stop the shakedown.",
      "gap": 0.8
    },
    {
      "v": "mama",
      "t": "こんなクソ寒い所でいつまで待たせんだよ。死んじまうだろ。",
      "gap": 0.55
    },
    {
      "v": "mama",
      "t": "今月分、いつ払うんだ？",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "縁起悪いウソつくのやめてよ。",
      "gap": 0.55
    },
    {
      "v": "mama",
      "t": "ウソじゃないよ。お前は風邪ひくんじゃないよ。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "おい！何喝上げされてんだ！",
      "gap": 0.55
    },
    {
      "v": "mama",
      "t": "何すんだよ！兄ちゃん、タバコ持ってないか？",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "何してんだよ！おい、ちょっと待てよ！",
      "gap": 0.55
    },
    {
      "v": "mama",
      "t": "これ一本もらうよ。じゃあ。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "おめえ、何なんだよ？あのババアよ。",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "お金、毎月払ってやってんだよ。借金地獄だから。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "なんでそんなことすんだよ？",
      "gap": 0.55
    },
    {
      "v": "client_f",
      "t": "あんなクズから生まれたんだよ、私。上がってく？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "mama",
      "t": "こんなクソ寒い所でいつまで待たせんだよ。死んじまうだろ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'How long are you going to keep me waiting in this freezing cold? I'll freeze to death.'",
      "gap": 0.45
    },
    {
      "v": "mama",
      "t": "今月分、いつ払うんだ？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'When are you paying this month's share?'",
      "gap": 0.45
    },
    {
      "v": "client_f",
      "t": "縁起悪いウソつくのやめてよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Stop telling such morbid lies.'",
      "gap": 0.45
    },
    {
      "v": "mama",
      "t": "ウソじゃないよ。お前は風邪ひくんじゃないよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'It's not a lie. Don't you go catching a cold.'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "おい！何喝上げされてんだ！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Hey! Why are you letting her shake you down?'",
      "gap": 0.45
    },
    {
      "v": "mama",
      "t": "何すんだよ！兄ちゃん、タバコ持ってないか？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'What's your problem! Hey mister, got any cigarettes?'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "何してんだよ！おい、ちょっと待てよ！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'What are you doing! Hey, hold on right there!'",
      "gap": 0.45
    },
    {
      "v": "mama",
      "t": "これ一本もらうよ。じゃあ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I'll help myself to one of these. See ya.'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "おめえ、何なんだよ？あのババアよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Hey, who the hell was that old hag?'",
      "gap": 0.45
    },
    {
      "v": "client_f",
      "t": "お金、毎月払ってやってんだよ。借金地獄だから。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I pay her money every month, because she's buried in debt.'",
      "gap": 0.45
    },
    {
      "v": "toshi",
      "t": "なんでそんなことすんだよ？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Why on earth are you doing that?'",
      "gap": 0.45
    },
    {
      "v": "client_f",
      "t": "あんなクズから生まれたんだよ、私。上がってく？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'That lowlife is the one who gave birth to me. Want to come upstairs?'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
      "gap": 0.75
