  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "えっ？えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よし早く降りて準備しろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっあっあの監督ここ僕の家なんですけど…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何お前バカ！スタジオ借りる金なんかないだろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えーっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あのホントにここでやるんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あのホントにここでやるんですか？おい早く開けろほら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ別の家だっていいじゃないですか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "早くほら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よいしょ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "誰？ポスター破いたの",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと来てえっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "見て何何？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ここ昨日までは破れてなかった",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ど…どれどれ？これ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっちょっと何やってんの！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやそんぐらいいいだろ細かいよホント",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "君が大ざっぱすぎるんだよ筋肉！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "童貞！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "童貞関係ないだろ！童貞だろこの細かさ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやいや逆に逆に言うよ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何をごちゃごちゃやってるお前らは早くしろほら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どけはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こんなバンダナいる？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やるよはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫かな？ん？何が",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやポセイドンの女優勝手に使ったりして",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ヤバいんじゃないかな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとねうちの作品に出てくれて",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "三田村はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "不安？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっとはね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫だよ手前みそだけど―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ポセイドンよりうちの監督のがみくちゃんに合うと思う",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "きっと正解だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっ待って待って…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "代われ交代しろはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ここにここにこう腕をこうしてついて…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフッ私もそんな気がする",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "君はね過去に２回ぐらい会ってる奥さんに",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "その時から…きれいだなとずっと思ってたんだよね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かるねそれがあって―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あと君は何だ３年も４年も前に奥さんに逃げられてね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいオーケーですありがとうございます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みくさん入ります",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お願いしますはいよろしく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お願いしますよろしく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みくちゃんいいね？君はロンリーな未亡人です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "元国鉄マンの旦那を忘れずにさみしくて泣いてる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ね？そこに旦那の上司がやってきて",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さみしい２人が出会うわけですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そしたら奥さんあなたそれを受け入れる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねそうなるでしょいいねはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "準備いいね？はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さみしい２人孤独です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そして激しく求め合うこのコントラストが大事ですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい回してカメラはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "回りましたはいじゃあ本番",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "用意！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "スタート！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "えっ？えっ？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Notice the expression here.'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
