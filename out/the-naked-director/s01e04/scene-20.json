      {
        "line": 0,
        "cue": 365,
        "fragment": "‎（聡子）ねえ 恵美 ‎こないだのディスコの彼はどう？"
      },
      {
        "line": 1,
        "cue": 366,
        "fragment": "‎（恵美）フフッ ‎ううん 別に何もないよ"
      },
      {
        "line": 2,
        "cue": 367,
        "fragment": "‎（聡子たち）え～ ホント？"
      },
      {
        "line": 3,
        "cue": 368,
        "fragment": "‎（聡子）恵美も そろそろ ‎恋人ぐらい作ればいいのに"
      },
      {
        "line": 4,
        "cue": 369,
        "fragment": "‎（友人）そうだよ"
      },
      {
        "line": 5,
        "cue": 370,
        "fragment": "‎（聡子）ちょっと ‎奥手すぎるんじゃない？"
      },
      {
        "line": 6,
        "cue": 371,
        "fragment": "‎えっ？"
      },
      {
        "line": 7,
        "cue": 372,
        "fragment": "‎（涼太）そうだよ ‎男の子 紹介しようか？"
      },
      {
        "line": 8,
        "cue": 373,
        "fragment": "‎（友人）えっ 待って ‎私も紹介してほしい"
      },
      {
        "line": 9,
        "cue": 374,
        "fragment": "‎（恵美）ねえ ２人は？ ‎（聡子･涼太）ん？"
      },
      {
        "line": 10,
        "cue": 375,
        "fragment": "‎どうなの？ ‎どんなセックスしてるの？"
      },
      {
        "line": 11,
        "cue": 376,
        "fragment": "‎フッ… いや ちょっと恵美"
      },
      {
        "line": 12,
        "cue": 377,
        "fragment": "‎（涼太）気になるんだ ‎（恵美）うん"
      },
      {
        "line": 13,
        "cue": 378,
        "fragment": "‎（涼太）う～ん そうだな ‎（聡子）もういいよ そんな…"
      },
      {
        "line": 14,
        "cue": 379,
        "fragment": "‎まあね ‎相性とかは すげえいいよね"
      },
      {
        "line": 15,
        "cue": 380,
        "fragment": "‎（聡子）いや…"
      },
      {
        "line": 16,
        "cue": 381,
        "fragment": "‎ちょっと何言ってんの？ ‎もう やめてよ ホントに"
      },
      {
        "line": 17,
        "cue": 382,
        "fragment": "‎恥ずかしい"
      },
      {
        "line": 18,
        "cue": 384,
        "fragment": "‎でも 聡子の演技かもしれないよね"
      },
      {
        "line": 19,
        "cue": 385,
        "fragment": "‎えっ？"
      },
      {
        "line": 20,
        "cue": 386,
        "fragment": "‎そんなわけないだろ"
      },
      {
        "line": 21,
        "cue": 387,
        "fragment": "‎（涼太）なあ？ ‎（聡子）ん？"
      },
      {
        "line": 22,
        "cue": 388,
        "fragment": "‎（友人）え 女の子ってさ ‎ホントに そういう時 演技すんの？"
      },
      {
        "line": 23,
        "cue": 389,
        "fragment": "‎（友人）何言ってんの ねえ"
      },
      {
        "line": 24,
        "cue": 390,
        "fragment": "‎あら 女の子って ‎分からないものよ ねえ 聡子"
      },
      {
        "line": 25,
        "cue": 391,
        "fragment": "‎（聡子）ん～ 人それぞれかな？"
      },
      {
        "line": 26,
        "cue": 393,
        "fragment": "‎何だよ 聡子 そうなの？"
      },
      {
        "line": 27,
        "cue": 394,
        "fragment": "‎うっ… ハァ…"
      },
      {
        "line": 28,
        "cue": 395,
        "fragment": "‎（聡子）何？　どうしたの？ ‎（涼太）何でもない"
      },
      {
        "line": 29,
        "cue": 396,
        "fragment": "‎（友人）聡子のことで ‎動揺したんじゃん？"
      },
      {
        "line": 30,
        "cue": 397,
        "fragment": "‎私は つまらないな 演技だとしたら"
      },
      {
        "line": 31,
        "cue": 398,
        "fragment": "‎（涼太）ハァ… ハァ…"
      }
