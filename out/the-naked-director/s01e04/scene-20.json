  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "ねえ恵美こないだのディスコの彼はどう？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフッううん別に何もないよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "え～ホント？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "恵美もそろそろ恋人ぐらい作ればいいのに",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと奥手すぎるんじゃない？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうだよ男の子紹介しようか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ待って私も紹介してほしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえ２人は？ん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうなの？どんなセックスしてるの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フッ…いやちょっと恵美",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "気になるんだうん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "う～んそうだなもういいよそんな…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあね相性とかはすげえいいよね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いや…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと何言ってんの？もうやめてよホントに",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "恥ずかしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でも聡子の演技かもしれないよね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなわけないだろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "なあ？ん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "え女の子ってさホントにそういう時演技すんの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何言ってんのねえ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あら女の子って分からないものよねえ聡子",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ん～人それぞれかな？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何だよ聡子そうなの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっ…ハァ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何？どうしたの？何でもない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "聡子のことで動揺したんじゃん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私はつまらないな演技だとしたら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハァ…ハァ…",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
