      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Declaring that a chef's skill decides whether raw ingredients shine or go to waste, Muranishi tells everyone to eat up before he crashes rival Poseidon's party! See you next time!",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "またね。",
      "gap": 0.3
    }
