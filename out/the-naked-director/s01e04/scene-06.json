  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "北海道ではよ勝負するって大口たたいてたけど―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "現実は天と地だな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺はそうは思わない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ほえててもしょうがねえだろ現実は池沢が売れてんだからよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "これからだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "これからこれからって…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああどうも",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大将ああどうもどうも",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "酎ハイと煮込みくれはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ～",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "モヤモヤした時は安酒かっ食らうのが一番だな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハッ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうだ？少しは歌舞伎町に慣れたか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあぼちぼちです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あんたは商才がある頑張ってまたもうけさせてくれよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何かすっかり勝者っすね古谷さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まだまだこれからだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お待たせしましたはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "だからお前らには期待してんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何だよこれ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あこれ？ああエロビデオっすよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あ金ねえから当日返却なんすけど情けないっすよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "池沢にまたやられるようなヘマだけはすんなよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "“また”？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "“また”って何ですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ウソだろおい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "アッハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おい藤原こいつら相当鈍いぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前らがパクられたのは池沢の仕掛けなんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "池沢と武井はつながってるんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフフッ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "次は守ってやるよ俺は味方だからよ",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
