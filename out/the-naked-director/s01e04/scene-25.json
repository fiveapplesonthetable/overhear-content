    },
    {
      "v": "muranishi",
      "t": "おおこんにちは",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああそうか並んでるよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ええ？おおっ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おいおっさん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "一歩前進ですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やったー",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あんたらの作品さ斬新で面白かったよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でもそれポセイドンの女優だろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫なのか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うんうまいな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "上品な味だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "有名レストランからのれん分けされたお店のようです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そいつはいい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "のれん分けってのは―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "信用に足る店かどうかの目安になるからなフフッ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さあ君らもどんどん食べなさい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとうございます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すごいおいしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうした？食べないのか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハッすいませんき…緊張してまして",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "緊張だってかわいいかわいい～",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "先日うちと契約した新人の佐伯静香です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "硬くなる必要ないだろうみんな身内なんだから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうだよ大丈夫だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとうございます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "かわいいかわいい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃあこないだ観た面白い作品の話をしてやろう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えー？何ですか何ですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どんな作品ですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "見たことない体位で男女が絡んでてな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何それ～",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "またその女優が伸び伸び演技してんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "へえ～",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ただどうも興奮できないと思ってよーく見たらな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "その女がなんと…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何？誰？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うちの女優だったんだよ",
      "gap": 0.9
    },
