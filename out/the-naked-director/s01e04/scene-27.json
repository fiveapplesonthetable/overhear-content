    {
      "v": "muranishi",
      "t": "行こうかうん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっちょっと待って",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい下がって下がってはい下がって下がって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みくどこに連れていくの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前らみたいなガキがね日本ダメにすんだよ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はあ？ふざけんなよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みく！みく！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "恨むなら村西恨めよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あと身元引受人が必要なんだけど",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "母親でいいな？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お願いします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "親にだけは黙っててください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お願いします！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何でもしますから親だけは黙っててください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あれ？もう連絡しちゃったんだよな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もう全部話しちゃったって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねっ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっそうだそうだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えーこれ渡すの忘れてた",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まったく全然電話しないんだから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "会社ちゃんと行ってるの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "行ってるってば",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今ね給料貯金して―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お母さんに旅行プレゼントしたいなって思ってんだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとね気持ちだけで十分よ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お金大丈夫？",
      "gap": 0.9
