      {
        "line": 0,
        "cue": 539,
        "fragment": "‎（菊池）‎南(みなみ)‎ みくさん"
      },
      {
        "line": 1,
        "cue": 540,
        "fragment": "‎行こうか うん"
      },
      {
        "line": 2,
        "cue": 541,
        "fragment": "‎（友人）えっ ちょっと待って"
      },
      {
        "line": 3,
        "cue": 542,
        "fragment": "‎（刑事）はい 下がって 下がって ‎はい 下がって 下がって"
      },
      {
        "line": 4,
        "cue": 543,
        "fragment": "‎（友人） ‎みく どこに連れていくの？"
      },
      {
        "line": 5,
        "cue": 544,
        "fragment": "‎お前らみたいなガキがね ‎日本 ダメにすんだよ！"
      },
      {
        "line": 6,
        "cue": 545,
        "fragment": "‎（客たち）はあ？　ふざけんなよ"
      },
      {
        "line": 7,
        "cue": 546,
        "fragment": "‎（友人たち）みく！　みく！"
      },
      {
        "line": 8,
        "cue": 547,
        "fragment": "‎（武井）恨むなら 村西 恨めよ"
      },
      {
        "line": 9,
        "cue": 548,
        "fragment": "‎あと 身元引受人が必要なんだけど"
      },
      {
        "line": 10,
        "cue": 549,
        "fragment": "‎母親でいいな？"
      },
      {
        "line": 11,
        "cue": 550,
        "fragment": "‎お願いします"
      },
      {
        "line": 12,
        "cue": 551,
        "fragment": "‎親にだけは黙っててください"
      },
      {
        "line": 13,
        "cue": 552,
        "fragment": "‎お願いします！"
      },
      {
        "line": 14,
        "cue": 553,
        "fragment": "‎何でもしますから ‎親だけは黙っててください"
      },
      {
        "line": 15,
        "cue": 554,
        "fragment": "‎ああ…"
      },
      {
        "line": 16,
        "cue": 555,
        "fragment": "‎あれ？ ‎もう連絡しちゃったんだよな"
      },
      {
        "line": 17,
        "cue": 556,
        "fragment": "‎（菊池）はい"
      },
      {
        "line": 18,
        "cue": 557,
        "fragment": "‎もう全部 話しちゃったって"
      },
      {
        "line": 19,
        "cue": 558,
        "fragment": "‎ねっ"
      },
      {
        "line": 20,
        "cue": 559,
        "fragment": "‎あっ そうだ そうだ"
      },
      {
        "line": 21,
        "cue": 560,
        "fragment": "‎えー これ渡すの忘れてた"
      },
      {
        "line": 22,
        "cue": 562,
        "fragment": "（みくの母）まったく 全然電話しないんだから"
      },
      {
        "line": 23,
        "cue": 563,
        "fragment": "会社 ちゃんと行ってるの？"
      },
      {
        "line": 24,
        "cue": 564,
        "fragment": "‎（みく）‎行ってるってば"
      },
      {
        "line": 25,
        "cue": 565,
        "fragment": "‎今ね 給料貯金して‎―"
      },
      {
        "line": 26,
        "cue": 566,
        "fragment": "‎お母さんに旅行プレゼントしたいな ‎って思ってんだ"
      },
      {
        "line": 27,
        "cue": 567,
        "fragment": "‎（みくの母） ‎ありがとね　気持ちだけで十分よ"
      },
      {
        "line": 28,
        "cue": 568,
        "fragment": "‎お金 大丈夫？"
      }
