  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "おはよう私",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もしもし？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああみく？昨日電話くれる約束だったでしょ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ごめんごめん起きてた？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "とっくようち農家なのお忘れ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まったく全然電話しないんだから会社ちゃんと行ってるの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "行ってるってば",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今ね給料貯金して―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お母さんに旅行プレゼントしたいなって思ってんだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとね気持ちだけで十分よ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お金大丈夫？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫だようちの会社結構給料いいんだから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "勝手に東京行って連絡もろくによこさないで",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お父さんも心配してんだから東京は危ない街だって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "危ないことなんかないから大丈夫だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃあねまたかけるね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "できました！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おお来た来た来た",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ラグビーさ漬け物の皿は別にしてくんない？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私こうやって味混ざんの嫌なんだよね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "気になるかな？なるでしょ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっとぐらいじゃ味変わんないよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "舌が野蛮なんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私こういう境界線ははっきりしたいタイプなの",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえねえ三田ちゃん三田ちゃん平気だよね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "僕あんまり食べないんでどっちでも",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ほら順子さんだけだよこれ気にしてんのマジこんな…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "だから男ばっかはやなんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もうそんな言い方すんだったら自炊当番やってくださいよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女のくせに全然やんないじゃんあんた",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっ女のくせにって何？もう差別じゃん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっとケンカしないでくださいよごはん食べてる…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっせえな！お前らは",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "静かに食え",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "おはよう私",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Notice the expression here.'",
      "gap": 0.65
    },
