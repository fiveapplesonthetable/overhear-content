    "lines": [
      {
        "line": 0,
        "cue": 115,
        "fragment": "‎おはよう 私"
      },
      {
        "line": 1,
        "cue": 116,
        "fragment": "‎もしもし？"
      },
      {
        "line": 2,
        "cue": 117,
        "fragment": "‎（みくの母）‎ああ みく？ ‎昨日 電話くれる約束だったでしょ"
      },
      {
        "line": 3,
        "cue": 118,
        "fragment": "‎ごめん ごめん 起きてた？"
      },
      {
        "line": 4,
        "cue": 119,
        "fragment": "‎（みくの母） ‎とっくよ　うち農家なの お忘れ？"
      },
      {
        "line": 5,
        "cue": 120,
        "fragment": "‎まったく 全然電話しないんだから ‎会社ちゃんと行ってるの？"
      },
      {
        "line": 6,
        "cue": 121,
        "fragment": "‎行ってるってば"
      },
      {
        "line": 7,
        "cue": 122,
        "fragment": "‎今ね 給料貯金して‎―"
      },
      {
        "line": 8,
        "cue": 123,
        "fragment": "‎お母さんに旅行プレゼントしたいな ‎って思ってんだ"
      },
      {
        "line": 9,
        "cue": 124,
        "fragment": "‎（みくの母） ‎ありがとね　気持ちだけで十分よ"
      },
      {
        "line": 10,
        "cue": 125,
        "fragment": "‎お金 大丈夫？"
      },
      {
        "line": 11,
        "cue": 126,
        "fragment": "‎（みく）大丈夫だよ ‎うちの会社 結構給料いいんだから"
      },
      {
        "line": 12,
        "cue": 127,
        "fragment": "‎（みくの母）‎勝手に東京行って ‎連絡も ろくによこさないで"
      },
      {
        "line": 13,
        "cue": 128,
        "fragment": "‎お父さんも心配してんだから ‎東京は危ない街だって"
      },
      {
        "line": 14,
        "cue": 129,
        "fragment": "‎危ないことなんかないから ‎大丈夫だよ"
      },
      {
        "line": 15,
        "cue": 130,
        "fragment": "‎じゃあね またかけるね"
      },
      {
        "line": 16,
        "cue": 131,
        "fragment": "‎（後藤）できました！"
      },
      {
        "line": 17,
        "cue": 132,
        "fragment": "‎（トシ）おお 来た来た 来た"
      },
      {
        "line": 18,
        "cue": 133,
        "fragment": "‎（順子）ラグビーさ ‎漬け物の皿は別にしてくんない？"
      },
      {
        "line": 19,
        "cue": 134,
        "fragment": "‎私 こうやって ‎味 混ざんの嫌なんだよね"
      },
      {
        "line": 20,
        "cue": 135,
        "fragment": "‎（後藤）気になるかな？ ‎（順子）なるでしょ"
      },
      {
        "line": 21,
        "cue": 136,
        "fragment": "‎（後藤）ちょっとぐらいじゃ ‎味 変わんないよ"
      },
      {
        "line": 22,
        "cue": 137,
        "fragment": "‎（順子）舌が野蛮なんだよ"
      },
      {
        "line": 23,
        "cue": 138,
        "fragment": "‎私 こういう境界線は ‎はっきりしたいタイプなの"
      },
      {
        "line": 24,
        "cue": 139,
        "fragment": "‎（後藤）ねえねえ ‎三田(みた)‎ちゃん ‎三田ちゃん 平気だよね？"
      },
      {
        "line": 25,
        "cue": 140,
        "fragment": "‎（三田村） ‎僕 あんまり食べないんで ‎どっちでも"
      },
      {
        "line": 26,
        "cue": 141,
        "fragment": "‎ほら 順子さんだけだよ ‎これ 気にしてんの マジ こんな…"
      },
      {
        "line": 27,
        "cue": 142,
        "fragment": "‎だから 男ばっかは やなんだよ"
      },
      {
        "line": 28,
        "cue": 143,
        "fragment": "‎もう そんな言い方すんだったら ‎自炊当番やってくださいよ"
      },
      {
        "line": 29,
        "cue": 144,
        "fragment": "‎女のくせに ‎全然やんないじゃん あんた"
      },
      {
        "line": 30,
        "cue": 145,
        "fragment": "‎あっ 女のくせにって何？ ‎もう差別じゃん"
      },
      {
        "line": 31,
        "cue": 146,
        "fragment": "‎（三田村） ‎ちょっとケンカしないでくださいよ ‎ごはん 食べてる…"
      },
      {
        "line": 32,
        "cue": 147,
        "fragment": "‎うっせえな！　お前らは"
      },
      {
        "line": 33,
        "cue": 148,
        "fragment": "‎静かに食え"
      }
    ]
  },
