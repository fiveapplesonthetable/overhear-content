  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "すっげえ食い合わせだな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "腹に入れば同じだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ラグビーうまいぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとうございます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "素材を生かすも殺すも料理人の腕しだいだからな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "食えほら戦の前の腹ごしらえだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "撮影の皆様そろそろよろしいでしょうか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "マスコミの皆様も少々お下がりください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それではポルノ王こと―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ポセイドン企画の池沢社長よりひと言頂きたいと思います",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えーお集まりの皆様",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うちもおかげさまで４年目を迎え",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女優ともども精進していきたいと思っております",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいぞ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私はアダルトビデオだからこそ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "秩序が必要だという信念を持っております",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうだそうだ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "業界の今後の発展のためにも微力ながら…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "誰のためのルールだ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さすがポルノ王食いもんも豪華ですね肉が多い",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "係の方部外者が混ざっているようなので確認願いますか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺は部外者じゃないアダルトビデオの監督だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今日は招待したお客様だけの会でね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あんたの作品はちっとも抜けないな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女優が感じてないのが分かるから見ててシラける",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みんな顔が死んでる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "特にあなた",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "顔がまるでロボットのようだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ご高説賜りたいがこれ以上パーティーがシラけるのも困る",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そろそろよろしいかな？ハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お引き取り願えますか自分で行くよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "帰れ！つまみ出せよおい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "帰れ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっとあんた",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
