    "lines": [
      {
        "line": 0,
        "cue": 149,
        "fragment": "‎すっげえ食い合わせだな"
      },
      {
        "line": 1,
        "cue": 150,
        "fragment": "‎腹に入れば同じだよ"
      },
      {
        "line": 2,
        "cue": 151,
        "fragment": "‎ラグビー うまいぞ"
      },
      {
        "line": 3,
        "cue": 152,
        "fragment": "‎（後藤）ありがとうございます"
      },
      {
        "line": 4,
        "cue": 153,
        "fragment": "‎素材を生かすも殺すも ‎料理人の腕しだいだからな"
      },
      {
        "line": 5,
        "cue": 154,
        "fragment": "‎食え ほら 戦の前の腹ごしらえだ"
      },
      {
        "line": 6,
        "cue": 155,
        "fragment": "‎（司会）‎撮影の皆様 ‎そろそろ よろしいでしょうか？"
      },
      {
        "line": 7,
        "cue": 156,
        "fragment": "‎マスコミの皆様も ‎少々お下がりください"
      },
      {
        "line": 8,
        "cue": 157,
        "fragment": "‎それでは ポルノ王こと‎―"
      },
      {
        "line": 9,
        "cue": 158,
        "fragment": "‎ポセイドン企画の池沢社長より ‎ひと言 頂きたいと思います"
      },
      {
        "line": 10,
        "cue": 160,
        "fragment": "‎（池沢）‎えー お集まりの皆様"
      },
      {
        "line": 11,
        "cue": 161,
        "fragment": "‎うちも おかげさまで４年目を迎え"
      },
      {
        "line": 12,
        "cue": 162,
        "fragment": "‎女優ともども ‎精進していきたいと思っております"
      },
      {
        "line": 13,
        "cue": 163,
        "fragment": "‎（男性）いいぞ！ ‎（拍手）"
      },
      {
        "line": 14,
        "cue": 164,
        "fragment": "‎私はアダルトビデオだからこそ"
      },
      {
        "line": 15,
        "cue": 165,
        "fragment": "‎秩序が必要だという信念を ‎持っております"
      },
      {
        "line": 16,
        "cue": 166,
        "fragment": "‎（男性）そうだ そうだ！"
      },
      {
        "line": 17,
        "cue": 167,
        "fragment": "‎業界の今後の発展のためにも ‎微力ながら…"
      },
      {
        "line": 18,
        "cue": 168,
        "fragment": "‎（村西）誰のためのルールだ？"
      },
      {
        "line": 19,
        "cue": 170,
        "fragment": "‎さすが ポルノ王 ‎食いもんも豪華ですね 肉が多い"
      },
      {
        "line": 20,
        "cue": 171,
        "fragment": "‎（司会） ‎係の方 部外者が混ざっているよう ‎なので確認願いますか"
      },
      {
        "line": 21,
        "cue": 172,
        "fragment": "‎俺は部外者じゃない ‎アダルトビデオの監督だ"
      },
      {
        "line": 22,
        "cue": 173,
        "fragment": "‎今日は招待したお客様だけの会でね"
      },
      {
        "line": 23,
        "cue": 174,
        "fragment": "‎あんたの作品は ‎ちっとも抜けないな"
      },
      {
        "line": 24,
        "cue": 175,
        "fragment": "‎女優が感じてないのが分かるから ‎見ててシラける"
      },
      {
        "line": 25,
        "cue": 176,
        "fragment": "‎みんな 顔が死んでる"
      },
      {
        "line": 26,
        "cue": 177,
        "fragment": "‎特に あなた"
      },
      {
        "line": 27,
        "cue": 178,
        "fragment": "‎顔が まるでロボットのようだ"
      },
      {
        "line": 28,
        "cue": 179,
        "fragment": "‎えっ？"
      },
      {
        "line": 29,
        "cue": 180,
        "fragment": "‎ご高説賜りたいが これ以上 ‎パーティーがシラけるのも困る"
      },
      {
        "line": 30,
        "cue": 181,
        "fragment": "‎そろそろ よろしいかな？ ‎ハハハ…"
      },
      {
        "line": 31,
        "cue": 182,
        "fragment": "‎（‎楓(かえで)‎）お引き取り願えますか ‎（村西）自分で行くよ"
      },
      {
        "line": 32,
        "cue": 183,
        "fragment": "‎（男性）帰れ！ ‎（男性）つまみ出せよ おい"
      },
      {
        "line": 33,
        "cue": 184,
        "fragment": "‎（男性）帰れ"
      },
      {
        "line": 34,
        "cue": 185,
        "fragment": "‎（警備員）ちょっと あんた"
      }
    ]
