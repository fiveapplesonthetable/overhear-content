      "t": "ダメよそんな…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あの人が天国から見てるわ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "奥さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ダメ…ダメよダメダメ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫あいつはもう死んだんだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いけないわ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっ…うっ…あっあっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと激しく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すごい…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "奥さんあなたも求めるんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ううっあっうっ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "イヤっあっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ダメだ代われあの…上になれ騎乗位になれ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいあっはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと激しく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっあっンあん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっ気持ちいいああっイキそう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "最高…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "カット！ダメだみくちょっと来い",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前俺をナメてるのか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何がダメなんですか？ふざけた演技しやがって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺が池沢と同じだと思ったら大間違いだぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺は死ぬ気でお前と向かい合ってる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "受け止めてやるからすべてさらけ出せ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もう前貼り取るか？えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こんなもんしてるからいつまでたってもよろいが取れないんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "１回本番でやってみろできません",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "監督それはまずいと思います本番なんて聞いたことないですし",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "だからこそ言ってるんだよ俺は",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あの～本番させる気ですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "勘弁してくださいよそんなん無理ですから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何をお前男が無理なんだバカたれ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなことしたらパクられるじゃないですか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "責任は俺が取る",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何だこの危なっかしい現場はやってらんねえよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっあのちょっと…もういい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ラグビー準備しろえっ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "三田村衣装取ってこいはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前がやるんだ男優を準備しろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっす",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいかみく本番っていうのはな世界じゃ普通なんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "偽物のセックスなんか撮ってもしょうがないんだ俺は",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "強制はしないお前が決めろ",
      "gap": 0.9
    },
