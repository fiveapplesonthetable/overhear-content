    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "盛り上がっていこうぜ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みく今日もキマってるねそうかな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえかわいい！かわいい！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえねえこのティファニーって―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "最近よく雑誌で紹介されてるやつだよね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "たぶんたぶんそうかな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "欲しい！えーかわいい！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "めっちゃ似合ってるよね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "失礼します",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいこれ君におごるよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いらない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すごくかわいいね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "みくは黒服とか相手にしないから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "似合ってるよこれすんごい似合ってる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっこの時計も？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "順子さんお願いしますはいありがと",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何か手伝います？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あ～中のさゴミ…あっはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "これいつになったらカラミ始まんだよこれ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女優を美しい世界観で際立たせて見せるのが―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ポセイドン企画のやり方なんです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女優の質は圧倒的だなあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "作品の質は低いですけどね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お姉ちゃんはかわいいなあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "かわいかろうが何だろうが表情が死んでる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "これじゃダッチワイフと変わらない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえ私かわいい？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "かわいいよ",
      "gap": 0.9
