  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 4.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "おっさんよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなに落ち込んでてもしかたねえだろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺たちは止まれねえんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあとりあえず撮ってかねえとな？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうですよ明日も撮影ですしね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かってる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "村西さん大変だどうしました？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "次の撮影に来るはずだった女優がいきなりキャンセルになりました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっバックレか？いや",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それが違うみたいなんです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフッリーチ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ほうここで来たかねフフッ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "悪いな古谷これはもうあがる予感しかねえや",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "油断は禁物俺だって張ってるかもしれねえぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあせいぜい気をつけろよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そっちこそ村西には気をつけたほうがいい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "視界に入ってこないもんどう気をつけりゃあいい？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっかい出されて怒ったんだろ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ルールを破った女優を消しただけだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ほうならいいが",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あれはあれで侮れねえ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "思いも寄らぬ発想をするし肝も太い",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "なかなかやっかいだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "くだらねえこと言うなよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "万が一問題が出たとしても―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前さんが何とかしてくれるんだろ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあ俺のシマで飼ってるからな自由自在だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フン",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そのかわりいろいろと便宜を頼みますよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ポルノ王さん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かってるよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ロン！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よしまたやっちまったか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "倍満だ見てみろはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハッハッハッ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今までどおり持ちつ持たれつだハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "古谷お前もひとつどうだ？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
