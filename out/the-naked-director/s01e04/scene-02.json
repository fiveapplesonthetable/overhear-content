    {
      "v": "muranishi",
      "t": "で？今日何の用？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああついにうちの作品が店頭に並ぶ日なんで―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何かいても立ってもいられなくなっちゃってね？",
