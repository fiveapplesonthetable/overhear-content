      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ん？いやそんな上じゃないよ下下下下",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと下もっと下もっと下え～で右ずっと行って右右…",
