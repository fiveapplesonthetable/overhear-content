    },
    {
      "v": "muranishi",
      "t": "夜逃げしようとしてたオヤジから安く買い上げたんだよおい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今日からうちで兵隊になる２人だはい挨拶",
