    {
      "v": "narrator",
      "t": "Welcome to episode three.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "ようおっさん先に出て悪かったな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあ大差ねえだろ？まあな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃいくかよし",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おい次は何やるんだよ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あ？俺たちがやるって言ったら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "エロに決まってんだろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうですかね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ違うアングルでもう少しパターンが欲しいです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ほう違うアングル？ええ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "う～んじゃあ奴隷つるしてみます？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あの…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "僕明日から社員旅行なんでロープの痕つくとちょっと",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あそうかお風呂でバレちゃうかあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃあ低温ロウソクでやろっか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "つるさないの？あいいです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すいません奴隷なのにいいのいいの",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "早く終わらせて飲みにいこうよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうしてここに？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ご無沙汰してます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやあ出てきたんですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何撮ってんだよ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ「ＳＭアイズ」の編集です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ＳＭっぽいの似合いますねはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この仕事辞めてもらえますか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ええもちろんです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "で何をするんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "次は東京へ行くんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "東京？ああ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "行きましょう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやあ面白そうだ",
      "gap": 0.9
    },
