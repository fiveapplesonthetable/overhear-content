      "t": "ああ、違うアングルでもう少しパターンが欲しいです。",
      "gap": 0.55
    },
    {
      "v": "kawada",
      "t": "どうしてここに？ご無沙汰してます。出てきたんですね。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "何撮ってんだよ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この仕事、辞めてもらえますか？",
      "gap": 0.55
    },
