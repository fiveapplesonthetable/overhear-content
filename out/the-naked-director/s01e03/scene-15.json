      "v": "muranishi",
      "t": "お前らみたいな凶悪な前科もんは―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "きっちり監視しとかないと",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "世間がいろいろうるせえんだよハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いちゃもんつけてんじゃねえよ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "息臭えから口閉じてろパンチ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "てめえもパンチだろうがよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おめえのと違えんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こっちはいいコテ使ってんだよおめえ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おめえのカール全然効いてねえじゃ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "効かせてねえんだよえ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "三振！おい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ＰＬよ！何やってんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "野球賭博かいい度胸してんなおい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "四六時中見張られてると思っとけよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "誰だ？お前",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私が社長ですので何かあったら私にお願いします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何だと？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "次ここに入りたい時は",
