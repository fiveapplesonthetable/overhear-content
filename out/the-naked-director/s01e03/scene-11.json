      {
        "line": 0,
        "cue": 302,
        "fragment": "‎（川田） ‎やはり村西さんが 社長には ‎ふさわしいんじゃないかと"
      },
      {
        "line": 1,
        "cue": 303,
        "fragment": "‎（村西）川田さんが適任です"
      },
      {
        "line": 2,
        "cue": 304,
        "fragment": "‎（トシ） ‎前科もんよりは信用あるからな"
      },
      {
        "line": 3,
        "cue": 305,
        "fragment": "‎（川田）分かりました ‎やるからには責任持ってやります"
      },
      {
        "line": 4,
        "cue": 306,
        "fragment": "‎（村西）お願いします"
      },
      {
        "line": 5,
        "cue": 307,
        "fragment": "‎（トシ）でもよ おっさん ‎ビニ本の時は よかったけどよ"
      },
      {
        "line": 6,
        "cue": 308,
        "fragment": "‎アダルトビデオっつうのは ‎もう業界が出来上がっちまってんぞ"
      },
      {
        "line": 7,
        "cue": 309,
        "fragment": "‎（村西）革命だよ 革命 ‎ひっくり返すんだよ"
      },
      {
        "line": 8,
        "cue": 310,
        "fragment": "‎（川田）革命かあ"
      },
      {
        "line": 9,
        "cue": 311,
        "fragment": "‎（トシ） ‎エロ本屋からエロビデオ屋か"
      },
      {
        "line": 10,
        "cue": 312,
        "fragment": "‎（‎古谷(ふるや)‎）よう ‎（トシ）あっ"
      },
      {
        "line": 11,
        "cue": 313,
        "fragment": "‎ああ 誰かと思いましたよ"
      },
      {
        "line": 12,
        "cue": 314,
        "fragment": "‎（古谷）見た目の割には ‎広くて いいとこだろ？"
      },
      {
        "line": 13,
        "cue": 315,
        "fragment": "‎（村西）いい物件 回してもらって ‎ありがとうございます"
      },
      {
        "line": 14,
        "cue": 316,
        "fragment": "‎（古谷）いいんだよ"
      },
      {
        "line": 15,
        "cue": 317,
        "fragment": "‎お前たちの裏本には ‎さんざん稼がせてもらったからな"
      },
      {
        "line": 16,
        "cue": 318,
        "fragment": "‎（トシ）ヘヘヘヘ…"
      },
      {
        "line": 17,
        "cue": 319,
        "fragment": "‎いやあ あんなしょぼくれた ‎ヤクザだったのに"
      },
      {
        "line": 18,
        "cue": 320,
        "fragment": "‎よく返り咲いたよなあ"
      },
      {
        "line": 19,
        "cue": 321,
        "fragment": "‎（‎藤原(ふじわら)‎）おい 口の利き方 考えろよ"
      },
      {
        "line": 20,
        "cue": 322,
        "fragment": "‎（古谷）いいよ いいよ ‎それより それ渡しておけ"
      },
      {
        "line": 21,
        "cue": 323,
        "fragment": "‎（トシ）何すか？　これ"
      },
      {
        "line": 22,
        "cue": 324,
        "fragment": "‎（藤原）‎歌舞伎町(かぶきちょう)‎の縄張り図だよ"
      },
      {
        "line": 23,
        "cue": 325,
        "fragment": "‎（トシ）ん？"
      },
      {
        "line": 24,
        "cue": 326,
        "fragment": "‎さっさと覚えないと ‎うっかり迷いこんで‎―"
      },
      {
        "line": 25,
        "cue": 327,
        "fragment": "‎見たくもねえもん見ることになるぞ"
      },
      {
        "line": 26,
        "cue": 328,
        "fragment": "‎まずは これで ‎何かうまいもんでも食いな"
      },
      {
        "line": 27,
        "cue": 329,
        "fragment": "‎遠慮なく頂きます！"
      },
      {
        "line": 28,
        "cue": 330,
        "fragment": "‎（川田）ちょっと… ダメだよ ‎（トシ）ハハハハ…"
      },
      {
        "line": 29,
        "cue": 331,
        "fragment": "‎困ったことあったら ‎何でも言ってきな"
      },
      {
        "line": 30,
        "cue": 332,
        "fragment": "‎（トシ）おお すっげえな これ"
      },
      {
        "line": 31,
        "cue": 333,
        "fragment": "‎（ネズミの鳴き声） ‎（トシ）何だよ これ！"
      }
    ]
