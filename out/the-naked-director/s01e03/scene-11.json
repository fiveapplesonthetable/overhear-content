  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode three.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "やはり村西さんが社長にはふさわしいんじゃないかと",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "川田さんが適任です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "前科もんよりは信用あるからな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりましたやるからには責任持ってやります",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お願いします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でもよおっさんビニ本の時はよかったけどよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "アダルトビデオっつうのはもう業界が出来上がっちまってんぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "革命だよ革命ひっくり返すんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "革命かあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "エロ本屋からエロビデオ屋か",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ようあっ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ誰かと思いましたよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "見た目の割には広くていいとこだろ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いい物件回してもらってありがとうございます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前たちの裏本にはさんざん稼がせてもらったからな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ヘヘヘヘ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやああんなしょぼくれたヤクザだったのに",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よく返り咲いたよなあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おい口の利き方考えろよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいよいいよそれよりそれ渡しておけ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何すか？これ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "歌舞伎町の縄張り図だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "さっさと覚えないとうっかり迷いこんで―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "見たくもねえもん見ることになるぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まずはこれで何かうまいもんでも食いな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "遠慮なく頂きます！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと…ダメだよハハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "困ったことあったら何でも言ってきな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おおすっげえなこれ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何だよこれ！",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
