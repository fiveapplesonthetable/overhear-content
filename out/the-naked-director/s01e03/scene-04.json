    },
    {
      "v": "muranishi",
      "t": "村西！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "皆さま札幌ツアーへようこそお越しくださいました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本日わたくし添乗を担当させていただく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "北村康子と申しますよろしくお願いいたします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "兄ちゃん兄ちゃんこれ違うばい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ここは俺らの席ばいああ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "バス間違えたやなかね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちゃんと見てああ？ちゃんと見てるよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ずーっと疑問なことがあってな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しょう油という最高のダシがあるのに―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何でそれ以外のラーメンが必要なんだ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺はあのみそラーメンていうのが苦手でなあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "小さなものがいつしかメジャーになることもあります",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "てめえ何すんだ…うっぐぐっああ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっぐあっ…立ておい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "長えホントかくれんぼしやがって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "協力ありがとさん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "てめえら裏切りやがってよ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいから乗れ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前も乗れ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "人のありのままの姿撮ってわいせつなんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいか教えてやるよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "わいせつだからわいせつ物ってことじゃねえんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お国がわいせつに指定したものはすべてわいせつになるってことさ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "乗れ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい車通るよ",
      "gap": 0.9
    },
