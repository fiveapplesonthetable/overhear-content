      },
      {
        "line": 45,
        "cue": 479,
        "fragment": "‎よーし 止まれ"
      },
      {
        "line": 46,
        "cue": 480,
        "fragment": "‎（‎奈緒子(なおこ)‎）サンキュー"
      },
      {
        "line": 47,
        "cue": 481,
        "fragment": "‎バイビー ん～っ"
      },
      {
        "line": 48,
        "cue": 482,
