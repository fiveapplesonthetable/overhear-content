    "lines": [
      {
        "line": 0,
        "cue": 434,
        "fragment": "‎（‎順子(じゅんこ)‎）はい オーケーです ‎そこに かたくり粉 入れて"
      },
      {
        "line": 1,
        "cue": 435,
        "fragment": "‎（三田村）あっ はい かたくり粉…"
      },
      {
        "line": 2,
        "cue": 436,
        "fragment": "‎（順子）あっ ‎入れすぎないように注意して"
      },
      {
        "line": 3,
        "cue": 437,
        "fragment": "‎（三田村）はい"
      },
      {
        "line": 4,
        "cue": 438,
        "fragment": "‎（順子）あとは黄味で ‎色合いの微調整してください"
      },
      {
        "line": 5,
        "cue": 439,
        "fragment": "‎（三田村）はい"
      },
      {
        "line": 6,
        "cue": 440,
        "fragment": "‎（後藤）すいません ‎前貼り これでいいっすか？"
      },
      {
        "line": 7,
        "cue": 441,
        "fragment": "‎（順子）前貼りは3.5センチ以内で ‎大丈夫です"
      },
      {
        "line": 8,
        "cue": 442,
        "fragment": "‎ギリギリ隠れればいいんで"
      },
      {
        "line": 9,
        "cue": 443,
        "fragment": "‎（後藤）オーケー"
      },
      {
        "line": 10,
        "cue": 444,
        "fragment": "‎（順子）ほら かわいくなった ‎メークは女の子の特権だよね"
      },
      {
        "line": 11,
        "cue": 445,
        "fragment": "‎できました　確認お願いします"
      },
      {
        "line": 12,
        "cue": 446,
        "fragment": "‎はい ありがとうございます はい"
      },
      {
        "line": 13,
        "cue": 447,
        "fragment": "‎（順子）じゃ これ 付けてください ‎（男優）はーい"
      },
      {
        "line": 14,
        "cue": 448,
        "fragment": "‎（男優）はい 付けました ‎（順子）はい"
      },
      {
        "line": 15,
        "cue": 449,
        "fragment": "‎じゃ これ 前で 付けてください"
      },
      {
        "line": 16,
        "cue": 450,
        "fragment": "‎（男優）はい ‎（順子）はい 引っ張ります"
      },
      {
        "line": 17,
        "cue": 451,
        "fragment": "‎（男優）はーい"
      },
      {
        "line": 18,
        "cue": 452,
        "fragment": "‎（順子）よいしょ はい オーケー ‎これ 前に貼ってください"
      },
      {
        "line": 19,
        "cue": 453,
        "fragment": "‎（男優）はい"
      },
      {
        "line": 20,
        "cue": 454,
        "fragment": "‎（後藤）すげえ"
      },
      {
        "line": 21,
        "cue": 455,
        "fragment": "‎おおっ"
      },
      {
        "line": 22,
        "cue": 456,
        "fragment": "‎俺たちが見てたのは ‎偽もんだったんすね"
      },
      {
        "line": 23,
        "cue": 457,
        "fragment": "‎（順子） ‎当たり前でしょ　精液は偽物"
      },
      {
        "line": 24,
        "cue": 458,
        "fragment": "‎（三田村）これでいいですか？ ‎（順子）はい オーケーです"
      },
      {
        "line": 25,
        "cue": 459,
        "fragment": "‎性器は前貼りで隠す ‎擬似本番の常識です"
      },
      {
        "line": 26,
        "cue": 460,
        "fragment": "‎はい 見せて　はい 出来上がり！"
      },
      {
        "line": 27,
        "cue": 461,
        "fragment": "‎（聖美）やっぱ やだ ‎いやらしいビデオなんか出たくない"
      },
      {
        "line": 28,
        "cue": 462,
        "fragment": "‎（マネジャー）ハハハッ…"
      },
      {
        "line": 29,
        "cue": 463,
        "fragment": "‎（マネジャー） ‎おい スタッフさんが ‎スタンバイしてんだよ"
      },
      {
        "line": 30,
        "cue": 464,
        "fragment": "‎（マネジャー）さっさとしろや ‎（聖美）やだ"
      },
      {
        "line": 31,
        "cue": 465,
        "fragment": "‎てめえ 賠償金 払えんのか こら"
      },
      {
        "line": 32,
        "cue": 466,
        "fragment": "‎ちょっと 女の子に ‎そんな威圧的な言い方しないで"
      },
      {
        "line": 33,
        "cue": 467,
        "fragment": "‎（助監督）余計な口出しすんなよ ‎そちらさんの問題なんだからよ"
      },
      {
        "line": 34,
        "cue": 468,
        "fragment": "‎（順子）撮影に影響が出ますよ"
      },
      {
        "line": 35,
        "cue": 469,
        "fragment": "‎（カメラマン） ‎ほら たかがエロビデオでしょう？"
      },
      {
        "line": 36,
        "cue": 470,
        "fragment": "‎こっちは本編の撮影が ‎流れてきただけなんでね"
      },
      {
        "line": 37,
        "cue": 471,
        "fragment": "‎もうさっさとね 終わらせましょ ‎こんな仕事"
      },
      {
        "line": 38,
        "cue": 472,
        "fragment": "‎行きましょう 行きましょう"
      },
      {
        "line": 39,
        "cue": 473,
        "fragment": "‎ハァ…"
      },
      {
        "line": 40,
        "cue": 474,
        "fragment": "‎（助監督） ‎しかし ひでえな この… ‎作文か これ？"
