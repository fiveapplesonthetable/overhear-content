{
  "schemaVersion": 1,
  "id": "the-naked-director-s01e03-scene-05",
  "pair": "ja-en",
  "title": "Scene 5  (Scene 5)",
  "level": "A1 — beginner",
  "labels": {
    "muranishi": "村西"
  },
  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode three.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "このバカ息子！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "殺してくんちぇ！死刑にしてくんちぇ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "死んだら困るぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おめえの金がねえと生きてけねえかんな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お母さん大丈夫ですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おめえとはもう親子じゃねえ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "真由美も大輔も私が育てっから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "このバカが！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "んん…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "１回出ましょう大丈夫です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うううっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと左上がりで",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "輪っかも左を大きくだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "左手の角度がまるで違うじゃないか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それが命だろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "その手の向き１つで意味が大きく変わるんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "平田はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やっぱりシーツを変えろ色が違う",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "左手は淫部を隠してるんじゃなくて",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "指先で秘所を弄んでるんだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "小指の宝石には",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "硬質な物で逆に女性の柔らかさを強調するという狙いがある",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かるか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりますハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "右手に持つバラは永遠の愛と忠誠という意味だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "手の角度も物の位置も構図もすべて…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すべて計算され尽くして描かれている",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そこに美の答えが詰まってるんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ご来訪のお客様がお待ちですが",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいからしばらく待たせておけ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "社長西口専務ですがよろしいんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいから待たせておけっつうの",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やっあっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっすみませんどうぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとうございますお気遣いいただいて",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うちの社員に実家がお茶農家の子がいましてね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "親御さんが毎年送ってきてこれがなかなかうまいんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうぞあっ失礼します",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いただきます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああこれは確かにおいしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "最近はお茶農家も競争が厳しいみたいでね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "我々家電メーカーも同じです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ベータとの規格戦争も佳境に来ました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "我が社の命運は池沢社長あなたにかかっています",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハッそんな大げさな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おいあっはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "失礼します",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "返していただく必要はありません",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "東京電産がビデオ戦争に勝てるようお力をお貸しください！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よろしくお願いいたします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "確かにエロ本はもう古い",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おいはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ビデオデッキを購入した客に無料でプレゼントしてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うちの最初の作品です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "これはね…いいですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "西口さんはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "予言しときますよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたたちはいずれビデオ市場を独占できる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私が作るアダルトビデオのおかげでね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハハ…ありがとうございます！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ありがとうございます！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフフハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "札幌防災交通課札幌警察署…",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "殺してくんちぇ！死刑にしてくんちぇ！",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Notice the expression here.'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
      "gap": 0.75
