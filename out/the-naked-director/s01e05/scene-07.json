    "lines": [
      {
        "line": 0,
        "cue": 106,
        "fragment": "‎じゃあ 何だ 仮に女優が 見つかったとしてもよ―"
      },
      {
        "line": 1,
        "cue": 107,
        "fragment": "‎その何とか委員会っていうのが 許可しねえと―"
      },
      {
        "line": 2,
        "cue": 108,
        "fragment": "‎販売できねえってことか"
      },
      {
        "line": 3,
        "cue": 109,
        "fragment": "‎まあ そういうことになります"
      },
      {
        "line": 4,
        "cue": 110,
        "fragment": "‎（後藤(ごとう)）えっ それ ヤバくないっすか？"
      },
      {
        "line": 5,
        "cue": 111,
        "fragment": "‎（三田村(みたむら)）そしたら どうやって 生きていくんですか？　僕たち"
      },
      {
        "line": 6,
        "cue": 112,
        "fragment": "‎（村西）八方塞がりだな"
      },
      {
        "line": 7,
        "cue": 113,
        "fragment": "‎（三田村）ガビーン （順子）よいしょ"
      },
      {
        "line": 8,
        "cue": 114,
        "fragment": "‎（トシ）おい 順子 遅いよ お前な―"
      },
      {
        "line": 9,
        "cue": 115,
        "fragment": "‎俺 口の中の水分が 全部 乾いちゃってんだよ…"
      },
      {
        "line": 10,
        "cue": 116,
        "fragment": "‎ちょっと 誰だ？　あのお嬢さん"
      },
      {
        "line": 11,
        "cue": 117,
        "fragment": "‎（順子）さあ… 監督に会いたいんだって"
      },
      {
        "line": 12,
        "cue": 118,
        "fragment": "‎（トシ）ふーん"
      },
      {
        "line": 13,
        "cue": 119,
        "fragment": "‎（川田）お知り合いですか？ （村西）いや"
      },
      {
        "line": 14,
        "cue": 120,
        "fragment": "‎（三田村）あっ うちで スタッフやりたいとか？"
      },
      {
        "line": 15,
        "cue": 121,
        "fragment": "‎（恵美） はい あの お話を聞きたくって"
      },
      {
        "line": 16,
        "cue": 122,
        "fragment": "‎（トシ）ああ もうやめときなって"
      },
      {
        "line": 17,
        "cue": 123,
        "fragment": "‎君みたいなね 真面目なお嬢さんがね―"
      },
      {
        "line": 18,
        "cue": 124,
        "fragment": "‎いられるとこじゃないのよ"
      },
      {
        "line": 19,
        "cue": 125,
        "fragment": "‎見て こういうヤツが 働いてるとこだから"
      },
      {
        "line": 20,
        "cue": 126,
        "fragment": "‎（順子）それ どういう意味よ （トシ）そのまんまだよ"
      },
      {
        "line": 21,
        "cue": 127,
        "fragment": "‎（順子）映像のお仕事が やりたいんだよね？"
      },
      {
        "line": 22,
        "cue": 128,
        "fragment": "‎（恵美）そうです"
      },
      {
        "line": 23,
        "cue": 129,
        "fragment": "‎（順子）照明？　録音？"
      },
      {
        "line": 24,
        "cue": 130,
        "fragment": "‎（後藤）ん～ 女の子だから メークかな？"
      },
      {
        "line": 25,
        "cue": 131,
        "fragment": "‎（恵美）あの 出演を…"
      },
      {
        "line": 26,
        "cue": 132,
        "fragment": "‎あの… 出演させてほしいんです アダルトビデオに"
      },
      {
        "line": 27,
        "cue": 133,
        "fragment": "‎（トシ）えっ？"
      },
      {
        "line": 28,
        "cue": 134,
        "fragment": "‎ああ いいんじゃねえの？"
      },
      {
        "line": 29,
        "cue": 135,
        "fragment": "‎俺らにとっては 救いの女神みてえなもんだろ な？"
      },
      {
        "line": 30,
        "cue": 136,
        "fragment": "‎（川田）確かに… そうですね"
      },
      {
        "line": 31,
        "cue": 137,
        "fragment": "‎（村西）とりあえず座って 一緒にごはん食べよう"
      },
      {
        "line": 32,
        "cue": 138,
        "fragment": "‎飯だ 飯 腹ごしらえだ"
      },
      {
        "line": 33,
        "cue": 139,
        "fragment": "‎君が出演するかどうかは その後 面接して決めればいいから"
      },
      {
        "line": 34,
        "cue": 140,
        "fragment": "‎（後藤）どうぞ どうぞ"
      },
      {
        "line": 35,
        "cue": 141,
        "fragment": "‎あの じゃあ 手を洗ってきます"
      },
      {
        "line": 36,
        "cue": 142,
        "fragment": "‎（村西）いいんだよ そんなの 冷める前に どんどん食べないと"
      },
      {
        "line": 37,
        "cue": 143,
        "fragment": "‎（順子）ほい 頂き！ （後藤）ちょ… 順子さん"
      },
      {
        "line": 38,
        "cue": 144,
        "fragment": "‎（後藤）ファウルですよ （トシ）お前 いじきたねえな…"
      },
      {
        "line": 39,
        "cue": 145,
        "fragment": "‎（村西）なくなっちゃうから"
      },
      {
        "line": 40,
        "cue": 146,
        "fragment": "‎（順子）まだ食べてないんだもん… （村西）焼き鳥は？"
      },
      {
        "line": 41,
        "cue": 147,
        "fragment": "‎（順子）はい"
      },
      {
        "line": 42,
        "cue": 148,
        "fragment": "‎変なとこでしょ？ 食べて食べて ねっ"
      },
      {
        "line": 43,
        "cue": 149,
        "fragment": "‎ねえ ソースは？　失礼でしょ"
      },
      {
        "line": 44,
        "cue": 150,
        "fragment": "‎あっ 焼き鳥うまい！"
      },
      {
        "line": 45,
