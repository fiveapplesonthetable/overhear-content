  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 5.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "あっすいません今日は帰りますわ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハッまだ早いか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本作のモザイクは当委員会の規定より―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "薄くなっています",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すべて自主回収して規定に沿って作り直してください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなの現実的に不可能です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "従わない場合当委員会へ加盟できなくなりますが",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "願ったりかなったりです誰も入りたいなんて言ってない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ではお宅の作品の流通をすべてストップさせていただきます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お好きにどうぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "失礼します",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何なんだこの意味の分かんない会議は",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ええ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ただほとんどの業者が加盟しているのも事実です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今後は彼らの主張が業界の主軸になってくでしょうね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ふざけてるな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "女優が使えないうえ販売ルートまで封鎖か",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "資金面はどうなってますか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "厳しい状態です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうしたの？心配したのよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "友達のうちに泊まってました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと待ってちゃんと説明してどうして連絡しなかったの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お母さん私安心したの",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "自分だけ変なのかなってずっと思ってたけど―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私お母さんに似てたんですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何の話してるの？ちょっと！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと待ちなさい！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "恵美",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ずっとおかしいと思ってました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何で父親がいないのにこんな立派な暮らしができるのかなって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でもずっと聞けなくって",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
