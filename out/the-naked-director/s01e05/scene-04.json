    "lines": [
      {
        "line": 0,
        "cue": 55,
        "fragment": "‎（トシ）あっ すいません 今日は帰りますわ"
      },
      {
        "line": 1,
        "cue": 56,
        "fragment": "‎（古谷）ハハッ まだ早いか"
      },
      {
        "line": 2,
        "cue": 58,
        "fragment": "‎（委員）本作のモザイクは 当委員会の規定より―"
      },
      {
        "line": 3,
        "cue": 59,
        "fragment": "‎薄くなっています"
      },
      {
        "line": 4,
        "cue": 60,
        "fragment": "‎すべて自主回収して 規定に沿って作り直してください"
      },
      {
        "line": 5,
        "cue": 61,
        "fragment": "‎（川田）そんなの 現実的に不可能です"
      },
      {
        "line": 6,
        "cue": 62,
        "fragment": "‎（委員）従わない場合 当委員会へ加盟できなくなりますが"
      },
      {
        "line": 7,
        "cue": 63,
        "fragment": "‎（村西(むらにし)）願ったりかなったりです 誰も入りたいなんて言ってない"
      },
      {
        "line": 8,
        "cue": 64,
        "fragment": "‎（委員）では お宅の作品の流通を すべてストップさせていただきます"
      },
      {
        "line": 9,
        "cue": 65,
        "fragment": "‎お好きにどうぞ"
      },
      {
        "line": 10,
        "cue": 66,
        "fragment": "‎（川田）失礼します"
      },
      {
        "line": 11,
        "cue": 67,
        "fragment": "‎（村西）何なんだ この意味の分かんない会議は"
      },
      {
        "line": 12,
        "cue": 68,
        "fragment": "‎（川田）ええ"
      },
      {
        "line": 13,
        "cue": 69,
        "fragment": "‎ただ ほとんどの業者が 加盟しているのも事実です"
      },
      {
        "line": 14,
        "cue": 70,
        "fragment": "‎今後は 彼らの主張が 業界の主軸になってくでしょうね"
      },
      {
        "line": 15,
        "cue": 71,
        "fragment": "‎ふざけてるな"
      },
      {
        "line": 16,
        "cue": 72,
        "fragment": "‎（川田）女優が使えないうえ 販売ルートまで封鎖か"
      },
      {
        "line": 17,
        "cue": 73,
        "fragment": "‎（村西） 資金面は どうなってますか？"
      },
      {
        "line": 18,
        "cue": 74,
        "fragment": "‎（川田）厳しい状態です"
      },
      {
        "line": 19,
        "cue": 75,
        "fragment": "‎（加代(かよ)） どうしたの？　心配したのよ"
      },
      {
        "line": 20,
        "cue": 76,
        "fragment": "‎（恵美） 友達のうちに泊まってました"
      },
      {
        "line": 21,
        "cue": 77,
        "fragment": "‎ちょっと待って ちゃんと説明して どうして連絡しなかったの？"
      },
      {
        "line": 22,
        "cue": 78,
        "fragment": "‎（恵美）お母さん 私 安心したの"
      },
      {
        "line": 23,
        "cue": 79,
        "fragment": "‎自分だけ変なのかなって ずっと思ってたけど―"
      },
      {
        "line": 24,
        "cue": 80,
        "fragment": "‎私 お母さんに似てたんですね"
      },
      {
        "line": 25,
        "cue": 81,
        "fragment": "‎（加代） 何の話 してるの？　ちょっと！"
      },
      {
        "line": 26,
        "cue": 82,
        "fragment": "‎ちょっと待ちなさい！"
      },
      {
        "line": 27,
        "cue": 83,
        "fragment": "‎恵美"
      },
      {
        "line": 28,
        "cue": 84,
        "fragment": "‎（恵美） ずっと おかしいと思ってました"
      },
      {
        "line": 29,
        "cue": 85,
        "fragment": "‎何で 父親がいないのに こんな 立派な暮らしができるのかなって"
      },
      {
        "line": 30,
        "cue": 86,
        "fragment": "‎でも ずっと聞けなくって"
      }
    ]
  },
