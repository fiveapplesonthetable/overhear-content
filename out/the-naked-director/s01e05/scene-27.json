    {
      "v": "muranishi",
      "t": "あの子だから撮れた作品ですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うんそれは間違いない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "村西さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こいつで勝負かけましょう",
