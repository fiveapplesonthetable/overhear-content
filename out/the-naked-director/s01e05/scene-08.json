      "t": "なぜビデオに出演したいの？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "イタリアに留学したくってその資金集めのために",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それと…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本当の自分でいたくなったから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本当の自分でいたいとは？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "自由で―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "奔放で―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もしかすると汚らしい自分です",
