      "v": "muranishi",
      "t": "横浜",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "家族の構成は？何人兄弟？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "１人だと思いますあと…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それから母と…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "父親がいるみたいですこの間知りました",
      "gap": 0.55
