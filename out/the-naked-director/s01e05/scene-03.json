    },
    {
      "v": "muranishi",
      "t": "要は余計にあんたがもうかるだけの話だろ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そっちもいい思いができるんだ",
      "gap": 0.55
