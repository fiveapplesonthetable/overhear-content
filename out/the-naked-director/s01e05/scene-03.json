    {
      "v": "muranishi",
      "t": "ハハハッまあな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺は昔から―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ビジネスの邪魔をされんのが嫌いでなハハッ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やったのは池沢です",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何とかしてやりてえがな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あいつはポリも味方につけてる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うちが面倒に巻き込まれますよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いやおっさんと川田が前線で戦ってるんすよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺も何か力になりたい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "なあトシ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お前の気持ちも分かるが―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "表の世界を牛耳ってるのはな―",
