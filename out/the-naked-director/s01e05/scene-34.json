  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 5.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "村西さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今回ばかりは現実を見なきゃいけないかもしれません",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "川田さんね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "すばらしいアイデアを思いついたんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "アクションとエロスを融合させる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今まで誰も撮ったことない作品になりそうですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "村西さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかもそれをあそこで撮るんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ずっと看板見てるだけじゃつまらんでしょう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハワイで撮るんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかもこの女優を使って",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "一度は抜いたことがあるはずだかつてのポルノスターですからね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかも飛行機をばーっと飛ばして上空でセックスするんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハワイで世界のメジャーを目指すんです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もういいかげんにしてくれよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハワイ？飛行機？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "狂ったのか？誇大妄想にも程がある",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺は監督だ俺が撮りたいものを撮る",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "撮れるわけがないだろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "金は？かか…金は？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃあどうしますか！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "黒木君と作り上げたあのすばらしい作品も―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "バカどものせいで全部戻ってきた",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私たちは新しい作品を作るしかないんですよ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私だって残したいだから言ってるんです！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私は…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたに逆らったことはない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でもこれだけは言わせてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたが暴走するかぎり―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "このサファイア映像は間違いなくなくなる…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いい作品を作りさえすれば絶対に潰れやしない！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ただの現実逃避だ！違う！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やりたいようにやりゃあいいんだよ",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "村西さん",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Notice the expression here.'",
      "gap": 0.65
