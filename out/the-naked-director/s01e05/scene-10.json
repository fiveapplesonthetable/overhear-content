    {
      "v": "muranishi",
      "t": "この二つだけ守れば、あとは自由に感じたまま自分でやればいい。",
      "gap": 0.5
    },
    {
      "v": "kuroki",
      "t": "はい。",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "おじさん、ここに笛あるかい？笛！",
      "gap": 0.5
