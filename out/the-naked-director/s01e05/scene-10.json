      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "じいさん、ここに笛ねえか？早くしてくれよ！",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "はあ？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Armed with Muranishi's direction to keep her hands expressive and her eyes wide open, Kuroki awaits Toshi's bizarre last-minute find from an antique shop! See you next time!",
      "gap": 0.5
    },
    {
      "v": "kuroki",
      "t": "じゃあね。",
      "gap": 0.3
    }
