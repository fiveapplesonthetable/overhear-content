        "cue": 452,
        "fragment": "‎（トシ）どうも 旦那"
      },
      {
        "line": 15,
        "cue": 453,
        "fragment": "‎（和田(わだ)）おう"
      },
      {
        "line": 16,
        "cue": 454,
        "fragment": "‎（トシ）随分 もうかってるみたいじゃないっすか"
      },
      {
        "line": 17,
        "cue": 455,
        "fragment": "‎ハハハ…"
      },
      {
        "line": 18,
        "cue": 456,
        "fragment": "‎似合わないジャケットなんか 着ちゃって"
      },
      {
        "line": 19,
        "cue": 457,
        "fragment": "‎（和田）えっ？　フフッ （トシ）フフフッ…"
      },
      {
        "line": 20,
        "cue": 458,
        "fragment": "‎時代だよ"
      },
      {
        "line": 21,
        "cue": 459,
        "fragment": "‎何にもしてねえのに 店が勝手に増えてくんだからな"
      },
      {
        "line": 22,
        "cue": 460,
        "fragment": "‎（トシ）フフフ…"
      },
      {
        "line": 23,
        "cue": 461,
        "fragment": "‎おい ちょっと ヤニ行こうぜ"
      },
      {
        "line": 24,
        "cue": 462,
        "fragment": "‎（トシ）ああ"
      },
      {
        "line": 25,
        "cue": 463,
        "fragment": "‎（トシ）あれ？ （和田）ん？"
      },
      {
        "line": 26,
        "cue": 464,
        "fragment": "‎何か上品なもの 吸ってるじゃないっすか"
      },
      {
        "line": 27,
        "cue": 465,
        "fragment": "‎うるせえな いちいち お前は"
      },
      {
        "line": 28,
        "cue": 466,
        "fragment": "‎（トシ）ちょっと１本 下さいよ （和田）はい"
      },
      {
        "line": 29,
        "cue": 467,
        "fragment": "‎そんなことより 次の作品 どうなってんだ？"
      },
      {
        "line": 30,
        "cue": 468,
        "fragment": "‎まだ 規制委員会と モメてんのか？"
      },
      {
        "line": 31,
        "cue": 469,
        "fragment": "‎（トシ）そうなんすよ （和田）ふーん"
      },
      {
        "line": 32,
        "cue": 470,
        "fragment": "‎俺は サファイアのファンだからな"
      },
      {
        "line": 33,
        "cue": 472,
        "fragment": "‎（和田）よいしょ"
      },
      {
        "line": 34,
        "cue": 473,
        "fragment": "‎ういっす"
      },
      {
        "line": 35,
        "cue": 474,
        "fragment": "‎（トシ）どうも どうも （店主）いらっしゃい"
      },
      {
        "line": 36,
        "cue": 475,
        "fragment": "‎委員会さえクリアすりゃ 今なら いくらでも店に置いてやるぞ"
      },
      {
        "line": 37,
        "cue": 476,
        "fragment": "‎あっ 今の 約束ですよ"
      },
      {
        "line": 38,
        "cue": 477,
        "fragment": "‎えっ？"
      },
      {
        "line": 39,
        "cue": 478,
        "fragment": "‎新作 できたのか？"
      },
      {
        "line": 40,
        "cue": 479,
        "fragment": "‎フフフ…"
      },
      {
        "line": 41,
        "cue": 480,
        "fragment": "‎（和田）おい おい はい… ビール１本な グラス２つ"
      },
      {
        "line": 42,
        "cue": 481,
        "fragment": "‎（店員）はい"
      },
      {
        "line": 43,
        "cue": 482,
        "fragment": "‎（委員）でもね 社長さん 川田さんだっけ？"
      },
      {
        "line": 44,
        "cue": 483,
        "fragment": "‎（川田）ええ どうぞ"
      },
      {
        "line": 45,
        "cue": 484,
        "fragment": "‎母親が こうやって 訴えてるんだから―"
      },
      {
        "line": 46,
        "cue": 485,
        "fragment": "‎撮影に何かしらの問題が あったんじゃないですか？"
      },
      {
        "line": 47,
        "cue": 486,
        "fragment": "‎（川田）こちらとしては 適切だったと認識しています"
      },
      {
        "line": 48,
        "cue": 487,
        "fragment": "‎（委員）面接に来た日に そのまま撮影したんですよね？"
      },
      {
        "line": 49,
        "cue": 488,
        "fragment": "‎それの どこが適切なんです？"
      },
      {
        "line": 50,
        "cue": 489,
        "fragment": "‎しかも 監督自ら 出演したそうじゃないですか"
      },
      {
        "line": 51,
        "cue": 490,
        "fragment": "‎ねえ？"
      },
      {
        "line": 52,
        "cue": 491,
        "fragment": "‎許せない"
      },
      {
        "line": 53,
        "cue": 492,
        "fragment": "‎大事に育ててきた娘が―"
      },
      {
        "line": 54,
        "cue": 493,
        "fragment": "‎どこの誰だか分からない男と みだらなことして―"
      },
      {
        "line": 55,
        "cue": 494,
        "fragment": "‎しかも その姿を 他人に見られるなんて！"
      },
      {
        "line": 56,
        "cue": 495,
        "fragment": "‎想像しただけでも 胸が張り裂けそうです"
      },
      {
        "line": 57,
        "cue": 496,
        "fragment": "‎あなたには この気持ち分からないんですか？"
      },
      {
        "line": 58,
        "cue": 497,
        "fragment": "‎（委員）まあ まあ"
      },
      {
        "line": 59,
        "cue": 498,
        "fragment": "‎（委員）今回の訴えを踏まえ 我が日本ビデオ規制委員会では―"
      },
      {
        "line": 60,
        "cue": 499,
        "fragment": "‎事実調査が終わるまで―"
      },
      {
        "line": 61,
        "cue": 500,
        "fragment": "‎この作品の販売を 見送ることにしました"
      },
      {
        "line": 62,
        "cue": 501,
        "fragment": "‎（川田）そんなバカな…"
      },
      {
        "line": 63,
        "cue": 502,
        "fragment": "‎そもそも 我々は 規制委員会に加盟していない！"
      },
      {
        "line": 64,
        "cue": 503,
        "fragment": "‎分かりました"
      },
      {
        "line": 65,
        "cue": 504,
        "fragment": "‎（川田）ちょっと待ってくださいよ それじゃ うちはどうするんですか"
      },
      {
        "line": 66,
        "cue": 505,
        "fragment": "‎作品は販売しません"
      },
      {
        "line": 67,
        "cue": 506,
        "fragment": "‎お母様 大変 申し訳ありませんでした"
      },
      {
        "line": 68,
        "cue": 507,
        "fragment": "‎勝手に決めないでください！"
      },
      {
        "line": 69,
        "cue": 508,
        "fragment": "‎（村西）今度は あなたが あの子を自由にしてあげてください"
      }
    ]
