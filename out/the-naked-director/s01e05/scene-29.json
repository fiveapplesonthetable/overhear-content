{
  "schemaVersion": 1,
  "id": "the-naked-director-s01e05-scene-29",
  "pair": "ja-en",
  "title": "Scene 29  (Scene 29)",
  "level": "A1 — beginner",
  "labels": {
    "muranishi": "村西"
  },
  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 5.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "娘はだまされたんです洗脳されたんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあまあまあお母様落ち着いてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうされました？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "私訴えますから絶対許しませんからね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりましたまあまあ落ち着いてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あの事実確認のほうをしましてこちらで―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかるべき対処をいたしますのでどうぞお掛けください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんな悠長なこと言ってないで―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "とにかくやめさせてください分かりましたから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あの子は私が守るんです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあまあそう興奮なさらずにね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうぞお掛けになってお話…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなた聞いてますか？分かりました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "とりあえず販売をやめさせて…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうも旦那",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "随分もうかってるみたいじゃないっすか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハハハ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "似合わないジャケットなんか着ちゃって",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？フフッフフフッ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "時代だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何にもしてねえのに店が勝手に増えてくんだからな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフフ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おいちょっとヤニ行こうぜ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あれ？ん？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "何か上品なもの吸ってるじゃないっすか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うるせえないちいちお前は",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと１本下さいよはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなことより次の作品どうなってんだ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まだ規制委員会とモメてんのか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうなんすよふーん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "俺はサファイアのファンだからな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よいしょ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ういっす",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どうもどうもいらっしゃい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "委員会さえクリアすりゃ今ならいくらでも店に置いてやるぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あっ今の約束ですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "新作できたのか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "フフフ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おいおいはい…ビール１本なグラス２つ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でもね社長さん川田さんだっけ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ええどうぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "母親がこうやって訴えてるんだから―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "撮影に何かしらの問題があったんじゃないですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こちらとしては適切だったと認識しています",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "面接に来た日にそのまま撮影したんですよね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それのどこが適切なんです？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかも監督自ら出演したそうじゃないですか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ねえ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "許せない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大事に育ててきた娘が―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どこの誰だか分からない男とみだらなことして―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "しかもその姿を他人に見られるなんて！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "想像しただけでも胸が張り裂けそうです",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたにはこの気持ち分からないんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まあまあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今回の訴えを踏まえ我が日本ビデオ規制委員会では―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "事実調査が終わるまで―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この作品の販売を見送ることにしました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんなバカな…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そもそも我々は規制委員会に加盟していない！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっと待ってくださいよそれじゃうちはどうするんですか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "作品は販売しません",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "お母様大変申し訳ありませんでした",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "勝手に決めないでください！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今度はあなたがあの子を自由にしてあげてください",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "娘はだまされたんです洗脳されたんですよ",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Notice the expression here.'",
      "gap": 0.65
    },
    {
      "v": "narrator",
      "t": "Now let's listen to the whole conversation one last time.",
      "gap": 0.75
