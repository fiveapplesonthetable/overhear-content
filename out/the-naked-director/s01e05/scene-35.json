      {
        "line": 0,
        "cue": 591,
        "fragment": "‎ハワイでも何でも おっさんが 好きなようにやりゃいいんだよ"
      },
      {
        "line": 1,
        "cue": 592,
        "fragment": "‎あんたが ここの大将なんだからよ"
      },
      {
        "line": 2,
        "cue": 593,
        "fragment": "‎おめえは 参謀らしく 最後まで 大将 支えろよ"
      },
      {
        "line": 3,
        "cue": 594,
        "fragment": "‎分かりました"
      },
      {
        "line": 4,
        "cue": 595,
        "fragment": "‎でも 次 コケたら―"
      },
      {
        "line": 5,
        "cue": 596,
        "fragment": "‎それで この会社は おしまいですよ"
      },
      {
        "line": 6,
        "cue": 597,
        "fragment": "‎見ろよ"
      },
      {
        "line": 7,
        "cue": 598,
        "fragment": "‎青すぎんだろ あの空"
      },
      {
        "line": 8,
        "cue": 599,
        "fragment": "‎最高だよ"
      },
      {
        "line": 9,
        "cue": 600,
        "fragment": "‎（村西）こうやって ばーっと ハワイ上空に飛行機が入ってくる"
      },
      {
        "line": 10,
        "cue": 601,
        "fragment": "‎（三田村たち）おお～"
      },
      {
        "line": 11,
        "cue": 602,
        "fragment": "‎想像してみろ この飛行機の中に乗ってるのが―"
      },
      {
        "line": 12,
        "cue": 603,
        "fragment": "‎この女優だぞ"
      },
      {
        "line": 13,
        "cue": 604,
        "fragment": "‎ホントに そんなこと できるんですか？"
      },
      {
        "line": 14,
        "cue": 605,
        "fragment": "‎バカか 順子 この前の撮影のこと思い出してみろ"
      },
      {
        "line": 15,
        "cue": 606,
        "fragment": "‎今の俺たちに できないことはない"
      },
      {
        "line": 16,
        "cue": 607,
        "fragment": "‎（三田村）確かに いけそう"
      },
      {
        "line": 17,
        "cue": 608,
        "fragment": "‎（後藤）今の僕たちなら いけますよ 絶対に"
      },
      {
        "line": 18,
        "cue": 609,
        "fragment": "‎（トシ） おお じゃあ 頼んだよ お前ら"
      },
      {
        "line": 19,
        "cue": 610,
        "fragment": "‎（三田村）はい （トシ）なっ？"
      },
      {
        "line": 20,
        "cue": 611,
        "fragment": "‎よし 行くぞ ハワイに 作りたいものを作るんだ"
      },
      {
        "line": 21,
        "cue": 612,
        "fragment": "‎まだ 誰も やったことないものを撮って―"
      },
      {
        "line": 22,
        "cue": 613,
        "fragment": "‎世界で大ヒットする アダルトビデオを作るんだ"
      }
    ]
