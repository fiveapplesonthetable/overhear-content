    {
      "v": "narrator",
      "t": "Welcome to episode 5.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "ハワイでも何でもおっさんが好きなようにやりゃいいんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あんたがここの大将なんだからよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おめえは参謀らしく最後まで大将支えろよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "分かりました",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "でも次コケたら―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それでこの会社はおしまいですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "見ろよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "青すぎんだろあの空",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "最高だよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こうやってばーっとハワイ上空に飛行機が入ってくる",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おお～",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "想像してみろこの飛行機の中に乗ってるのが―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この女優だぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ホントにそんなことできるんですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "バカか順子この前の撮影のこと思い出してみろ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今の俺たちにできないことはない",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "確かにいけそう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今の僕たちならいけますよ絶対に",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おおじゃあ頼んだよお前ら",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいなっ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よし行くぞハワイに作りたいものを作るんだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まだ誰もやったことないものを撮って―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "世界で大ヒットするアダルトビデオを作るんだ",
      "gap": 0.9
    },
    {
