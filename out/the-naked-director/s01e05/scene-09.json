    {
      "v": "muranishi",
      "t": "目がダメなら耳だ。トシ、笛を買ってきてくれ。",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "は？笛？もうちょっと説明してくれよ、どんな笛だよ！",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "お前に任せるから、とにかく早く急いで用意してくれ。",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "もう分かったよ…笛…",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Declaring that creative ideas can leap over any rule made by fools—and that if the eyes are blocked, he will captivate the ears—Muranishi sends Toshi scrambling for a whistle! See you next time!",
      "gap": 0.5
    },
    {
      "v": "toshi",
      "t": "またね。",
      "gap": 0.3
    }
  ],
