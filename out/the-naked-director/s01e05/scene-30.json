        "line": 0,
        "cue": 509,
        "fragment": "‎何 言ってんの？"
      },
      {
        "line": 1,
        "cue": 510,
        "fragment": "‎（村西）お前らに従ったわけじゃ ないからな 勘違いすんなよ"
      },
      {
        "line": 2,
        "cue": 511,
        "fragment": "‎社長！"
      },
      {
        "line": 3,
        "cue": 512,
        "fragment": "‎お宅ら この先も どんどん追い込まれることになるぞ"
      },
      {
        "line": 4,
        "cue": 513,
        "fragment": "‎（トシ）よっ （委員）失礼します"
      },
      {
        "line": 5,
        "cue": 514,
        "fragment": "‎（トシ）何だよ あいつら"
      },
      {
        "line": 6,
        "cue": 515,
        "fragment": "‎おお～"
      },
      {
        "line": 7,
        "cue": 516,
        "fragment": "‎（三田村）トシさん トシさん ちょっと こっち…"
      },
      {
        "line": 8,
        "cue": 517,
        "fragment": "‎（三田村）ありがとうございます （配達員）はい まいど"
      },
      {
        "line": 9,
        "cue": 518,
        "fragment": "‎はい ありがとうございます"
      },
      {
        "line": 10,
        "cue": 519,
        "fragment": "‎（トシ）おい どうすんだよ"
      },
      {
        "line": 11,
        "cue": 520,
        "fragment": "‎全国の販売店から 返品 来ちまってんぞ"
      },
      {
        "line": 12,
        "cue": 521,
        "fragment": "‎（川田）規制委員会が 本腰を入れたってことですよ"
      },
      {
        "line": 13,
        "cue": 522,
        "fragment": "‎目の敵にされてるみたいだな"
      },
      {
        "line": 14,
        "cue": 523,
        "fragment": "‎（川田）えー これから先は―"
      },
      {
        "line": 15,
        "cue": 524,
        "fragment": "‎１円の売り上げも入らなくなる"
      },
      {
        "line": 16,
        "cue": 525,
        "fragment": "‎（トシ）はあ？"
      },
      {
        "line": 17,
        "cue": 526,
        "fragment": "‎んだよ 完全に閉め出し来てんだよ"
      },
      {
        "line": 18,
        "cue": 527,
        "fragment": "‎なあ あいつら 俺らの息の根 止めようとしてんだよ"
      },
      {
        "line": 19,
        "cue": 528,
        "fragment": "‎（川田） いよいよってとこまで来たな"
      },
      {
        "line": 20,
        "cue": 529,
        "fragment": "‎どうするんですか？"
      },
      {
        "line": 21,
        "cue": 530,
        "fragment": "‎（村西）少し考えます （トシ）あ？"
      }
