  "level": "A1 — beginner",
  "labels": {
    "muranishi": "村西"
  },
  "segments": [
    {
      "v": "narrator",
      "t": "Welcome to episode 5.",
      "gap": 0.8
    },
    {
      "v": "muranishi",
      "t": "お待たせしましたお待たせしすぎたのかもしれません",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "じゃあいきましょうか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よろしくお願いします",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "川田さん",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "村西さん…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "男優をやるってことですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "まずいですか？いえ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "監督自ら出ちゃっていいのかな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大丈夫ですよもともと人前でしゃべるのは得意ですから",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こう見えてわたくし英会話教材のセールスでトップだったんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "おっさんすまねえな",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハァ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こんなのしかなかったよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いびつな形だなあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "うっせえなお前これ探すの大変だったんだよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "トシあ？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "最高ださ…最高？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "本当？ハハッはいどうぞ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よっしゃあ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よしじゃあカメラを回していきましょう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "用意スタート！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この小道具を有効に使いたいと思います",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ちょっとお口にくわえてみてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああとてもセクシーなくわえ方だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "吹いてみてください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああいい音だ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もう１回",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "う～んセクシーだ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたにはまあまあ感じてきたなという時には―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "その笛を１回吹いていただきます",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと感じてきたなという時には２回",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もうこれはたまらないなという時には３回",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうですすばらしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "この笛を使うことによって見ている方が―",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたの感じ方の度合いを知ることができるんですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "よろしいですね？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいそこでどんなセックスをご希望でしょうか",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "荒々しくしてほしい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "荒々しくということですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "はいはい！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それではご希望どおり荒々しくしていきたいと思います",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それではご希望どおり荒々しくしていきたいと思います向こう回って早く",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "それではご希望どおり荒々しくしていきたいと思います",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こうですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ハァああ…そう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "このはり反ったお胸も触る時は荒々しく",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こうですか？ねえはい",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こんな邪魔なものは脱ぎ捨てましょう",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "あなたは生まれてきた時理性なんかなかった",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "獣だああ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああああっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そうですよどんどんいいんですよ",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "どんどん出してください自分を出してください",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああいいですね",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こうですか？こうですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああっハァ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいんですよいいんですよもっと強くですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "いいんですよいいんですよもっと強くですか？強く…強く…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっと荒々しくですか？強くああっ強く！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "荒々しいのが好きなんですねあなたは本当に",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "大好き！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "壊れちゃうんじゃないですか？",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こんなに荒々しくしてるとああ～っ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああっそれじゃ足りないの！あっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "ああっんんっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "こうですか？ああっそう…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もっともっと激しくして…ああっ！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "んんっ…ああっ…",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "笛がないわ",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
      "gap": 0.5
    },
    {
