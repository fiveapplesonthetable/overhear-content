    {
      "v": "narrator",
      "t": "Left breathless and awestruck when the marathon take finally wraps, Kawada declares they will not cut a single frame of Kuroki's astonishing debut. See you next time!",
      "gap": 0.5
    },
    {
      "v": "kawada",
      "t": "さようなら。",
      "gap": 0.3
