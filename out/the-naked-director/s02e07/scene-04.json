  "segments": [
    {
      "v": "narrator",
      "t": "While paramedics rush an unconscious Kuroki into the hospital emergency unit, Furuya and his deputy corner Muranishi in a back room and beat him over the final hundred million yen remaining on his loan.",
      "gap": 0.8
    },
    {
      "v": "fujiwara",
      "t": "めどが立たない？来週だと一割乗っかりますよ。",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "できねえってどういうことだ！ナメてんのか！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "もう少しで、年商は百億だったんです。",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "だからもう聞き飽きたんだよ、お前の自慢話は。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "荻原、あといくらだ？",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "あと一億弱です。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "ホントにもうどこにもないのか？",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "サヤカ、行こう。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "やめろ、待て！ある、ある、ある！",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "金はサファイア映像に、あそこにまだ金になるものがある。",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "黙れ、しゃべるな。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "荻原！最後に行かせてやれ。",
      "gap": 0.9
