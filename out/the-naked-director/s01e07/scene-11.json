    {
      "v": "narrator",
      "t": "Seeking underground distribution cash, Toshi follows crime boss Furuya into a dark Tokyo building, where Furuya punishes his own subordinate Fujiwara for stealing gang money and tests Toshi's nerve.",
      "gap": 0.8
    },
    {
      "v": "furuya",
      "t": "今日は何人だ？もう仕上がってるか？",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "はい、三人ほどです。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "おい、何の話だよ。",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "入れば分かる。",
      "gap": 0.55
    },
    {
      "v": "toshi",
      "t": "あの、何ですかこれ。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "ここはうちが買い取ったんだ。前に言ったろ、怖い地域があるって。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "どうだ、藤原。",
      "gap": 0.55
    },
    {
      "v": "fujiwara",
      "t": "いいと思います。",
      "gap": 0.55
    },
    {
      "v": "furuya",
      "t": "お前、組の上がりくすねてんだろ。謝れよ。",
      "gap": 0.55
    },
    {
