  "segments": [
    {
      "v": "narrator",
      "t": "Just one morning after celebrating his number-one trophy, Muranishi arrives at Bianca International to find police officers outside the building. Inside, his section chief points to the open metal safe: Ono has vanished with every yen of the company's money. Listen to everything come crashing down.",
      "gap": 0.8
    },
    {
      "v": "police",
      "t": "英語の百科事典の会社だってさ。",
      "gap": 0.55
    },
    {
      "v": "police",
      "t": "最近はやってるみたいだな。",
      "gap": 0.55
    },
    {
      "v": "police",
      "t": "ああ、そうみたいだな。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "課長、何かあったんですか？",
      "gap": 0.55
    },
    {
      "v": "kacho",
      "t": "大ありだよ。",
      "gap": 0.55
    },
    {
      "v": "kacho",
      "t": "会社の売上金が全部金庫から消えたんだよ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "えっ、全部ですか？",
      "gap": 0.55
    },
    {
      "v": "kacho",
      "t": "ほら、空っぽだよ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "小野さんはどこですか？",
      "gap": 0.55
    },
    {
      "v": "kacho",
      "t": "どこにもいないよ。会社は終わりだ。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "そんな、信じられません。",
      "gap": 0.55
    },
    {
      "v": "muranishi",
      "t": "今日はもう帰ります。",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Now let's go through it line by line with the English translation.",
