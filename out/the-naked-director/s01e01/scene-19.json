  },
  {
   "v": "muranishi",
   "t": "あった",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", happened.",
   "gap": 0.4
  },
  {
   "v": "kacho",
   "t": "大ありだよ。",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "\"'Something huge happened.' When someone asks if anything is wrong, \" Watch for ",
   "gap": 0.25
  },
  {
   "v": "kacho",
   "t": "大あり",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": ", literally 'big-exists!', answers 'you bet there is—big time!'",
   "gap": 0.4
  },
  {
   "v": "kacho",
   "t": "会社の売上金が全部金庫から消えたんだよ。",
   "gap": 0.55
  },
  {
   "v": "narrator",
   "t": "'All the company sales money disappeared from the safe.'  Hear how ",
   "gap": 0.25
  },
  {
   "v": "kacho",
   "t": "会社",
   "gap": 0.25
  },
  {
   "v": "narrator",
