      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Take away these expressions: the word for recommendations, the one for 'for example', and the phrase whenever you want to ask if it is okay to buy something. See you in scene fifteen.",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "ありがとうございます、また会いましょう。",
      "gap": 0.3
