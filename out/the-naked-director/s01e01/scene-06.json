    {
      "v": "muranishi",
      "t": "上司から期待されてるんだ。",
      "gap": 0.5
    },
    {
      "v": "kozue",
      "t": "家族を満足させないとだめだぞ。",
      "gap": 0.5
    },
    {
      "v": "muranishi",
      "t": "分かってるよ。",
      "gap": 0.5
