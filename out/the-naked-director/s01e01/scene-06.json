   "t": "おはよう。",
   "gap": 0.25
  },
  {
   "v": "narrator",
   "t": " stands on its own without the polite ending you use at work.",
   "gap": 0.4
  },
  {
   "v": "kozue",
   "t": "鼻歌なんかやめろ。",
   "gap": 0.55
  },
  {
