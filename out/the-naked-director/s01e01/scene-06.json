    {
      "v": "kozue",
      "t": "ほんとに大丈夫か？",
      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "The word for humming—literally a nose-song—is easy to picture and never forgotten, and phrases like 'of course' and 'I know' pop up constantly in family life. See you in the hallway next.",
      "gap": 0.5
    },
    {
      "v": "mayumi",
      "t": "またね。",
      "gap": 0.3
    }
