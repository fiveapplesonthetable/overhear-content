    },
    {
      "v": "fujiwara",
      "t": "お前、親父に苦労かけんなよ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Don't go causing headaches for the boss, got it.'",
      "gap": 0.45
    },
    {
