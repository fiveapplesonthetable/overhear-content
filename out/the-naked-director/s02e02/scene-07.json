    },
    {
      "v": "furuya",
      "t": "これ、持っとけ。飲みに行くぞ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Here, keep this cash on you. Come on, we're going for drinks.'",
