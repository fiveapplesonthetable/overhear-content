    },
    {
      "v": "keieisha",
      "t": "これは発明だわ。",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'This new concept is a real invention.'",
      "gap": 0.45
    },
    {
      "v": "kawada",
      "t": "本当にこれでいいんですかね？",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Do you really think going in this direction is all right?'",
      "gap": 0.45
