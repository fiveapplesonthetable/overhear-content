  "segments": [
    {
      "v": "narrator",
      "t": "Waiting in the car outside, Muranishi's young assistant fumes that big corporations are blind to the twenty-four-hour satellite future, right before guards toss a bruised Muranishi out the door.",
      "gap": 0.8
    },
    {
      "v": "student",
      "t": "ホントバカっすよね、大企業って。村西さんは完全に時代を先取ってるんです。",
      "gap": 0.55
    },
    {
      "v": "student",
      "t": "絶対に二十四時間エロを見られる時代は来るんですよ。",
      "gap": 0.55
    },
    {
      "v": "kacho",
      "t": "ああ、俺も同じかな。",
      "gap": 0.55
    },
    {
