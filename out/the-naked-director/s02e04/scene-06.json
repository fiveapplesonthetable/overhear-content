      "gap": 0.9
    },
    {
      "v": "narrator",
      "t": "Kuroki's quiet wisdom—that life's turning-point sign often arrives close to despair—leaves a deep impression on the young newcomer.",
      "gap": 0.5
    },
    {
      "v": "kuroki",
      "t": "また明日。",
      "gap": 0.3
    }
