      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Yes, but we have to talk.'",
      "gap": 0.45
    },
    {
      "v": "andrea",
      "t": "Pourquoi boire si tôt le matin?",
      "gap": 0.55
