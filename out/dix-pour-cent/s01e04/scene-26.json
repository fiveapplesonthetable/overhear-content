    {
      "v": "gabriel",
      "t": "Comme d'habitude.",
      "gap": 0.55
    },
    {
      "v": "andrea",
      "t": "Oh non! Regarde!",
      "gap": 0.55
    },
    {
      "v": "gabriel",
      "t": "Quoi? Qui est là?",
      "gap": 0.55
    },
    {
