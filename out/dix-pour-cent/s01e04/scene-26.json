    {
      "v": "gabriel",
      "t": "Qu'est-ce qu'on va lui dire?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'What are we going to say to him?'",
      "gap": 0.45
    },
    {
      "v": "andrea",
      "t": "Il nous aide, ou on arrête d'envoyer nos clients ici.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'He helps us, or we stop sending our clients here.'",
      "gap": 0.45
    },
    {
      "v": "gabriel",
      "t": "Comme d'habitude.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'As usual.'",
      "gap": 0.45
    },
    {
      "v": "andrea",
      "t": "Oh non! Regarde!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Oh no! Look!'",
