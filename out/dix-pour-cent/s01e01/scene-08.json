    {
      "v": "camille",
      "t": "Oui, exactement. Le Festival de Cannes.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Yes, exactly. The Cannes Film Festival.'",
      "gap": 0.45
    },
    {
      "v": "andrea",
      "t": "Pour faire quoi?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Doing what?'",
