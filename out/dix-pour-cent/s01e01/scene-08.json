      "t": "Vous venez d'où?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Where are you from?'",
      "gap": 0.45
    },
    {
      "v": "camille",
      "t": "Je viens de la Côte d'Azur. Près de Cannes.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I'm from the French Riviera. Near Cannes.'",
      "gap": 0.45
