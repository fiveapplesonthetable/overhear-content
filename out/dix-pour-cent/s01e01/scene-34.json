      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Can you come with me? I'm scared.'",
      "gap": 0.45
    },
    {
      "v": "gabriel",
      "t": "On verra.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'We'll see.'",
      "gap": 0.45
    },
    {
      "v": "cecile",
      "t": "Merci pour le trajet.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Thanks for the lift.'",
      "gap": 0.45
    },
    {
      "v": "cecile",
      "t": "Ne fais pas cette tête.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Don't make that face.'",
      "gap": 0.45
    },
    {
