    },
    {
      "v": "gabriel",
      "t": "Tu vas à la clinique quand?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'When are you going to the clinic?'",
      "gap": 0.45
    },
    {
      "v": "cecile",
      "t": "Demain. Pas de commentaire?",
      "gap": 0.55
    },
    {
