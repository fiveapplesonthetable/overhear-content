    {
      "v": "narrator",
      "t": "'I'm changing agents.'",
      "gap": 0.45
    },
    {
      "v": "cecile",
      "t": "Tu es un menteur!",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'You're a liar!'",
      "gap": 0.45
    },
    {
      "v": "cecile",
      "t": "C'est à cause de mon âge, non?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'It's because of my age, isn't it?'",
      "gap": 0.45
    },
    {
