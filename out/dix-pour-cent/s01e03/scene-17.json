    },
    {
      "v": "nathalie",
      "t": "Je ne suis pas surprise.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'I'm not surprised.'",
      "gap": 0.45
    },
    {
      "v": "nathalie",
      "t": "Tu as toujours aimé le vent.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'You've always loved the wind.'",
      "gap": 0.45
    },
    {
      "v": "solveig",
      "t": "Tu peux réessayer, sans tant de tragédie?",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Can you try again, without so much tragedy?'",
      "gap": 0.45
    },
    {
      "v": "solveig",
      "t": "Quelque chose de plus neutre.",
      "gap": 0.55
    },
    {
      "v": "narrator",
      "t": "'Something more neutral.'",
