#!/usr/bin/env python3
"""Run a command on the shared GPU with a VRAM reservation instead of an exclusive lock.

    gpurun <MiB> <cmd> [args...]

Each job declares how much VRAM it needs. The job starts as soon as two things fit:
the sum of live reservations stays within budget, and nvidia-smi reports enough free
memory. Small jobs (whisper, MMS alignment, pyannote, demucs) therefore share the GPU
with a TTS inference job. A job that reserves the whole budget (e.g. training at 7500)
runs alone.

Reservations are files in $OVERHEAR_HOME/gpu-slots/<pid>.json. A dead pid's slot is ignored.
Waiting jobs queue in $OVERHEAR_HOME/gpu-slots/queue/. A job may start only if it still fits
after counting every waiter ahead of it as already reserved, so a big job (training) is
not starved by a stream of small ones. Order is GPURUN_PRIO (higher first), then arrival.
The old exclusive lock $OVERHEAR_HOME/gpu.lock is still respected: while it is held,
nothing new starts, so old-style scripts keep working.
"""
import fcntl, json, os, subprocess, sys, time

_HOME = os.environ.get("OVERHEAR_HOME", os.path.expanduser("~/overhear"))
SLOTS = os.path.join(_HOME, "gpu-slots")
QUEUE = os.path.join(SLOTS, "queue")
LEDGER = os.path.join(_HOME, "gpu-slots.lock")
OLD_LOCK = "$OVERHEAR_HOME/gpu.lock"
BUDGET = int(os.environ.get("GPURUN_BUDGET_MIB", "38500"))  # A100 40 GB minus headroom
MARGIN = 600  # MiB kept free beyond the request, for allocator fragmentation; capped at BUDGET
# so a job reserving the whole budget can still start on an otherwise idle card


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def entries(d):
    for name in os.listdir(d):
        if name.endswith(".json"):
            yield os.path.join(d, name)


def reserved():
    total = 0
    for path in entries(SLOTS):
        try:
            with open(path) as f:
                slot = json.load(f)
        except (OSError, ValueError):
            continue
        if alive(slot["pid"]):
            total += slot["mib"]
        else:
            try:
                os.remove(path)
            except OSError:
                pass
    return total


def ahead_of(me):
    """MiB wanted by live waiters ordered before `me` (prio desc, then arrival)."""
    total = 0
    for path in entries(QUEUE):
        try:
            with open(path) as f:
                w = json.load(f)
        except (OSError, ValueError):
            continue
        if not alive(w["pid"]):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        if w["pid"] != me["pid"] and (-w["prio"], w["t"]) < (-me["prio"], me["t"]):
            total += w["mib"]
    return total


def free_mib():
    out = subprocess.run(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, check=True).stdout
    return int(out.split()[0])


def old_lock_held():
    with open(OLD_LOCK, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
        except BlockingIOError:
            return True


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    mib = min(int(sys.argv[1]), BUDGET)
    cmd = sys.argv[2:]
    os.makedirs(QUEUE, exist_ok=True)
    slot = os.path.join(SLOTS, f"{os.getpid()}.json")
    ticket = os.path.join(QUEUE, f"{os.getpid()}.json")
    me = {"pid": os.getpid(), "mib": mib, "t": time.time(),
          "prio": int(os.environ.get("GPURUN_PRIO", "0")), "cmd": " ".join(cmd)[:200]}
    with open(ticket, "w") as f:
        json.dump(me, f)
    waited = False
    while True:
        with open(LEDGER, "a") as ledger:
            fcntl.flock(ledger, fcntl.LOCK_EX)
            # Free memory already reflects running jobs, so only reservations not yet
            # allocated matter; requiring both checks is conservative and simple.
            if (not old_lock_held() and reserved() + ahead_of(me) + mib <= BUDGET
                    and free_mib() >= min(mib + MARGIN, BUDGET)):
                with open(slot, "w") as f:
                    json.dump({"pid": me["pid"], "mib": mib, "cmd": me["cmd"]}, f)
                os.remove(ticket)
                break
        if not waited:
            print(f"gpurun: waiting for {mib} MiB", file=sys.stderr)
            waited = True
        time.sleep(15)
    env = dict(os.environ, PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True")
    try:
        sys.exit(subprocess.call(cmd, env=env))
    finally:
        try:
            os.remove(slot)
        except OSError:
            pass


if __name__ == "__main__":
    main()
