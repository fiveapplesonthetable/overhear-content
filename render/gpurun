#!/usr/bin/env python3
"""Run a command on the shared GPU with live VRAM + unallocated-startup accounting.

    gpurun <MiB> <cmd> [args...]

Free memory from `nvidia-smi` already reflects models loaded on the GPU; slots in
$OVERHEAR_HOME/gpu-slots/<pid>.json track unallocated startup headroom for processes
still loading weights onto CUDA plus activation-spike cushions for active workers, so
40 GB A100 HBM stays packed without OOMing or stalling behind paper over-estimates.
"""
import fcntl, json, os, subprocess, sys, time

_HOME = os.environ.get("OVERHEAR_HOME", os.path.expanduser("~/overhear"))
SLOTS = os.path.join(_HOME, "gpu-slots")
QUEUE = os.path.join(SLOTS, "queue")
LEDGER = os.path.join(_HOME, "gpu-slots.lock")
OLD_LOCK = os.path.join(_HOME, "gpu.lock")
BUDGET = int(os.environ.get("GPURUN_BUDGET_MIB", "38800"))  # A100 40 GB minus ctranslate2/driver headroom
MARGIN = int(os.environ.get("GPURUN_MARGIN_MIB", "1500"))
POLL_SEC = float(os.environ.get("GPURUN_POLL_SEC", "1.0"))


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def entries(d):
    if not os.path.isdir(d):
        return
    for name in os.listdir(d):
        if name.endswith(".json"):
            yield os.path.join(d, name)


def proc_children_map():
    children = {}
    try:
        for name in os.listdir("/proc"):
            if not name.isdigit():
                continue
            try:
                with open(f"/proc/{name}/stat") as f:
                    parts = f.read().rsplit(")", 1)[1].split()
                ppid = int(parts[1])
                children.setdefault(ppid, []).append(int(name))
            except OSError:
                continue
    except OSError:
        pass
    return children


def tree_pids(root_pid, children):
    out, stack = [root_pid], [root_pid]
    while stack:
        p = stack.pop()
        for c in children.get(p, ()):
            out.append(c)
            stack.append(c)
    return out


def gpu_snapshot():
    """Return (free_mib, total_used_mib, {pid: used_mib})."""
    free_out = subprocess.run(
        ["nvidia-smi", "--query-gpu=memory.free,memory.used", "--format=csv,noheader,nounits"],
        capture_output=True, text=True, check=True,
    ).stdout.strip().split(",")
    free_m, used_m = int(free_out[0].strip()), int(free_out[1].strip())
    proc_out = subprocess.run(
        ["nvidia-smi", "--query-compute-apps=pid,used_memory", "--format=csv,noheader,nounits"],
        capture_output=True, text=True, check=True,
    ).stdout
    by_pid = {}
    for line in proc_out.splitlines():
        if "," not in line:
            continue
        p_s, m_s = line.split(",", 1)
        try:
            by_pid[int(p_s.strip())] = int(m_s.strip())
        except ValueError:
            continue
    return free_m, used_m, by_pid


def unallocated_pending(by_pid):
    """MiB not yet reflected in nvidia-smi free_mib (startup weight loads + KV-cache spike cushion)."""
    children = proc_children_map()
    now = time.time()
    pending = 0
    for path in entries(SLOTS):
        try:
            with open(path) as f:
                slot = json.load(f)
        except (OSError, ValueError):
            continue
        pid = slot["pid"]
        if not alive(pid):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        decl = int(slot["mib"])
        age = now - float(slot.get("t", now - 30.0))
        actual = sum(by_pid.get(p, 0) for p in tree_pids(pid, children))
        cmd_s = slot.get("cmd", "")
        if actual >= 1500:
            is_qwen = "venv-qwen" in cmd_s and decl >= 7000
            is_retake = "--attempt 1" in cmd_s or "--attempt 2" in cmd_s or "--attempt 3" in cmd_s or " stage.py retake " in cmd_s
            if is_qwen:
                peak = 10800 if is_retake else 15800
            elif "venv-asr" in cmd_s and decl >= 7000:
                peak = 6200
            else:
                peak = max(decl, 3200)
            pending += max(400, peak - actual)
        elif actual > 0:
            pending += max(2200, min(decl, 6000))
        elif age < 22.0:
            # Process just started and hasn't called model.to('cuda') yet.
            pending += min(decl, 10500)
        else:
            # Process is doing CPU prep (e.g. RUAccent) before touching GPU.
            pending += min(decl, 3000)
    return pending


def ahead_of(me):
    """Only yield to whole-card/training jobs (>=18 GiB) ordered ahead of `me`."""
    total = 0
    for path in entries(QUEUE):
        try:
            with open(path) as f:
                w = json.load(f)
        except (OSError, ValueError):
            continue
        if not alive(w["pid"]):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        if w["pid"] != me["pid"] and w["mib"] >= 18000 and (-w["prio"], w["t"]) < (-me["prio"], me["t"]):
            total += w["mib"]
    return total


def old_lock_held():
    with open(OLD_LOCK, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
        except BlockingIOError:
            return True


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    mib = min(int(sys.argv[1]), BUDGET)
    cmd = sys.argv[2:]
    os.makedirs(QUEUE, exist_ok=True)
    slot = os.path.join(SLOTS, f"{os.getpid()}.json")
    ticket = os.path.join(QUEUE, f"{os.getpid()}.json")
    me = {"pid": os.getpid(), "mib": mib, "t": time.time(),
          "prio": int(os.environ.get("GPURUN_PRIO", "0")), "cmd": " ".join(cmd)[:200]}
    with open(ticket, "w") as f:
        json.dump(me, f)
    waited = False
    while True:
        with open(LEDGER, "a") as ledger:
            fcntl.flock(ledger, fcntl.LOCK_EX)
            free_m, used_m, by_pid = gpu_snapshot()
            pend = unallocated_pending(by_pid)
            need = min(mib + MARGIN, BUDGET)
            if (not old_lock_held()
                    and used_m + pend + ahead_of(me) + min(mib, 13000) <= BUDGET
                    and free_m - pend >= min(need, 13000 + MARGIN)):
                with open(slot, "w") as f:
                    json.dump({"pid": me["pid"], "mib": mib, "t": time.time(), "cmd": me["cmd"]}, f)
                try:
                    os.remove(ticket)
                except OSError:
                    pass
                break
        if not waited:
            print(f"gpurun: waiting for {mib} MiB (free={free_m} pend={pend})", file=sys.stderr, flush=True)
            waited = True
        time.sleep(POLL_SEC)
    env = dict(os.environ, PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True")
    try:
        sys.exit(subprocess.call(cmd, env=env))
    finally:
        try:
            os.remove(slot)
        except OSError:
            pass


if __name__ == "__main__":
    main()
